import { useParams } from 'azerothjs';

import { client, type Transfer } from '../api.ts';
import { formatAmount, formatValue } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import HashLink from '../components/chain/hash-link.component.azeroth';
import FlowLedger from '../components/chain/flow-ledger.component.azeroth';
import ContractPanel from '../components/chain/contract-panel.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// The page this whole explorer exists for. The identity header answers "what is this", the three
// flow figures answer "what happened to the money", and the ledger below answers "when, and with
// whom". Token transfers are a second tab because they are a different asset - mixing them into
// one list would make neither total mean anything.

/**
 * How a transfer row reads FROM THIS PAGE - one source for the four things that say it.
 *
 * `asset` is a token contract looking at its own transfers: the address is what moved, not who
 * moved it, so the row gets no sign and no direction colour. A `+` there would claim the contract
 * received something it never held.
 */
const FACE = {
    in: { icon: 'inflow', badge: 'text-inflow', amount: 'text-inflow', sign: '+' },
    out: { icon: 'outflow', badge: 'text-outflow', amount: 'text-outflow', sign: '−' },
    asset: { icon: 'token', badge: 'text-nur', amount: '', sign: '' }
} as const;

export default component AddressPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;
    state tab: 'flow' | 'transfers' | 'contract' = 'flow';

    derived address = params()['address'] ?? '';

    // Every source below is gated on the address being PRESENT, and `?? ''` above is why it has
    // to be: navigating away clears the param, and an empty string is a perfectly good-looking
    // source value, so the resources re-ran and fetched `/api/address/` on the way out - two
    // guaranteed 404s and two red console errors per departure. `false` means "do not fetch",
    // the same guard block.page.azeroth puts on its own param.
    resource stats = () => client.stats.summary();
    resource account = (value: string) => client.address.summary({ params: { address: value } })
        with { source: address === '' ? false : address };
    resource txs = (key: string) =>
    {
        const [value = '', at = '1'] = key.split('|');
        return client.address.transactions({ params: { address: value }, query: { page: Number(at), limit: 25 } });
    } with { source: address === '' ? false : `${ address }|${ page }` };
    resource transfers = (key: string) =>
    {
        const [value = '', at = '1'] = key.split('|');
        return client.address.transfers({ params: { address: value }, query: { page: Number(at), limit: 25 } });
    } with { source: tab === 'transfers' && address !== '' ? `${ address }|${ page }` : false };

    /**
     * The tab actually being drawn. An EOA has no contract tab, and the selection has to survive
     * navigating from a contract to an ordinary address - otherwise the page renders no tab at
     * all and reads as broken.
     */
    derived active = tab === 'contract' && account.data()?.isContract !== true ? 'flow' : tab;

    // Fetched only when the tab is opened. Reading a contract costs the node a `getCode` and a
    // round of calls, and most visitors to an address never ask what its code is.
    resource contract = (value: string) => client.address.contract({ params: { address: value } })
        with { source: active === 'contract' && address !== '' ? address : false };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    const pick = (next: 'flow' | 'transfers' | 'contract'): void =>
    {
        tab = next;
        page = 1;
    };

    /**
     * Which way a transfer moved, as this page reads it. Three cases, not two: a token contract
     * appears in its own transfers as the TOKEN rather than as a counterparty, and every row on
     * its page is one of those.
     */
    const way = (row: Transfer): keyof typeof FACE =>
        row.to === address ? 'in' : row.from === address ? 'out' : 'asset';

    useTitle(() => locale.t('address.title', { short: address.slice(0, 10) }));

    <div class="flex flex-col gap-4 sm:gap-5">
        <header class="panel px-4 py-4 sm:px-5">
            <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                    <Show
                        when={ account.data()?.isContract === true }
                        fallback={ <Icon name="wallet" size={ 19 } /> }
                    >
                        <Icon name="contract" size={ 19 } />
                    </Show>
                </span>
                <div class="min-w-0 flex-1">
                    {/* `break-words` because a token name is whatever the contract says it is, and
                        the spam ones are a single unbroken word. This panel does not clip. */}
                    <p class="break-words text-[13px] uppercase tracking-[0.14em] text-muted">
                        <Show when={ account.data()?.token } fallback={ <span>{ account.data()?.isContract === true ? locale.t('address.kind.contract') : locale.t('address.kind.address') }</span> } let={ token }>
                            <span>{ locale.t('address.kind.token') } &middot; { token.name } ({ token.symbol })</span>
                        </Show>
                    </p>
                    {/* The identity line IS the address: printed once, whole, and copyable from
                        where it is read. A shortened second copy of it used to sit at the far end
                        of this row, which said the same thing twice. */}
                    <p class="mt-0.5"><HashLink value={ address } tone="text" class="text-[15px] font-semibold sm:text-[16px]" full copy /></p>
                </div>
            </div>
        </header>

        {/* Four across only once there is room for four balances. Between 640px and 1024px the
            old sm:grid-cols-4 left each card 108px of inner width for a figure that wants up to
            200px, so the number ran out of the card rather than the grid reflowing.

            Every figure inside wears `amount` on a SPAN. On the dd itself the utility's ltr also
            fixes where the line starts, and each card printed its label against one edge and its
            number against the other in a mirrored layout. */}
        <Show when={ account.data() !== undefined }>
        { () =>
            <div class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
                <div class="panel px-4 py-3">
                    <dt class="text-[13px] text-muted">{ locale.t('address.balance') }</dt>
                    <dd class="mt-0.5 text-[16px] font-bold sm:text-[17px]"><span class="amount">{ formatValue(account.data()!.balance, symbol, decimals) }</span></dd>
                </div>
                {/* The two numbers the page is FOR, in the two colours that mean them. */}
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[13px] text-muted">
                        <Icon name="inflow" size={ 13 } class="text-inflow" /> { locale.t('address.received') }
                    </dt>
                    <dd class="mt-0.5 text-[16px] font-bold text-inflow sm:text-[17px]"><span class="amount">{ formatAmount(account.data()!.flow.in, decimals) }</span></dd>
                </div>
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[13px] text-muted">
                        <Icon name="outflow" size={ 13 } class="text-outflow" /> { locale.t('address.sent') }
                    </dt>
                    <dd class="mt-0.5 text-[16px] font-bold text-outflow sm:text-[17px]"><span class="amount">{ formatAmount(account.data()!.flow.out, decimals) }</span></dd>
                </div>
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[13px] text-muted">
                        <Icon name="gas" size={ 13 } /> { locale.t('address.fees') }
                    </dt>
                    <dd class="mt-0.5 text-[16px] font-bold sm:text-[17px]"><span class="amount">{ formatAmount(account.data()!.flow.fees, decimals) }</span></dd>
                </div>
            </div>
        }
        </Show>

        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label={ locale.t('address.activity') }>
            <button
                class={ active === 'flow'
                    ? 'cursor-pointer rounded-lg border border-nur bg-raised px-3.5 py-1.5 text-[14px] font-semibold text-nur'
                    : 'cursor-pointer rounded-lg border border-line px-3.5 py-1.5 text-[14px] text-muted transition-colors duration-150 hover:text-text' }
                type="button"
                role="tab"
                aria-selected={ active === 'flow' }
                onClick={ () => pick('flow') }
            >
                { locale.t('address.tab.transactions') }
                <Show when={ account.data() !== undefined }>
                { () => <span class="ms-1.5 text-[13px] tabular-nums opacity-70">{ locale.n(account.data()!.txCount) }</span> }
                </Show>
            </button>
            <button
                class={ active === 'transfers'
                    ? 'cursor-pointer rounded-lg border border-nur bg-raised px-3.5 py-1.5 text-[14px] font-semibold text-nur'
                    : 'cursor-pointer rounded-lg border border-line px-3.5 py-1.5 text-[14px] text-muted transition-colors duration-150 hover:text-text' }
                type="button"
                role="tab"
                aria-selected={ active === 'transfers' }
                onClick={ () => pick('transfers') }
            >
                { locale.t('address.tab.transfers') }
                <Show when={ account.data() !== undefined }>
                { () => <span class="ms-1.5 text-[13px] tabular-nums opacity-70">{ locale.n(account.data()!.transferCount) }</span> }
                </Show>
            </button>
            {/* Only where there is code to show. On an ordinary account the tab would open onto an
                empty panel, which reads as a page that failed rather than as an account. */}
            <Show when={ account.data()?.isContract === true }>
                <button
                    class={ active === 'contract'
                        ? 'cursor-pointer rounded-lg border border-nur bg-raised px-3.5 py-1.5 text-[14px] font-semibold text-nur'
                        : 'cursor-pointer rounded-lg border border-line px-3.5 py-1.5 text-[14px] text-muted transition-colors duration-150 hover:text-text' }
                    type="button"
                    role="tab"
                    aria-selected={ active === 'contract' }
                    onClick={ () => pick('contract') }
                >
                    { locale.t('address.tab.contract') }
                </button>
            </Show>
        </div>

        {/* Both, or neither: the panel offers calls, and a call needs the chain id the wallet has
            to be on before one is sent. */}
        <Show when={ active === 'contract' && contract.data() !== undefined && stats.data() !== undefined }>
        { () => <ContractPanel detail={ contract.data()! } chain={ stats.data()!.chain } /> }
        </Show>

        <Show when={ active === 'flow' }>
            <div>
                <FlowLedger
                    address={ address }
                    rows={ txs.data()?.rows ?? [] }
                    symbol={ symbol }
                    decimals={ decimals }
                />
                {/* Guarded on the page COUNT, not on the data: Pagination draws nothing for a
                    single page, and an unguarded panel around nothing is an empty bordered strip
                    under the ledger. */}
                <Show when={ (txs.data()?.pages ?? 0) > 1 }>
                { () =>
                    <div class="panel mt-3">
                        <Pagination page={ txs.data()!.page } pages={ txs.data()!.pages } onChange={ (next) => page = next } />
                    </div>
                }
                </Show>
            </div>
        </Show>

        <Show when={ active === 'transfers' }>
            <section class="panel overflow-hidden">
                <ul class="divide-y divide-line">
                    <For each={ transfers.data()?.rows ?? [] } key={ (row) => `${ row.txHash }-${ row.logIndex }` } let={ row }>
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                            <span class={ `flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-raised ${ FACE[way(row)].badge }` }>
                                <Icon name={ FACE[way(row)].icon } size={ 15 } />
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-[14px] font-semibold">
                                    { row.tokenSymbol === '' ? locale.t('address.transfers.token') : row.tokenSymbol }
                                    <Show when={ row.tokenId !== null }>
                                        <span class="data ms-1.5 text-[13px] text-muted">#{ row.tokenId }</span>
                                    </Show>
                                </p>
                                {/* Only where the page cannot say "you". A row with no direction
                                    has to name both ends or it says nothing about who was paid -
                                    and the arrow flips with the reader's own direction. Copy is
                                    off on the pair: the row already carries one copy button, and
                                    three of them in a list turn the ledger into a toolbar. */}
                                <Show when={ way(row) === 'asset' }>
                                    <p class="text-[13px] text-muted">
                                        <HashLink value={ row.from } to={ `/address/${ row.from }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[13px]" />
                                        <span class="icon-flip mx-1.5 inline-block">&rarr;</span>
                                        <HashLink value={ row.to } to={ `/address/${ row.to }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[13px]" />
                                    </p>
                                </Show>
                                <Tooltip label={ locale.dateTime(row.at) } class="flex"><p class="text-[12px] text-muted">{ locale.ago(row.at) }</p></Tooltip>
                            </div>
                            <div class="min-w-0 max-w-[45%] text-end">
                                {/* `amount` on the span, so the paragraph inherits the reader's
                                    direction and resolves the cell's `text-end` to the same edge
                                    the hash below it lands on. The sign stays INSIDE the isolate:
                                    a bare +/- is bidi-neutral and would swap to the far side of
                                    its own digits in a mirrored line. */}
                                <p class={ `text-[14px] font-semibold ${ FACE[way(row)].amount }` }>
                                    <span class="amount">{ FACE[way(row)].sign }{ formatAmount(row.value, row.tokenDecimals) }</span>
                                </p>
                                <HashLink value={ row.txHash } to={ `/tx/${ row.txHash }` } tone="muted" lead={ 8 } tail={ 4 } />
                            </div>
                        </li>
                    </For>
                </ul>
                <Show when={ transfers.data()?.rows.length === 0 }>
                    <EmptyState icon="token" title={ locale.t('address.transfers.empty.title') } hint={ locale.t('address.transfers.empty.hint') } />
                </Show>
                <Show when={ transfers.data() !== undefined }>
                { () => <Pagination page={ transfers.data()!.page } pages={ transfers.data()!.pages } onChange={ (next) => page = next } /> }
                </Show>
            </section>
        </Show>
    </div>
}
