import { useParams } from 'azerothjs';

import { client } from '../api.ts';
import { formatAmount, formatValue } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import HashLink from '../components/chain/hash-link.component.azeroth';
import FlowLedger from '../components/chain/flow-ledger.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// The page this whole explorer exists for. The identity header answers "what is this", the three
// flow figures answer "what happened to the money", and the ledger below answers "when, and with
// whom". Token transfers are a second tab because they are a different asset - mixing them into
// one list would make neither total mean anything.
export default component AddressPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;
    state tab: 'flow' | 'transfers' = 'flow';

    derived address = params()['address'] ?? '';

    // Every source below is gated on the address being PRESENT, and `?? ''` above is why it has
    // to be: navigating away clears the param, and an empty string is a perfectly good-looking
    // source value, so the resources re-ran and fetched `/api/address/` on the way out - two
    // guaranteed 404s and two red console errors per departure. `false` means "do not fetch",
    // the same guard block.page.azeroth puts on its own param.
    resource stats = () => client.stats.summary();
    resource account = (value: string) => client.address.summary({ params: { address: value } })
        with { source: address === '' ? false : address };
    resource txs = (key: string) =>
    {
        const [value = '', at = '1'] = key.split('|');
        return client.address.transactions({ params: { address: value }, query: { page: Number(at), limit: 25 } });
    } with { source: address === '' ? false : `${ address }|${ page }` };
    resource transfers = (key: string) =>
    {
        const [value = '', at = '1'] = key.split('|');
        return client.address.transfers({ params: { address: value }, query: { page: Number(at), limit: 25 } });
    } with { source: tab === 'transfers' && address !== '' ? `${ address }|${ page }` : false };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    const pick = (next: 'flow' | 'transfers'): void =>
    {
        tab = next;
        page = 1;
    };

    useTitle(() => locale.t('address.title', { short: address.slice(0, 10) }));

    <div class="flex flex-col gap-4 sm:gap-5">
        <header class="panel px-4 py-4 sm:px-5">
            <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                    <Show
                        when={ account.data()?.isContract === true }
                        fallback={ <Icon name="wallet" size={ 19 } /> }
                    >
                        <Icon name="contract" size={ 19 } />
                    </Show>
                </span>
                <div class="min-w-0 flex-1">
                    {/* `break-words` because a token name is whatever the contract says it is, and
                        the spam ones are a single unbroken word. This panel does not clip. */}
                    <p class="break-words text-[12px] uppercase tracking-[0.14em] text-muted">
                        <Show when={ account.data()?.token } fallback={ <span>{ account.data()?.isContract === true ? locale.t('address.kind.contract') : locale.t('address.kind.address') }</span> } let={ token }>
                            <span>{ locale.t('address.kind.token') } &middot; { token.name } ({ token.symbol })</span>
                        </Show>
                    </p>
                    {/* The identity line IS the address: printed once, whole, and copyable from
                        where it is read. A shortened second copy of it used to sit at the far end
                        of this row, which said the same thing twice. */}
                    <p class="mt-0.5"><HashLink value={ address } tone="text" class="text-[14px] font-semibold sm:text-[15px]" full copy /></p>
                </div>
            </div>
        </header>

        {/* Four across only once there is room for four balances. Between 640px and 1024px the
            old sm:grid-cols-4 left each card 108px of inner width for a figure that wants up to
            200px, so the number ran out of the card rather than the grid reflowing.

            Every figure inside wears `amount` on a SPAN. On the dd itself the utility's ltr also
            fixes where the line starts, and each card printed its label against one edge and its
            number against the other in a mirrored layout. */}
        <Show when={ account.data() !== undefined }>
        { () =>
            <div class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
                <div class="panel px-4 py-3">
                    <dt class="text-[12px] text-muted">{ locale.t('address.balance') }</dt>
                    <dd class="mt-0.5 text-[15px] font-bold sm:text-[16px]"><span class="amount">{ formatValue(account.data()!.balance, symbol, decimals) }</span></dd>
                </div>
                {/* The two numbers the page is FOR, in the two colours that mean them. */}
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[12px] text-muted">
                        <Icon name="inflow" size={ 12 } class="text-inflow" /> { locale.t('address.received') }
                    </dt>
                    <dd class="mt-0.5 text-[15px] font-bold text-inflow sm:text-[16px]"><span class="amount">{ formatAmount(account.data()!.flow.in, decimals) }</span></dd>
                </div>
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[12px] text-muted">
                        <Icon name="outflow" size={ 12 } class="text-outflow" /> { locale.t('address.sent') }
                    </dt>
                    <dd class="mt-0.5 text-[15px] font-bold text-outflow sm:text-[16px]"><span class="amount">{ formatAmount(account.data()!.flow.out, decimals) }</span></dd>
                </div>
                <div class="panel px-4 py-3">
                    <dt class="flex items-center gap-1.5 text-[12px] text-muted">
                        <Icon name="gas" size={ 12 } /> { locale.t('address.fees') }
                    </dt>
                    <dd class="mt-0.5 text-[15px] font-bold sm:text-[16px]"><span class="amount">{ formatAmount(account.data()!.flow.fees, decimals) }</span></dd>
                </div>
            </div>
        }
        </Show>

        <div class="flex items-center gap-2" role="tablist" aria-label={ locale.t('address.activity') }>
            <button
                class={ tab === 'flow'
                    ? 'cursor-pointer rounded-lg border border-nur bg-raised px-3.5 py-1.5 text-[13px] font-semibold text-nur'
                    : 'cursor-pointer rounded-lg border border-line px-3.5 py-1.5 text-[13px] text-muted transition-colors duration-150 hover:text-text' }
                type="button"
                role="tab"
                aria-selected={ tab === 'flow' }
                onClick={ () => pick('flow') }
            >
                { locale.t('address.tab.transactions') }
                <Show when={ account.data() !== undefined }>
                { () => <span class="ms-1.5 text-[12px] tabular-nums opacity-70">{ locale.n(account.data()!.txCount) }</span> }
                </Show>
            </button>
            <button
                class={ tab === 'transfers'
                    ? 'cursor-pointer rounded-lg border border-nur bg-raised px-3.5 py-1.5 text-[13px] font-semibold text-nur'
                    : 'cursor-pointer rounded-lg border border-line px-3.5 py-1.5 text-[13px] text-muted transition-colors duration-150 hover:text-text' }
                type="button"
                role="tab"
                aria-selected={ tab === 'transfers' }
                onClick={ () => pick('transfers') }
            >
                { locale.t('address.tab.transfers') }
                <Show when={ account.data() !== undefined }>
                { () => <span class="ms-1.5 text-[12px] tabular-nums opacity-70">{ locale.n(account.data()!.transferCount) }</span> }
                </Show>
            </button>
        </div>

        <Show when={ tab === 'flow' }>
            <div>
                <FlowLedger
                    address={ address }
                    rows={ txs.data()?.rows ?? [] }
                    symbol={ symbol }
                    decimals={ decimals }
                />
                {/* Guarded on the page COUNT, not on the data: Pagination draws nothing for a
                    single page, and an unguarded panel around nothing is an empty bordered strip
                    under the ledger. */}
                <Show when={ (txs.data()?.pages ?? 0) > 1 }>
                { () =>
                    <div class="panel mt-3">
                        <Pagination page={ txs.data()!.page } pages={ txs.data()!.pages } onChange={ (next) => page = next } />
                    </div>
                }
                </Show>
            </div>
        </Show>

        <Show when={ tab === 'transfers' }>
            <section class="panel overflow-hidden">
                <ul class="divide-y divide-line">
                    <For each={ transfers.data()?.rows ?? [] } key={ (row) => `${ row.txHash }-${ row.logIndex }` } let={ row }>
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                            <span class={ row.to === address
                                ? 'flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-raised text-inflow'
                                : 'flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-raised text-outflow' }
                            >
                                <Icon name={ row.to === address ? 'inflow' : 'outflow' } size={ 14 } />
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-[13px] font-semibold">
                                    { row.tokenSymbol === '' ? locale.t('address.transfers.token') : row.tokenSymbol }
                                    <Show when={ row.tokenId !== null }>
                                        <span class="data ms-1.5 text-[12px] text-muted">#{ row.tokenId }</span>
                                    </Show>
                                </p>
                                <Tooltip label={ locale.dateTime(row.at) } class="flex"><p class="text-[11px] text-muted">{ locale.ago(row.at) }</p></Tooltip>
                            </div>
                            <div class="min-w-0 max-w-[45%] text-end">
                                {/* `amount` on the span, so the paragraph inherits the reader's
                                    direction and resolves the cell's `text-end` to the same edge
                                    the hash below it lands on. The sign stays INSIDE the isolate:
                                    a bare +/- is bidi-neutral and would swap to the far side of
                                    its own digits in a mirrored line. */}
                                <p class={ row.to === address
                                    ? 'text-[13px] font-semibold text-inflow'
                                    : 'text-[13px] font-semibold text-outflow' }
                                >
                                    <span class="amount">{ row.to === address ? '+' : '−' }{ formatAmount(row.value, row.tokenDecimals) }</span>
                                </p>
                                <HashLink value={ row.txHash } to={ `/tx/${ row.txHash }` } tone="muted" lead={ 8 } tail={ 4 } />
                            </div>
                        </li>
                    </For>
                </ul>
                <Show when={ transfers.data()?.rows.length === 0 }>
                    <EmptyState icon="token" title={ locale.t('address.transfers.empty.title') } hint={ locale.t('address.transfers.empty.hint') } />
                </Show>
                <Show when={ transfers.data() !== undefined }>
                { () => <Pagination page={ transfers.data()!.page } pages={ transfers.data()!.pages } onChange={ (next) => page = next } /> }
                </Show>
            </section>
        </Show>
    </div>
}
