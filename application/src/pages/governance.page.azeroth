import { Link } from 'azerothjs';

import { client, type Proposal, type ProposalFilter } from '../api.ts';
import { formatAmount } from '../lib/format.ts';
import { PROPOSAL_ICON, PROPOSAL_TONE, ratio } from '../lib/governance.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import HashLink from '../components/chain/hash-link.component.azeroth';
import NewProposal from '../components/chain/new-proposal.component.azeroth';
import VoteTally from '../components/chain/vote-tally.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import FilterGroup from '../components/ui/filter-group.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// Governance: what this chain is deciding about itself.
//
// The proposals are not in a contract somebody deployed - they are in the chain's own `x/gov`
// module, and this page reads them over the EVM through the gov precompile. Where that precompile
// is not among the chain's active ones the section says so rather than showing an empty list: the
// module is still governing, the EVM simply cannot see it, and those are different facts.
export default component GovernancePage()
{
    const locale = useLocale();

    state page = 1;
    state status: ProposalFilter = 'all';

    resource stats = () => client.stats.summary();
    resource overview = () => client.governance.overview();

    resource proposals = (key: string) =>
    {
        const [at = '1', narrowed = 'all'] = key.split('|');
        return client.governance.list({ query: { page: Number(at), limit: 25, status: narrowed as ProposalFilter } });
    } with { source: `${ page }|${ status }` };

    derived decimals = stats.data()?.chain.decimals ?? 18;
    derived symbol = stats.data()?.chain.symbol ?? '';
    derived params = overview.data()?.params ?? null;

    const narrow = (next: string): void =>
    {
        status = next as ProposalFilter;
        page = 1;
    };

    /** The date that decides where a proposal stands - which one that is depends on its state. */
    const deadline = (row: Proposal): string =>
    {
        if (row.status === 'deposit')
        {
            return locale.t('governance.deposit.ends', { date: locale.dateTime(row.depositEndTime) });
        }
        return locale.t(row.status === 'voting' ? 'governance.voting.ends' : 'governance.voting.ended',
            { date: locale.dateTime(row.votingEndTime) });
    };

    useTitle(() => locale.t('governance.title'));

    <div class="flex flex-col gap-4">
        <div>
            <h1 class="text-[22px] font-bold tracking-tight">{ locale.t('governance.title') }</h1>
            <p class="mt-1 max-w-2xl text-[14px] leading-relaxed text-muted">{ locale.t('governance.hint') }</p>
        </div>

        <Show when={ overview.data()?.enabled === false }>
        { () =>
            <section class="panel overflow-hidden">
                <EmptyState icon="vote" title={ locale.t('governance.empty.chain.title') } hint={ locale.t('governance.empty.chain.hint') } />
                <p class="hash border-t border-line px-4 py-3 text-center text-[12px] text-faint">
                    { overview.data()!.precompile }
                </p>
            </section>
        }
        </Show>

        <Show when={ overview.data()?.enabled === true }>
        { () =>
            <div class="flex flex-col gap-4">
                {/* What passing takes on this chain, as the module itself states it. */}
                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.module') }
                    </h2>
                    <dl class="flex flex-col gap-2.5 px-4 py-3 sm:flex-row sm:flex-wrap sm:gap-x-10">
                        <div class="flex items-baseline justify-between gap-3 sm:block">
                            <dt class="text-[12px] text-muted">{ locale.t('governance.quorum') }</dt>
                            <dd class="text-[14px] font-semibold tabular-nums">
                                { locale.t('governance.share', { percent: locale.n(ratio(params?.quorum ?? '0'), 1) }) }
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3 sm:block">
                            <dt class="text-[12px] text-muted">{ locale.t('governance.threshold') }</dt>
                            <dd class="text-[14px] font-semibold tabular-nums">
                                { locale.t('governance.share', { percent: locale.n(ratio(params?.threshold ?? '0'), 1) }) }
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3 sm:block">
                            <dt class="text-[12px] text-muted">{ locale.t('governance.veto') }</dt>
                            <dd class="text-[14px] font-semibold tabular-nums">
                                { locale.t('governance.share', { percent: locale.n(ratio(params?.vetoThreshold ?? '0'), 1) }) }
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3 sm:block">
                            <dt class="text-[12px] text-muted">{ locale.t('governance.minDeposit') }</dt>
                            <dd class="text-[14px] font-semibold">
                                <span class="amount">{ formatAmount(params?.minDeposit[0]?.amount ?? '0', decimals) }</span> { symbol }
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3 sm:block">
                            <dt class="text-[12px] text-muted">{ locale.t('governance.votingPeriod') }</dt>
                            <dd class="text-[14px] font-semibold tabular-nums">
                                { locale.t('governance.days', { count: locale.n((params?.votingPeriod ?? 0) / 86_400, 1) }) }
                            </dd>
                        </div>
                    </dl>
                </section>

                <div class="flex flex-wrap items-center justify-between gap-3">
                    <FilterGroup
                        label={ locale.t('governance.filter') }
                        name="proposal-status"
                        value={ status }
                        options={ [
                            { value: 'all', label: locale.t('filter.all') },
                            { value: 'open', label: locale.t('governance.filter.open') },
                            { value: 'passed', label: locale.t('governance.filter.passed') },
                            { value: 'failed', label: locale.t('governance.filter.failed') }
                        ] }
                        onChange={ narrow }
                    />

                    {/* Making one is offered from here, where the reader can see what it will cost
                        and what it has to clear. */}
                    <Show when={ stats.data() !== undefined && params !== null }>
                    { () =>
                        <NewProposal
                            precompile={ overview.data()!.precompile }
                            calls={ overview.data()!.calls }
                            params={ params! }
                            chain={ stats.data()!.chain }
                            onSent={ () => { overview.refetch(); proposals.refetch(); } }
                        />
                    }
                    </Show>
                </div>

                <section class="panel overflow-hidden">
                    <ul class="flex flex-col gap-2.5 p-3 sm:gap-0 sm:p-0">
                        <For each={ proposals.data()?.rows ?? [] } key={ (row) => row.id } let={ row }>
                            <li class="flex flex-col gap-2 rounded-lg border border-line bg-raised px-3 py-2.5 sm:rounded-none sm:border-x-0 sm:border-b-0 sm:bg-transparent sm:first:border-t-0 sm:px-4 sm:py-3">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                                    <Badge tone={ PROPOSAL_TONE[row.status] } icon={ PROPOSAL_ICON[row.status] }>
                                        { locale.t(`governance.state.${ row.status }`) }
                                    </Badge>
                                    <span class="data text-[13px] text-muted">#{ row.id }</span>
                                    <Link
                                        to={ `/governance/${ row.id }` }
                                        class="min-w-0 flex-1 text-[15px] font-semibold text-text no-underline hover:text-nur"
                                    >
                                        {/* `dir="auto"`: a title is whatever the proposer wrote, in
                                            whatever script they wrote it, and inheriting the page's
                                            direction puts its punctuation at the wrong end. */}
                                        <span dir="auto">{ row.title === '' ? locale.t('governance.untitled') : row.title }</span>
                                    </Link>
                                </div>

                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-muted">
                                    <span class="flex items-center gap-1.5">
                                        { locale.t('governance.proposedBy') }
                                        <HashLink value={ row.proposer } to={ `/address/${ row.proposer }` } tone="muted" lead={ 6 } tail={ 4 } copy={ false } class="text-[12px]" />
                                    </span>
                                    <Tooltip label={ locale.dateTime(row.submitTime) }><span>{ locale.ago(row.submitTime) }</span></Tooltip>
                                </div>

                                <VoteTally tally={ row.tally } decimals={ decimals } symbol={ symbol } compact />
                                <p class="text-[12px] text-faint">{ deadline(row) }</p>
                            </li>
                        </For>
                    </ul>

                    <Show when={ proposals.data() === undefined }>
                        <div class="flex flex-col gap-2 px-4 py-4">
                            <Skeleton class="h-16 w-full" />
                            <Skeleton class="h-16 w-full" />
                        </div>
                    </Show>

                    <Show when={ proposals.data()?.rows.length === 0 }>
                        <Show
                            when={ status === 'all' }
                            fallback={ <EmptyState icon="filter" title={ locale.t('governance.empty.filtered.title') } hint={ locale.t('governance.empty.filtered.hint') } /> }
                        >
                            <EmptyState icon="vote" title={ locale.t('governance.empty.title') } hint={ locale.t('governance.empty.hint') } />
                        </Show>
                    </Show>

                    <Show when={ proposals.data() !== undefined }>
                    { () => <Pagination page={ proposals.data()!.page } pages={ proposals.data()!.pages } onChange={ (next) => page = next } /> }
                    </Show>
                </section>

                <Show when={ proposals.data() !== undefined }>
                { () => <p class="text-[13px] text-muted">{ locale.t('governance.total', { count: locale.n(proposals.data()!.total) }) }</p> }
                </Show>
            </div>
        }
        </Show>
    </div>
}
