import { Link } from 'azerothjs';

import { client, type BlockFilter } from '../api.ts';
import { gasShare } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import FilterGroup from '../components/ui/filter-group.component.azeroth';
import HashLink from '../components/chain/hash-link.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';

export default component BlocksPage()
{
    const locale = useLocale();

    state page = 1;
    state content: BlockFilter = 'all';

    // One key for both, because they are one question - page 4 of the blocks that carried
    // something is a different list from page 4 of every block.
    resource blocks = (key: string) =>
    {
        const [at = '1', narrowed = 'all'] = key.split('|');
        return client.blocks.list({ query: { page: Number(at), limit: 25, content: narrowed as BlockFilter } });
    } with { source: `${ page }|${ content }` };

    // Back to the first page: on a quiet chain the filled blocks are a small fraction of the
    // list, so page 40 of everything is usually past the end of them.
    const narrow = (next: string): void =>
    {
        content = next as BlockFilter;
        page = 1;
    };

    useTitle(() => locale.t('blocks.title'));

    <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-[22px] font-bold tracking-tight">{ locale.t('blocks.title') }</h1>
            <FilterGroup
                label={ locale.t('filter.content') }
                name="block-content"
                value={ content }
                options={ [
                    { value: 'all', label: locale.t('filter.all') },
                    { value: 'filled', label: locale.t('filter.content.filled') }
                ] }
                onChange={ narrow }
            />
        </div>

        <section class="panel overflow-hidden">
            <ul class="divide-y divide-line">
                <For each={ blocks.data()?.rows ?? [] } key={ (block) => String(block.number) } let={ block }>
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-3 sm:gap-x-4 sm:px-4">
                        <Link to={ `/block/${ block.number }` } class="data w-24 shrink-0 text-[15px] font-semibold text-nur no-underline hover:underline">
                            #{ block.number }
                        </Link>
                        <div class="min-w-0 flex-1">
                            <HashLink value={ block.hash } to={ `/block/${ block.number }` } tone="muted" lead={ 14 } tail={ 8 } />
                            <Tooltip label={ locale.dateTime(block.at) } class="flex"><p class="text-[12px] text-muted">{ locale.ago(block.at) }</p></Tooltip>
                        </div>
                        <div class="text-end">
                            <p class="data text-[14px]">{ locale.t('chain.txCount', { count: locale.n(block.txCount) }) }</p>
                            <Tooltip label={ locale.t('blocks.gasTooltip', { used: locale.n(Number(block.gasUsed)), limit: locale.n(Number(block.gasLimit)) }) } class="flex justify-end"><p class="text-[12px] text-muted">{ locale.t('chain.gasShare', { percent: (gasShare(block.gasUsed, block.gasLimit) * 100).toFixed(1) }) }</p></Tooltip>
                        </div>
                    </li>
                </For>
            </ul>
            <Show when={ blocks.data() === undefined }>
                <div class="flex flex-col gap-2 px-4 py-4"><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /></div>
            </Show>
            {/* Two empty states: "nothing indexed yet" under an active filter tells a reader
                the chain has not started when what is empty is their own narrowing of it. */}
            <Show when={ blocks.data()?.rows.length === 0 }>
                <Show
                    when={ content === 'all' }
                    fallback={ <EmptyState icon="filter" title={ locale.t('blocks.empty.filtered.title') } hint={ locale.t('blocks.empty.filtered.hint') } /> }
                >
                    <EmptyState icon="block" title={ locale.t('blocks.empty.title') } hint={ locale.t('blocks.empty.hint') } />
                </Show>
            </Show>
            <Show when={ blocks.data() !== undefined }>
            { () => <Pagination page={ blocks.data()!.page } pages={ blocks.data()!.pages } onChange={ (next) => page = next } /> }
            </Show>
        </section>

        {/* The count follows the filter: with one on, `total` is what MATCHED, and calling that
            "indexed" misreports the size of the index every time somebody narrows it. */}
        <Show when={ blocks.data() !== undefined }>
        { () => <p class="text-[13px] text-muted">{ locale.t(content === 'all' ? 'blocks.total' : 'blocks.total.filtered', { count: locale.n(blocks.data()!.total) }) }</p> }
        </Show>
    </div>
}
