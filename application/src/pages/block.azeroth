import { Link, useParams } from 'azerothjs';

import { client } from '../api.ts';
import { formatBytes, formatCount, formatDateTime, formatGwei, formatValue, gasShare, shortHash, timeAgo } from '../lib/format.ts';
import Icon from '../icons/icon.component.azeroth';
import HashLink from '../components/chain/hash-link.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import { useTitle } from '../lib/title.ts';
import Pagination from '../components/ui/pagination.component.azeroth';

const formatBaseFee = (value: string | null): string => (value === null ? 'n/a' : formatGwei(value));

export default component BlockPage()
{
    const params = useParams();

    state page = 1;

    resource stats = () => client.stats.summary();
    resource detail = (key: string) =>
    {
        const [number = '', at = '1'] = key.split('|');
        return client.blocks.one({ params: { number }, query: { page: Number(at), limit: 25 } });
    } with { source: params()['number'] !== undefined ? `${ params()['number'] }|${ page }` : false };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    useTitle(() => `Block #${ params()['number'] ?? '' }`);

    <div class="flex flex-col gap-5">
        <Show when={ detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">Block not in the index</h1>
                <p class="mt-2 text-[14px] text-muted">It may be newer than the indexer has reached, or beyond the start block.</p>
            </div>
        </Show>

        <Show when={ detail.data() !== undefined }>
        { () =>
            <>
                <header class="flex flex-wrap items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="block" size={ 19 } />
                    </span>
                    <div class="flex-1">
                        <h1 class="data text-[22px] font-bold tracking-tight">Block #{ detail.data()!.block.number }</h1>
                        <p class="text-[12px] text-muted">{ formatDateTime(detail.data()!.block.at) } &middot; { timeAgo(detail.data()!.block.at) }</p>
                    </div>
                    <nav class="flex items-center gap-1.5">
                        <Show when={ detail.data()!.block.number > 0 }>
                            <Link to={ `/block/${ detail.data()!.block.number - 1 }` } class="flex h-8 w-8 items-center justify-center rounded-md border border-line text-muted no-underline hover:border-nur hover:text-nur" aria-label="Previous block">
                                <Icon name="chevron-left" size={ 15 } />
                            </Link>
                        </Show>
                        <Link to={ `/block/${ detail.data()!.block.number + 1 }` } class="flex h-8 w-8 items-center justify-center rounded-md border border-line text-muted no-underline hover:border-nur hover:text-nur" aria-label="Next block">
                            <Icon name="chevron-right" size={ 15 } />
                        </Link>
                    </nav>
                </header>

                <dl class="panel grid grid-cols-1 divide-y divide-line sm:grid-cols-2 sm:divide-y-0">
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Hash</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.hash } tone="text" lead={ 16 } tail={ 10 } copy /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Parent</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.parentHash } to={ `/block/${ detail.data()!.block.number - 1 }` } lead={ 16 } tail={ 10 } /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Validator</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.miner } to={ `/address/${ detail.data()!.block.miner }` } lead={ 12 } tail={ 8 } /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Size</dt>
                        <dd class="data flex-1 text-[13px]">{ formatBytes(detail.data()!.block.size) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Gas used</dt>
                        <dd class="flex-1">
                            <span class="data text-[13px]">{ formatCount(Number(detail.data()!.block.gasUsed)) }</span>
                            <span class="ms-2 text-[12px] text-muted">of { formatCount(Number(detail.data()!.block.gasLimit)) }</span>
                            <span class="mt-1.5 block h-1.5 w-full max-w-[200px] overflow-hidden rounded-full bg-raised">
                                <span class="block h-full rounded-full bg-nur" style={ `width: ${ (gasShare(detail.data()!.block.gasUsed, detail.data()!.block.gasLimit) * 100).toFixed(2) }%` }></span>
                            </span>
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[12px] text-muted">Base fee</dt>
                        <dd class="data flex-1 text-[13px]">{ formatBaseFee(detail.data()!.block.baseFee) }</dd>
                    </div>
                </dl>

                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { formatCount(detail.data()!.total) } transactions
                    </h2>
                    <ul class="divide-y divide-line">
                        <For each={ detail.data()!.transactions } key={ (row) => row.hash }>
                        { (row) =>
                            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
                                <Icon name={ row.status === 'reverted' ? 'alert' : 'success' } size={ 14 } class={ row.status === 'reverted' ? 'text-outflow' : 'text-inflow' } />
                                <div class="min-w-0 flex-1">
                                    <HashLink value={ row.hash } to={ `/tx/${ row.hash }` } lead={ 14 } tail={ 8 } />
                                    <p class="text-[11px] text-muted">
                                        { shortHash(row.from, 8, 6) } &rarr; { row.to === null ? 'contract creation' : shortHash(row.to, 8, 6) }
                                    </p>
                                </div>
                                <p class="data text-[13px]">{ formatValue(row.value, symbol, decimals) }</p>
                            </li>
                        }
                        </For>
                    </ul>
                    <Show when={ detail.data()!.total === 0 }>
                        <EmptyState icon="block" title="This block is empty" hint="No transactions were included in it." />
                    </Show>
                    <Show when={ detail.data()!.pages > 1 }>
                        <div class="border-t border-line">
                            <Pagination page={ detail.data()!.page } pages={ detail.data()!.pages } onChange={ (next) => page = next } />
                        </div>
                    </Show>
                </section>
            </>
        }
        </Show>
    </div>
}
