import { Link, useParams } from 'azerothjs';

import { client } from '../api.ts';
import { formatGwei, formatValue, gasShare } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import HashLink from '../components/chain/hash-link.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';

export default component BlockPage()
{
    const params = useParams();
    const locale = useLocale();

    const formatBaseFee = (value: string | null): string => (value === null ? locale.t('chain.notAvailable') : formatGwei(value));

    state page = 1;

    resource stats = () => client.stats.summary();
    resource detail = (key: string) =>
    {
        const [number = '', at = '1'] = key.split('|');
        return client.blocks.one({ params: { number }, query: { page: Number(at), limit: 25 } });
    } with { source: params()['number'] !== undefined ? `${ params()['number'] }|${ page }` : false };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    useTitle(() => locale.t('block.title', { number: params()['number'] ?? '' }));

    <div class="flex flex-col gap-5">
        <Show when={ detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">{ locale.t('block.missing.title') }</h1>
                <p class="mt-2 text-[15px] text-muted">{ locale.t('block.missing.hint') }</p>
            </div>
        </Show>

        <Show when={ detail.data() !== undefined }>
        { () =>
            <>
                <header class="flex flex-wrap items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="block" size={ 19 } />
                    </span>
                    <div class="flex-1">
                        <h1 class="data text-[22px] font-bold tracking-tight">{ locale.t('block.title', { number: detail.data()!.block.number }) }</h1>
                        <p class="text-[13px] text-muted">{ locale.dateTime(detail.data()!.block.at) } &middot; { locale.ago(detail.data()!.block.at) }</p>
                    </div>
                    <nav class="flex items-center gap-1.5">
                        <Show when={ detail.data()!.block.number > 0 }>
                            <Link to={ `/block/${ detail.data()!.block.number - 1 }` } class="flex h-8 w-8 items-center justify-center rounded-md border border-line text-muted no-underline hover:border-nur hover:text-nur" aria-label={ locale.t('block.previous') }>
                                <Icon name="chevron-left" size={ 16 } class="icon-flip" />
                            </Link>
                        </Show>
                        <Link to={ `/block/${ detail.data()!.block.number + 1 }` } class="flex h-8 w-8 items-center justify-center rounded-md border border-line text-muted no-underline hover:border-nur hover:text-nur" aria-label={ locale.t('block.next') }>
                            <Icon name="chevron-right" size={ 16 } class="icon-flip" />
                        </Link>
                    </nav>
                </header>

                <dl class="panel grid grid-cols-1 divide-y divide-line sm:grid-cols-2 sm:divide-y-0">
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.hash') }</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.hash } tone="text" lead={ 16 } tail={ 10 } copy /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.parent') }</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.parentHash } to={ `/block/${ detail.data()!.block.number - 1 }` } lead={ 16 } tail={ 10 } /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.validator') }</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.block.miner } to={ `/address/${ detail.data()!.block.miner }` } lead={ 12 } tail={ 8 } /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.size') }</dt>
                        <dd class="flex-1 text-[14px]">{ locale.bytes(detail.data()!.block.size) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.gasUsed') }</dt>
                        <dd class="flex-1">
                            <span class="data text-[14px]">{ locale.n(Number(detail.data()!.block.gasUsed)) }</span>
                            <span class="ms-2 text-[13px] text-muted">{ locale.t('block.gasOf', { limit: locale.n(Number(detail.data()!.block.gasLimit)) }) }</span>
                            <span class="mt-1.5 block h-1.5 w-full max-w-[200px] overflow-hidden rounded-full bg-raised">
                                <span class="block h-full rounded-full bg-nur" style={ `width: ${ (gasShare(detail.data()!.block.gasUsed, detail.data()!.block.gasLimit) * 100).toFixed(2) }%` }></span>
                            </span>
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-24 shrink-0 text-[13px] text-muted">{ locale.t('block.baseFee') }</dt>
                        {/* `data` on the VALUE, not on the row - the utility forces ltr, and on the
                            dd itself that also drags the line to the left edge of a mirrored layout
                            while every other row here starts at the right. Same shape as gas used.
                            The unavailable reading is a WORD, in the reader's language, so it stays
                            out of the monospace ltr span. */}
                        <dd class="flex-1 text-[14px]">
                            <span class={ detail.data()!.block.baseFee === null ? '' : 'data' }>{ formatBaseFee(detail.data()!.block.baseFee) }</span>
                        </dd>
                    </div>
                </dl>

                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('block.transactions', { count: locale.n(detail.data()!.total) }) }
                    </h2>
                    <ul class="divide-y divide-line">
                        <For each={ detail.data()!.transactions } key={ (row) => row.hash } let={ row }>
                            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
                                {/* The Badge the transactions list already uses, not a bare icon.
                                    Icon is aria-hidden, so the outcome of every transaction in a
                                    block was said in colour and shape alone - and not at all to a
                                    screen reader. */}
                                <Badge
                                    tone={ row.status === 'reverted' ? 'danger' : row.status === 'unknown' ? 'neutral' : 'success' }
                                    icon={ row.status === 'reverted' ? 'alert' : 'success' }
                                >
                                    { locale.t(`chain.status.${ row.status }`) }
                                </Badge>
                                <div class="min-w-0 flex-1">
                                    <HashLink value={ row.hash } to={ `/tx/${ row.hash }` } lead={ 14 } tail={ 8 } />
                                    {/* The pair as the address ledger draws it: a HashLink each,
                                        so the whole value is one hover away and the counterparty
                                        one click. Copy is off on both - the row already carries
                                        one copy button, and three turn a list into a toolbar. */}
                                    <p class="text-[12px] text-muted">
                                        <HashLink value={ row.from } to={ `/address/${ row.from }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[12px]" />
                                        <span class="icon-flip mx-1.5 inline-block">&rarr;</span>
                                        <Show when={ row.to } fallback={ <span>{ locale.t('chain.contractCreation') }</span> } let={ to }>
                                            <HashLink value={ to } to={ `/address/${ to }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[12px]" />
                                        </Show>
                                    </p>
                                </div>
                                <p class="amount max-w-[45%] shrink-0 text-end text-[14px]">{ formatValue(row.value, symbol, decimals) }</p>
                            </li>
                        </For>
                    </ul>
                    <Show when={ detail.data()!.total === 0 }>
                        <EmptyState icon="block" title={ locale.t('block.empty.title') } hint={ locale.t('block.empty.hint') } />
                    </Show>
                    <Show when={ detail.data()!.pages > 1 }>
                        <div class="border-t border-line">
                            <Pagination page={ detail.data()!.page } pages={ detail.data()!.pages } onChange={ (next) => page = next } />
                        </div>
                    </Show>
                </section>
            </>
        }
        </Show>
    </div>
}
