import { useParams } from 'azerothjs';

import { client, type ProposalDetail, type Vote } from '../api.ts';
import { formatAmount } from '../lib/format.ts';
import { isActionable, PROPOSAL_ICON, PROPOSAL_TONE, ratio } from '../lib/governance.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import HashLink from '../components/chain/hash-link.component.azeroth';
import ProposalActions from '../components/chain/proposal-actions.component.azeroth';
import VoteTally from '../components/chain/vote-tally.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// One proposal: what it says, what it would do to the chain, how the vote is going, and - for a
// reader with a wallet - the controls to take part in it.
//
// The tally here is the module's RUNNING count, not the proposal's own final one: while a vote is
// open `x/gov` leaves the second at zero, and a page that printed it would report a live vote as
// one nobody had touched. See the detail route on the server.

/** The dot beside a ballot, in the same four colours the tally above it draws. */
const OPTION_DOT: Record<string, string> = {
    yes: 'bg-nur',
    abstain: 'bg-faint',
    no: 'bg-muted',
    noWithVeto: 'bg-line',
    unspecified: 'bg-line'
};

/**
 * A proposal-shaped nothing.
 *
 * The panels below hand their values to components that read them LAZILY, and leaving this route
 * clears the resource before those children are torn down - written as `detail.data()!.proposal`,
 * that last read lands on nothing and takes the page into the error boundary on its way OUT.
 * Nothing is ever drawn from this: `<Show>` is still what decides.
 */
const NO_DETAIL: ProposalDetail = {
    proposal: {
        id: '', title: '', summary: '', status: 'unspecified', proposer: '', proposerHex: null,
        messages: [], metadata: '',
        submitTime: '1970-01-01T00:00:00.000Z', depositEndTime: '1970-01-01T00:00:00.000Z',
        votingStartTime: '1970-01-01T00:00:00.000Z', votingEndTime: '1970-01-01T00:00:00.000Z',
        totalDeposit: [], tally: { yes: '0', abstain: '0', no: '0', noWithVeto: '0' }
    },
    params: { quorum: '0', threshold: '0', vetoThreshold: '0', votingPeriod: 0, maxDepositPeriod: 0, minDeposit: [] },
    bondedTokens: null,
    writable: false,
    precompile: '',
    calls: { vote: '', voteWeighted: '', submitProposal: '', deposit: '', cancelProposal: '' },
    deposits: [], votes: [], total: 0, page: 1, pages: 1
};

export default component ProposalPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;

    resource stats = () => client.stats.summary();
    resource detail = (key: string) =>
    {
        const [id = '', at = '1'] = key.split('|');
        return client.governance.one({ params: { id }, query: { page: Number(at), limit: 25 } });
    } with { source: params()['id'] !== undefined ? `${ params()['id'] }|${ page }` : false };

    derived shown = detail.data() ?? NO_DETAIL;
    derived proposal = shown.proposal;
    derived decimals = stats.data()?.chain.decimals ?? 18;
    derived symbol = stats.data()?.chain.symbol ?? '';

    /** A vote's weight is a share of the voter's own power, in the module's eighteen-place fixed point. */
    const weightOf = (row: Vote): string =>
        locale.t('governance.share', { percent: locale.n(ratio(row.weight), 1) });

    useTitle(() => locale.t('governance.proposal.title'));

    <div class="flex flex-col gap-5">
        <Show when={ detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">{ locale.t('governance.proposal.missing.title') }</h1>
                <p class="mt-2 text-[15px] text-muted">{ locale.t('governance.proposal.missing.hint') }</p>
            </div>
        </Show>

        <Show when={ detail.data() === undefined && detail.error() === undefined }>
            <div class="flex flex-col gap-3">
                <Skeleton class="h-24 w-full" />
                <Skeleton class="h-40 w-full" />
            </div>
        </Show>

        <Show when={ detail.data() !== undefined }>
        { () =>
            <div class="flex flex-col gap-5">
                <header class="panel flex flex-col gap-3 px-4 py-4 sm:px-5">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <Badge tone={ PROPOSAL_TONE[proposal.status] } icon={ PROPOSAL_ICON[proposal.status] }>
                            { locale.t(`governance.state.${ proposal.status }`) }
                        </Badge>
                        <span class="data text-[13px] text-muted">#{ proposal.id }</span>
                    </div>

                    {/* `dir="auto"` on everything the PROPOSER wrote - the title here and the
                        summary below. It is text in a script this page cannot know, and left to
                        inherit the page's direction its punctuation lands at the wrong end. */}
                    <h1 class="break-words text-[20px] font-bold leading-snug tracking-tight sm:text-[22px]" dir="auto">
                        { proposal.title === '' ? locale.t('governance.untitled') : proposal.title }
                    </h1>

                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-muted">
                        { locale.t('governance.proposedBy') }
                        {/* The chain's own spelling of the account, linked to the twenty bytes
                            the EVM knows it by. */}
                        <HashLink
                            value={ proposal.proposer }
                            to={ proposal.proposerHex === null ? undefined : `/address/${ proposal.proposerHex }` }
                            tone="muted"
                            lead={ 10 }
                            tail={ 6 }
                            copy={ false }
                            class="text-[13px]"
                        />
                        <Tooltip label={ locale.dateTime(proposal.submitTime) }><span>{ locale.ago(proposal.submitTime) }</span></Tooltip>
                    </p>
                </header>

                <section class="panel flex flex-col gap-4 px-4 py-4">
                    <h2 class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">{ locale.t('governance.tally') }</h2>
                    <VoteTally
                        tally={ proposal.tally }
                        decimals={ decimals }
                        symbol={ symbol }
                        params={ shown.params }
                        bondedTokens={ shown.bondedTokens }
                    />
                </section>

                {/* The write half: only where the proposal's own state can take one, and only
                    where the chain lets a wallet send it at all. */}
                <Show when={ !shown.writable && isActionable(proposal.status) }>
                    <p class="panel px-4 py-3 text-[13px] text-muted">{ locale.t('governance.readonly') }</p>
                </Show>
                <Show when={ shown.writable && isActionable(proposal.status) && stats.data() !== undefined }>
                { () =>
                    <ProposalActions
                        detail={ shown }
                        chain={ stats.data()!.chain }
                        onSent={ () => detail.refetch() }
                    />
                }
                </Show>

                <Show when={ proposal.summary !== '' }>
                    <section class="panel px-4 py-4">
                        <h2 class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">{ locale.t('governance.summary') }</h2>
                        <p class="mt-3 whitespace-pre-wrap break-words text-[14px] leading-relaxed" dir="auto">{ proposal.summary }</p>
                    </section>
                </Show>

                <dl class="panel divide-y divide-line">
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.submitTime') }</dt>
                        <dd class="flex-1 text-[14px]">{ locale.dateTime(proposal.submitTime) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.depositEnd') }</dt>
                        <dd class="flex-1 text-[14px]">{ locale.dateTime(proposal.depositEndTime) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.votingStart') }</dt>
                        <dd class="flex-1 text-[14px]">{ locale.dateTime(proposal.votingStartTime) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.votingEnd') }</dt>
                        <dd class="flex-1 text-[14px]">{ locale.dateTime(proposal.votingEndTime) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.totalDeposit') }</dt>
                        <dd class="flex-1 text-[14px]">
                            <Show when={ proposal.totalDeposit.length > 0 } fallback={ <span class="text-muted">{ locale.t('chain.notAvailable') }</span> }>
                                <span class="amount">{ formatAmount(proposal.totalDeposit[0]?.amount ?? '0', decimals) }</span> { symbol }
                            </Show>
                        </dd>
                    </div>
                    <Show when={ proposal.metadata !== '' }>
                        <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                            <dt class="w-32 shrink-0 text-[13px] text-muted">{ locale.t('governance.metadata') }</dt>
                            <dd class="hash min-w-0 flex-1 text-[13px] text-muted">{ proposal.metadata }</dd>
                        </div>
                    </Show>
                </dl>

                {/* What the proposal RUNS if it passes: the module messages it carries, by the type
                    url each one is registered under. */}
                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.messages') }
                    </h2>
                    <Show
                        when={ proposal.messages.length > 0 }
                        fallback={ <EmptyState icon="contract" title={ locale.t('governance.messages.none') } hint={ locale.t('governance.messages.none.hint') } /> }
                    >
                        <ul class="divide-y divide-line">
                            <For each={ proposal.messages } key={ (message, at) => `${ at }-${ message.type }` } let={ message }>
                                <li class="flex flex-col gap-2 px-4 py-3">
                                    <p class="hash text-[13px] font-semibold">{ message.type }</p>
                                    {/* The message itself, not only which module it addresses: a
                                        type url says what is being changed and nothing about how.
                                        Printed as text - it is json from a transaction, and this
                                        page renders none of it. */}
                                    <pre class="hash overflow-x-auto rounded-lg bg-raised px-3 py-2 text-[12px] leading-relaxed text-muted">{ message.body }</pre>
                                </li>
                            </For>
                        </ul>
                    </Show>
                </section>

                {/* A proposal reaches a vote only once its deposit is met, and anybody may add
                    to it - so who did is part of the record. */}
                <Show when={ shown.deposits.length > 0 }>
                    <section class="panel overflow-hidden">
                        <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                            { locale.t('governance.deposits') }
                        </h2>
                        <ul class="divide-y divide-line">
                            <For each={ shown.deposits } key={ (row, at) => `${ at }-${ row.depositor }` } let={ row }>
                                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                                    <span class="min-w-52 flex-1">
                                        <HashLink
                                            value={ row.depositor }
                                            to={ row.depositorHex === null ? undefined : `/address/${ row.depositorHex }` }
                                            tone="muted"
                                            lead={ 10 }
                                            tail={ 6 }
                                            copy={ false }
                                            class="text-[13px]"
                                        />
                                    </span>
                                    <span class="w-full text-end text-[13px] sm:w-auto">
                                        <span class="amount">{ formatAmount(row.amount[0]?.amount ?? '0', decimals) }</span> { symbol }
                                    </span>
                                </li>
                            </For>
                        </ul>
                    </section>
                </Show>

                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.ballots', { count: locale.n(shown.total) }) }
                    </h2>
                    <ul class="divide-y divide-line">
                        <For each={ shown.votes } key={ (row, at) => `${ at }-${ row.voter }-${ row.option }` } let={ row }>
                            <li class="flex flex-col gap-1.5 px-4 py-3">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <span class="flex items-center gap-2 text-[13px]">
                                        <span class={ `h-2 w-2 shrink-0 rounded-full ${ OPTION_DOT[row.option] ?? 'bg-line' }` } aria-hidden="true"></span>
                                        { locale.t(`governance.option.${ row.option }`) }
                                    </span>
                                    <span class="min-w-52 flex-1">
                                        <HashLink
                                            value={ row.voter }
                                            to={ row.voterHex === null ? undefined : `/address/${ row.voterHex }` }
                                            tone="muted"
                                            lead={ 10 }
                                            tail={ 6 }
                                            copy={ false }
                                            class="text-[13px]"
                                        />
                                    </span>
                                    <span class="w-full text-end text-[13px] tabular-nums text-muted sm:w-auto">{ weightOf(row) }</span>
                                </div>
                                <Show when={ row.metadata !== '' }>
                                    <p class="break-words text-[13px] leading-relaxed text-muted" dir="auto">{ row.metadata }</p>
                                </Show>
                            </li>
                        </For>
                    </ul>

                    <Show when={ shown.votes.length === 0 }>
                        <EmptyState icon="vote" title={ locale.t('governance.ballots.empty') } hint={ locale.t('governance.ballots.empty.hint') } />
                    </Show>

                    <Show when={ shown.pages > 1 }>
                        <div class="border-t border-line">
                            <Pagination page={ shown.page } pages={ shown.pages } onChange={ (next) => page = next } />
                        </div>
                    </Show>
                </section>
            </div>
        }
        </Show>
    </div>
}
