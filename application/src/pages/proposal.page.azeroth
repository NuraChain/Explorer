import { useParams } from 'azerothjs';

import { client, type Proposal, type ProposalDetail, type ProposalState, type Vote } from '../api.ts';
import { formatAmount, formatValue } from '../lib/format.ts';
import { isActionable, PROPOSAL_ICON, PROPOSAL_TONE, share, supportOf, totalCast } from '../lib/governance.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import HashLink from '../components/chain/hash-link.component.azeroth';
import ProposalActions from '../components/chain/proposal-actions.component.azeroth';
import VoteTally from '../components/chain/vote-tally.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// One proposal: what it says, what it would do, how the vote is going, and - for a reader with a
// wallet - the controls to take part in it.
//
// Two of the figures here come from the governor itself rather than from the index (the state and
// the tally), because a governor is the authority on its own proposal. Where its answer differs
// from the one derived downstairs, the page says so rather than quietly showing one of them.

/**
 * A proposal-shaped nothing, and a detail-shaped nothing.
 *
 * Every panel below hands values to components that read them LAZILY - a HashLink asks for its own
 * `to` when it re-runs, a Badge for its own tone - and leaving this route clears the resource
 * before those children are torn down. Written as `shown.proposal.governor`, that last
 * read lands on nothing and takes the whole page into the error boundary on the way OUT of it,
 * which is what the back button does.
 *
 * These stand-ins answer that read with empty strings. Nothing is ever drawn from them - `<Show>`
 * is still what decides whether a panel exists - and `closed` is the one state with no action
 * behind it, so the write panel cannot appear over one either.
 */
const NO_PROPOSAL: Proposal = {
    governor: '', governorName: '', id: '', proposer: '', title: '', status: 'closed',
    voteStart: '0', voteEnd: '0', clock: 'blocknumber', forVotes: '0', againstVotes: '0',
    abstainVotes: '0', quorum: null, voters: 0, at: '1970-01-01T00:00:00.000Z', txHash: ''
};

const NO_DETAIL: ProposalDetail = {
    proposal: NO_PROPOSAL, description: '', descriptionHash: '0x',
    calls: { castVote: '0x', castVoteWithReason: '0x', queue: '0x', execute: '0x', delegate: '0x', getPastVotes: '0x', hasVoted: '0x' },
    actions: [], liveState: null, countingMode: '', token: null, tokenSymbol: '', tokenDecimals: null,
    createdTx: '', canceledTx: null, queuedTx: null, queuedEta: null, executedTx: null,
    votes: [], total: 0, page: 1, pages: 1
};

/** The dot beside a ballot, in the same three colours the tally above it draws. */
const SUPPORT_DOT: Record<string, string> = {
    for: 'bg-nur',
    against: 'bg-faint',
    abstain: 'bg-line'
};

export default component ProposalPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;

    resource stats = () => client.stats.summary();
    resource detail = (key: string) =>
    {
        const [governor = '', id = '', at = '1'] = key.split('|');
        return client.governance.one({ params: { governor, id }, query: { page: Number(at), limit: 25 } });
    } with {
        source: params()['governor'] !== undefined && params()['id'] !== undefined
            ? `${ params()['governor'] }|${ params()['id'] }|${ page }`
            : false
    };

    derived shown = detail.data() ?? NO_DETAIL;
    derived proposal = shown.proposal;
    derived decimals = shown.tokenDecimals;
    derived cast = totalCast(proposal);

    /**
     * The stages the chain has actually recorded, in the order they happen.
     *
     * `as const` so each key stays the literal it is: the label below is looked up as
     * `governance.stage.<key>`, and a widened string would make that key unknowable.
     */
    derived stages = ([
        { key: 'created', hash: shown.createdTx },
        { key: 'queued', hash: shown.queuedTx },
        { key: 'executed', hash: shown.executedTx },
        { key: 'canceled', hash: shown.canceledTx }
    ] as const).filter((stage) => stage.hash !== null && stage.hash !== '');

    /** A timepoint printed in the unit its governor counts in - a height, or a date. */
    const timepoint = (value: string): string =>
        (proposal.clock === 'timestamp'
            ? locale.dateTime(new Date(Number(value) * 1000).toISOString())
            : locale.t('governance.atBlock', { block: locale.n(Number(value)) }));

    /** A ballot's weight, or its share where the votes token's decimals are unknown. */
    const weightOf = (row: Vote): string =>
        (decimals === null
            ? locale.t('governance.share', { percent: locale.n(share(BigInt(row.weight), cast), 1) })
            : `${ formatAmount(row.weight, decimals) } ${ shown.tokenSymbol }`.trim());

    const stateLabel = (state: ProposalState): string => locale.t(`governance.state.${ state }`);

    useTitle(() => locale.t('governance.proposal.title'));

    <div class="flex flex-col gap-5">
        <Show when={ detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">{ locale.t('governance.proposal.missing.title') }</h1>
                <p class="mt-2 text-[15px] text-muted">{ locale.t('governance.proposal.missing.hint') }</p>
            </div>
        </Show>

        <Show when={ detail.data() === undefined && detail.error() === undefined }>
            <div class="flex flex-col gap-3">
                <Skeleton class="h-24 w-full" />
                <Skeleton class="h-40 w-full" />
            </div>
        </Show>

        <Show when={ detail.data() !== undefined }>
        { () =>
            <div class="flex flex-col gap-5">
                <header class="panel flex flex-col gap-3 px-4 py-4 sm:px-5">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        <Badge tone={ PROPOSAL_TONE[proposal.status] } icon={ PROPOSAL_ICON[proposal.status] }>
                            { stateLabel(proposal.status) }
                        </Badge>
                        {/* Said out loud only when the two READINGS differ. The governor counts
                            its own votes, and a page that showed a derived state beside a
                            contradicting one without a word would leave the reader to guess. */}
                        <Show when={ shown.liveState !== null && shown.liveState !== proposal.status }>
                            <span class="text-[12px] text-faint">
                                { locale.t('governance.live', { state: stateLabel(shown.liveState ?? 'closed') }) }
                            </span>
                        </Show>
                    </div>

                    {/* `dir="auto"` on everything the PROPOSER wrote - the title here, the
                        description below, and every reason in the ballots. It is text in a script
                        this page cannot know, and left to inherit the page's direction its
                        punctuation lands at the wrong end of the line. */}
                    <h1 class="text-[20px] font-bold leading-snug tracking-tight sm:text-[22px]" dir="auto">
                        { proposal.title === '' ? locale.t('governance.untitled') : proposal.title }
                    </h1>

                    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-muted">
                        { locale.t('governance.proposedBy') }
                        <HashLink value={ proposal.proposer } to={ `/address/${ proposal.proposer }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[13px]" />
                        <Tooltip label={ locale.dateTime(proposal.at) }><span>{ locale.ago(proposal.at) }</span></Tooltip>
                    </p>
                </header>

                <section class="panel flex flex-col gap-4 px-4 py-4">
                    <h2 class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">{ locale.t('governance.tally') }</h2>
                    <VoteTally
                        tally={ proposal! }
                        decimals={ decimals }
                        symbol={ shown.tokenSymbol }
                    />
                    <p class="text-[12px] text-faint">
                        { locale.t('governance.voters', { count: locale.n(proposal.voters) }) }
                    </p>
                </section>

                {/* The write half, and only where there is something to write - and only once
                    the chain description has arrived, because every control in there is offered
                    against a chain id and a decimals the wallet has to be checked against. */}
                <Show when={ isActionable(proposal.status) && stats.data() !== undefined }>
                { () =>
                    <ProposalActions
                        detail={ shown }
                        chain={ stats.data()!.chain }
                        onSent={ () => detail.refetch() }
                    />
                }
                </Show>

                <dl class="panel divide-y divide-line">
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('governance.governor') }</dt>
                        {/* The floor the transaction page uses: under it the row wraps and the
                            address takes the width rather than being squeezed narrower than
                            itself. */}
                        <dd class="min-w-52 flex-1">
                            <HashLink value={ proposal.governor } to={ `/address/${ proposal.governor }` } lead={ 12 } tail={ 8 } />
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('governance.id') }</dt>
                        <dd class="hash min-w-0 flex-1 text-[13px] text-muted">{ proposal.id }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('governance.voteStart') }</dt>
                        <dd class="flex-1 text-[14px]">{ timepoint(proposal.voteStart) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('governance.voteEnd') }</dt>
                        <dd class="flex-1 text-[14px]">{ timepoint(proposal.voteEnd) }</dd>
                    </div>
                    <Show when={ shown.countingMode !== '' }>
                        <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                            <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('governance.counting') }</dt>
                            <dd class="hash min-w-0 flex-1 text-[13px] text-muted">{ shown.countingMode }</dd>
                        </div>
                    </Show>
                </dl>

                {/* The lifecycle, as transactions. Each stage appears only once the chain records
                    it, so the list is the proposal's history and never a checklist of blanks. */}
                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.timeline') }
                    </h2>
                    <ul class="divide-y divide-line">
                        <For each={ stages } key={ (stage) => stage.key } let={ stage }>
                            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3">
                                <span class="w-28 shrink-0 text-[13px] text-muted">
                                    { locale.t(`governance.stage.${ stage.key }`) }
                                </span>
                                <span class="min-w-52 flex-1">
                                    <HashLink value={ stage.hash ?? '' } to={ `/tx/${ stage.hash ?? '' }` } lead={ 12 } tail={ 8 } copy={ false } />
                                </span>
                            </li>
                        </For>
                    </ul>
                    <Show when={ shown.queuedEta !== null }>
                        <p class="border-t border-line px-4 py-3 text-[13px] text-muted">
                            { locale.t('governance.eta', {
                                date: locale.dateTime(new Date(Number(shown.queuedEta) * 1000).toISOString())
                            }) }
                        </p>
                    </Show>
                </section>

                {/* What the proposal SAYS, as its author wrote it. Printed as text and never as
                    markup: a description is whatever string somebody put in a transaction, and
                    rendering it would let a proposal draw the page it appears on. */}
                <section class="panel px-4 py-4">
                    <h2 class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">{ locale.t('governance.description') }</h2>
                    <p class="mt-3 whitespace-pre-wrap break-words text-[14px] leading-relaxed" dir="auto">
                        { shown.description === '' ? locale.t('governance.description.none') : shown.description }
                    </p>
                </section>

                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.calls') }
                    </h2>
                    <Show
                        when={ shown.actions.length > 0 }
                        fallback={ <EmptyState icon="contract" title={ locale.t('governance.calls.none') } hint={ locale.t('governance.calls.none.hint') } /> }
                    >
                        <ul class="divide-y divide-line">
                            {/* Keyed by position: the calls are a fixed, ordered list, and two of
                                them can be the same call to the same target twice. */}
                            <For each={ shown.actions } key={ (_action, at) => String(at) } let={ action }>
                                <li class="flex flex-col gap-2 px-4 py-3">
                                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                        <span class="w-16 shrink-0 text-[13px] text-muted">{ locale.t('governance.call.to') }</span>
                                        <span class="min-w-52 flex-1">
                                            <HashLink value={ action.target } to={ `/address/${ action.target }` } lead={ 12 } tail={ 8 } copy={ false } />
                                        </span>
                                    </div>
                                    <Show when={ action.value !== '0' }>
                                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                            <span class="w-16 shrink-0 text-[13px] text-muted">{ locale.t('governance.call.value') }</span>
                                            <span class="amount flex-1 text-[14px] font-semibold">
                                                { formatValue(action.value, stats.data()?.chain.symbol ?? '', stats.data()?.chain.decimals ?? 18) }
                                            </span>
                                        </div>
                                    </Show>
                                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                        <span class="w-16 shrink-0 text-[13px] text-muted">{ locale.t('governance.call.data') }</span>
                                        <span class="hash min-w-0 flex-1 text-[13px] text-muted">
                                            {/* Named where the selector is one the explorer's table
                                                knows; the raw bytes stay below it either way,
                                                because the name is a lookup and the bytes are the
                                                transaction. */}
                                            <Show when={ action.signature !== null }>
                                                <span class="me-2 font-semibold text-text">{ action.signature }</span>
                                            </Show>
                                            { action.calldata }
                                        </span>
                                    </div>
                                </li>
                            </For>
                        </ul>
                    </Show>
                </section>

                <section class="panel overflow-hidden">
                    <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                        { locale.t('governance.ballots', { count: locale.n(shown.total) }) }
                    </h2>
                    <ul class="divide-y divide-line">
                        <For each={ shown.votes } key={ (row) => `${ row.txHash }-${ row.voter }` } let={ row }>
                            <li class="flex flex-col gap-1.5 px-4 py-3">
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                    <span class="flex items-center gap-2 text-[13px]">
                                        <span
                                            class={ `h-2 w-2 shrink-0 rounded-full ${ SUPPORT_DOT[supportOf(row.support) ?? 'abstain'] ?? 'bg-line' }` }
                                            aria-hidden="true"
                                        ></span>
                                        { supportOf(row.support) === null
                                            ? locale.t('governance.support.other')
                                            : locale.t(`governance.support.${ supportOf(row.support) ?? 'abstain' }`) }
                                    </span>
                                    <span class="min-w-52 flex-1">
                                        <HashLink value={ row.voter } to={ `/address/${ row.voter }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } class="text-[13px]" />
                                    </span>
                                    <span class="amount w-full text-end text-[13px] sm:w-auto">{ weightOf(row) }</span>
                                </div>
                                <Show when={ row.reason !== '' }>
                                    <p class="break-words text-[13px] leading-relaxed text-muted" dir="auto">{ row.reason }</p>
                                </Show>
                                <Tooltip label={ locale.dateTime(row.at) } class="flex">
                                    <p class="text-[12px] text-faint">{ locale.ago(row.at) }</p>
                                </Tooltip>
                            </li>
                        </For>
                    </ul>

                    <Show when={ shown.votes.length === 0 }>
                        <EmptyState icon="vote" title={ locale.t('governance.ballots.empty') } hint={ locale.t('governance.ballots.empty.hint') } />
                    </Show>

                    <Show when={ shown.pages > 1 }>
                        <div class="border-t border-line">
                            <Pagination page={ shown.page } pages={ shown.pages } onChange={ (next) => page = next } />
                        </div>
                    </Show>
                </section>
            </div>
        }
        </Show>
    </div>
}
