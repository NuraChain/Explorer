import { Link, useLoader } from 'azerothjs';

import { formatGwei, formatValue, gasShare, shortHash } from '../lib/format.ts';
import type { HomeData } from '../lib/loaders.ts';
import { explorerSchema, pageHead } from '../lib/head.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import AddChainButton from '../components/chain/add-chain-button.component.azeroth';
import CadenceStrip from '../components/chain/cadence-strip.component.azeroth';
import PriceTicker from '../components/chain/price-ticker.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import HashLink from '../components/chain/hash-link.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';

// The hero is the chain's pulse. Search is NOT repeated here - the header carries it on every
// page, including this one. Counters sit under the hero as a quiet strip rather than being the
// headline: an explorer's job is to find one thing, not to display totals.
export default component Home()
{
    const locale = useLocale();

    // All four figures arrive WITH the document - `routes.ts` declares the loader, and its result
    // rides the handoff into this render. The front door used to paint four skeletons and then
    // fetch them, so the page a reader arrives at was the one that took longest to say anything.
    const loaded = useLoader<HomeData>();

    // Blocks arrive every few seconds, so the page follows them instead of going stale until a
    // reload. One timer and one call: re-running the loader re-reads all four together, where
    // four independent refetches could land a head, a cadence and two lists from three different
    // moments. Cleared when the page unmounts.
    effect
    {
        const timer = setInterval(() => void loaded.refetch(), 5000);
        return () => clearInterval(timer);
    }

    derived summary = loaded.data()?.stats;
    derived cadence = loaded.data()?.cadence;
    derived blocks = loaded.data()?.blocks;
    derived txs = loaded.data()?.txs;

    derived symbol = summary?.chain.symbol ?? '';
    derived decimals = summary?.chain.decimals ?? 18;
    derived behind = summary === undefined ? 0 : Math.max(0, summary.chainHead - summary.head);

    derived chain = summary === undefined ? locale.t('title.chainFallback') : locale.chainName(summary.chain.name);

    pageHead({
        title: () => locale.t('title.chainExplorer', { chain }),
        // "Nura Chain explorer" already names the product; suffixed it says it twice.
        standalone: true,
        description: () => locale.t('meta.home', { chain }),
        path: () => '/',
        origin: () => summary?.chain.explorerUrl ?? '',
        // The one page that describes the site rather than a record on it, so it is where the
        // site's own schema belongs - stated once, not on every page.
        jsonLd: () => [explorerSchema(chain, (summary?.chain.explorerUrl ?? '').replace(/\/+$/, ''))]
    });

    <div class="flex flex-col gap-6">
        <section class="relative pt-4">
            {/* A pool of accent light behind the headline: the hero states what the product is,
                and the glow is what makes the statement feel lit rather than printed. Pure CSS,
                no image, no request - and it fades to nothing on the theme where the accent is
                darkest, the same way every accent on the page does. Painted first, so the
                content after it always sits on top; never negative z, which would slip it
                behind the page's own ground. */}
            <div aria-hidden="true" role="presentation" class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[46rem] max-w-full -translate-x-1/2 rounded-full bg-nur/10 blur-3xl" />
            <div class="relative">
                {/* Assembled from four catalog slots rather than one sentence with a span in the
                    middle, so a verb-final language can put its verb after the chain name. */}
                <h1 class="text-[28px] font-bold leading-tight tracking-tight sm:text-[36px] lg:text-[40px]">
                    { locale.t('home.hero.lead') } <span class="text-nur">{ locale.t('home.hero.accent') }</span> { locale.t('home.hero.through') }
                    <Show when={ summary !== undefined } fallback={ <span> { locale.t('home.hero.fallback') }</span> }>
                    { () => <span> { locale.chainName(summary!.chain.name) }</span> }
                    </Show>
                    { locale.t('home.hero.trail') === '' ? '' : ` ${ locale.t('home.hero.trail') }` }
                </h1>
                <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted sm:text-base">{ locale.t('home.tagline') }</p>
                {/* Offered once, on the overview: the visitor who wants the chain in their wallet
                    wants it before they start reading, not on a transaction page.

                    NOT inside a `<Show>` that reads `summary`, which is what this used to be.
                    The poll above hands back a new payload every five seconds, and a Show whose
                    child reads it rebuilds that child every time - which is invisible for a plain
                    button and fatal for one that owns a dialog, because the reader's open dialog is
                    swept away mid-choice. Both controls are created ONCE here and take what they
                    need as props; each decides for itself what to render before the first payload
                    lands. */}
                <div class="mt-5 flex flex-wrap items-center gap-2.5">
                    <AddChainButton chain={ summary?.chain ?? null } />
                    <PriceTicker />
                </div>
            </div>
        </section>

        <Show when={ cadence !== undefined }>
        { () => <CadenceStrip blocks={ cadence!.rows } symbol={ symbol } /> }
        </Show>

        {/* The index trails the node during a backfill. Saying so is the honest alternative to a
            reader concluding the chain has stopped. */}
        <Show when={ behind > 2 }>
            <p class="flex items-center gap-2 rounded-lg border border-line bg-field px-4 py-2.5 text-[14px] text-muted">
                <Icon name="activity" size={ 15 } class="text-nur" />
                { locale.t('home.behind', { count: locale.n(behind) }) }
            </p>
        </Show>

        {/* Same four-up rule as the address page: a chain deep enough to have a ten-digit height
            has counters too wide for a quarter of a tablet. */}
        <Show when={ summary !== undefined }>
        { () =>
            <dl class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-4">
                {/* Each counter leads with the glyph for WHAT it counts: four tiles of bare
                    numbers read as a spreadsheet, and a reader landing here scans icons before
                    they read labels. The tile is the one thing on the card allowed to be
                    decorative, and the border lift on hover is the affordance the numbers
                    themselves never need - they are not links. */}
                <div class="panel flex items-start gap-3.5 px-4 py-4 transition-colors duration-150 hover:border-nur/50">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="block" size={ 16 } />
                    </span>
                    <div class="min-w-0">
                        <dt class="text-[13px] text-muted">{ locale.t('home.stat.height') }</dt>
                        <dd class="amount mt-1 text-[19px] font-bold sm:text-[20px]">{ locale.n(summary!.head) }</dd>
                    </div>
                </div>
                <div class="panel flex items-start gap-3.5 px-4 py-4 transition-colors duration-150 hover:border-nur/50">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="transaction" size={ 16 } />
                    </span>
                    <div class="min-w-0">
                        <dt class="text-[13px] text-muted">{ locale.t('home.stat.transactions') }</dt>
                        <dd class="amount mt-1 text-[19px] font-bold sm:text-[20px]">{ locale.n(summary!.indexed.transactions) }</dd>
                    </div>
                </div>
                <div class="panel flex items-start gap-3.5 px-4 py-4 transition-colors duration-150 hover:border-nur/50">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="activity" size={ 16 } />
                    </span>
                    <div class="min-w-0">
                        <dt class="text-[13px] text-muted">{ locale.t('home.stat.blockTime') }</dt>
                        <dd class="amount mt-1 text-[19px] font-bold sm:text-[20px]">{ locale.n(summary!.blockTime, 2) }s</dd>
                    </div>
                </div>
                <div class="panel flex items-start gap-3.5 px-4 py-4 transition-colors duration-150 hover:border-nur/50">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-raised text-nur">
                        <Icon name="gas" size={ 16 } />
                    </span>
                    <div class="min-w-0">
                        <dt class="text-[13px] text-muted">{ locale.t('home.stat.baseFee') }</dt>
                        <dd class="amount mt-1 text-[19px] font-bold sm:text-[20px]">{ formatGwei(summary!.gasPrice) }</dd>
                    </div>
                </div>
            </dl>
        }
        </Show>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <section class="panel overflow-hidden">
                <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 sm:px-5">
                    <h2 class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="block" size={ 15 } class="text-nur" />
                        { locale.t('home.latestBlocks') }
                    </h2>
                    <Link to="/blocks" class="flex items-center gap-1 rounded-md border border-line px-2.5 py-1 text-[12px] text-muted no-underline transition-colors duration-150 hover:border-nur hover:text-nur">
                        { locale.t('home.all') }
                        <Icon name="chevron-right" size={ 13 } class="icon-flip" />
                    </Link>
                </div>
                {/* A row on a screen, a card on a phone - the same pair the blocks list carries. */}
                <ul class="flex flex-col gap-2.5 p-3 sm:gap-0 sm:p-0">
                    <For each={ blocks?.rows ?? [] } key={ (block) => String(block.number) } let={ block }>
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-line bg-raised px-3 py-2.5 transition-colors duration-150 hover:bg-field sm:rounded-none sm:border-x-0 sm:border-b-0 sm:bg-transparent sm:first:border-t-0 sm:px-4 sm:hover:bg-raised/60">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-field text-nur sm:bg-raised">
                                <Icon name="block" size={ 15 } />
                            </span>
                            <div class="min-w-0 flex-1">
                                <Link to={ `/block/${ block.number }` } class="data text-[14px] font-semibold text-text no-underline hover:text-nur">
                                    #{ block.number }
                                </Link>
                                <Tooltip label={ locale.dateTime(block.at) } class="flex"><p class="text-[12px] text-muted">{ locale.ago(block.at) }</p></Tooltip>
                            </div>
                            <div class="text-end">
                                {/* A sentence with a count in it, not chain data - see the note
                                    on the same line of the blocks list. */}
                                <p class="text-[13px] tabular-nums">{ locale.t('chain.txCount', { count: locale.n(block.txCount) }) }</p>
                                {/* The percentage is a rounding of two numbers the reader cannot
                                    see, exactly as on the blocks list - so it carries the same
                                    bubble rather than being the one place they are hidden. */}
                                <Tooltip label={ locale.t('blocks.gasTooltip', { used: locale.n(Number(block.gasUsed)), limit: locale.n(Number(block.gasLimit)) }) } class="flex justify-end"><p class="text-[12px] text-muted">{ locale.t('chain.gasShare', { percent: locale.n(gasShare(block.gasUsed, block.gasLimit) * 100, 1) }) }</p></Tooltip>
                            </div>
                        </li>
                    </For>
                </ul>
                <Show when={ blocks?.rows.length === 0 }>
                    <EmptyState icon="block" title={ locale.t('home.empty.blocks') } />
                </Show>
            </section>

            <section class="panel overflow-hidden">
                <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 sm:px-5">
                    <h2 class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="transaction" size={ 15 } class="text-nur" />
                        { locale.t('home.latestTransactions') }
                    </h2>
                    <Link to="/txs" class="flex items-center gap-1 rounded-md border border-line px-2.5 py-1 text-[12px] text-muted no-underline transition-colors duration-150 hover:border-nur hover:text-nur">
                        { locale.t('home.all') }
                        <Icon name="chevron-right" size={ 13 } class="icon-flip" />
                    </Link>
                </div>
                {/* A row on a screen, a card on a phone - the same pair the blocks list carries. */}
                <ul class="flex flex-col gap-2.5 p-3 sm:gap-0 sm:p-0">
                    <For each={ txs?.rows ?? [] } key={ (row) => row.hash } let={ row }>
                        <li class="flex flex-col gap-1.5 rounded-lg border border-line bg-raised px-3 py-2.5 transition-colors duration-150 hover:bg-field sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-1 sm:rounded-none sm:border-x-0 sm:border-b-0 sm:bg-transparent sm:first:border-t-0 sm:px-4 sm:hover:bg-raised/60">
                            {/* The card's header: what happened and how much moved, the same pair
                                the transactions list leads with. `sm:contents` hands both back to
                                the row above the breakpoint, and on a phone it leaves the hash a
                                line of its own rather than a column between two others. */}
                            <div class="flex items-center justify-between gap-3 sm:contents">
                                <Badge
                                    tone={ row.status === 'reverted' ? 'danger' : row.status === 'unknown' ? 'neutral' : 'success' }
                                    icon={ row.status === 'reverted' ? 'alert' : 'success' }
                                >
                                    { locale.t(`chain.status.${ row.status }`) }
                                </Badge>
                                {/* Capped rather than shrink-0 above `sm:`: an unbounded value
                                    column pushed the hash beside it down to nothing and then ran
                                    off the card anyway. */}
                                <p class="text-end text-[13px] sm:order-last sm:max-w-[45%] sm:shrink-0"><span class="amount">{ formatValue(row.value, symbol, decimals) }</span></p>
                            </div>

                            <div class="min-w-0 sm:flex-1">
                                <HashLink value={ row.hash } to={ `/tx/${ row.hash }` } lead={ 12 } tail={ 6 } />
                                {/* The counterparty is shortened INSIDE a sentence, so it stays a
                                    sentence and the bubble carries the whole address. A HashLink
                                    here would put a second link in a row whose hash is already
                                    one, and split the phrase around it. */}
                                <Show
                                    when={ row.to }
                                    fallback={ <p class="text-[12px] text-muted">{ locale.t('chain.contractCreation') }</p> }
                                    let={ to }
                                >
                                    <Tooltip label={ to } class="flex">
                                        <p class="text-[12px] text-muted">{ locale.t('chain.to', { address: shortHash(to, 8, 6) }) }</p>
                                    </Tooltip>
                                </Show>
                            </div>
                        </li>
                    </For>
                </ul>
                <Show when={ txs?.rows.length === 0 }>
                    <EmptyState icon="activity" title={ locale.t('home.empty.transactions') } />
                </Show>
            </section>
        </div>
    </div>
}
