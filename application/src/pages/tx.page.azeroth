import { Link, useParams } from 'azerothjs';

import { client } from '../api.ts';
import { formatAmount, formatGwei, formatValue } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import HashLink from '../components/chain/hash-link.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';

export default component TransactionPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;

    resource stats = () => client.stats.summary();
    // The page is part of the key: the transfers a transaction emitted are paged, and one call to
    // a distributor emits a log per recipient - a receipt can carry hundreds.
    resource detail = (key: string) =>
    {
        const [hash = '', at = '1'] = key.split('|');
        return client.txs.one({ params: { hash }, query: { page: Number(at), limit: 25 } });
    } with { source: params()['hash'] === undefined ? false : `${ params()['hash'] }|${ page }` };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    useTitle(() => locale.t('tx.title'));

    <div class="flex flex-col gap-5">
        <Show when={ detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">{ locale.t('tx.missing.title') }</h1>
                <p class="mt-2 text-[15px] text-muted">{ locale.t('tx.missing.hint') }</p>
            </div>
        </Show>

        <Show when={ detail.data() !== undefined }>
        { () =>
            <div class="flex flex-col gap-5">
                <header class="flex flex-wrap items-center gap-3">
                    <span class={ detail.data()!.transaction.status === 'reverted'
                        ? 'flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-outflow'
                        : 'flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-inflow' }
                    >
                        <Icon name={ detail.data()!.transaction.status === 'reverted' ? 'alert' : 'success' } size={ 19 } />
                    </span>
                    <div class="min-w-0 flex-1">
                        <h1 class="text-[20px] font-bold tracking-tight">{ locale.t('tx.title') }</h1>
                        <p class="text-[13px] text-muted">
                            { locale.dateTime(detail.data()!.transaction.at) } &middot; { locale.ago(detail.data()!.transaction.at) }
                        </p>
                    </div>
                    <Badge
                        tone={ detail.data()!.transaction.status === 'reverted' ? 'danger' : detail.data()!.transaction.status === 'unknown' ? 'neutral' : 'success' }
                        icon={ detail.data()!.transaction.status === 'reverted' ? 'alert' : 'success' }
                    >
                        { locale.t(`chain.status.${ detail.data()!.transaction.status }`) }
                    </Badge>
                </header>

                {/* The reverted case is said in words, not only in colour: a failed transfer that
                    reads as a successful one is the worst mistake this page could make. */}
                <Show when={ detail.data()!.transaction.status === 'reverted' }>
                    <p class="flex items-start gap-2 rounded-lg border border-outflow bg-raised px-4 py-3 text-[14px] text-outflow">
                        <Icon name="alert" size={ 16 } class="mt-0.5 shrink-0" />
                        { locale.t('tx.reverted.notice') }
                    </p>
                </Show>

                <dl class="panel divide-y divide-line">
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.hash') }</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.transaction.hash } tone="text" lead={ 20 } tail={ 12 } copy /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.block') }</dt>
                        <dd class="flex-1">
                            <Link to={ `/block/${ detail.data()!.transaction.blockNumber }` } class="data text-[14px] text-beam no-underline hover:underline">
                                #{ detail.data()!.transaction.blockNumber }
                            </Link>
                            <span class="ms-2 text-[13px] text-muted">{ locale.t('tx.position', { index: locale.n(detail.data()!.transaction.index) }) }</span>
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.from') }</dt>
                        <dd class="min-w-0 flex-1"><HashLink value={ detail.data()!.transaction.from } to={ `/address/${ detail.data()!.transaction.from }` } lead={ 16 } tail={ 10 } copy /></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.to') }</dt>
                        <dd class="min-w-0 flex-1">
                            <Show
                                when={ detail.data()!.transaction.to }
                                fallback={
                                    <Show when={ detail.data()!.transaction.contractAddress } fallback={ <span class="text-[14px] text-muted">{ locale.t('chain.contractCreation') }</span> } let={ created }>
                                        <span class="flex flex-wrap items-center gap-2">
                                            <span class="text-[13px] text-muted">{ locale.t('tx.created') }</span>
                                            <HashLink value={ created } to={ `/address/${ created }` } lead={ 16 } tail={ 10 } copy />
                                        </span>
                                    </Show>
                                }
                             let={ to }>
                            <HashLink value={ to } to={ `/address/${ to }` } lead={ 16 } tail={ 10 } copy />
                            </Show>
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.value') }</dt>
                        {/* `amount` on the value, not on the dd: the utility forces ltr, and on a
                            block element that also decides where the line starts, so the figure
                            stood against the far edge from its own label in a mirrored layout. */}
                        <dd class="min-w-0 flex-1 text-[16px] font-bold"><span class="amount">{ formatValue(detail.data()!.transaction.value, symbol, decimals) }</span></dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.fee') }</dt>
                        <dd class="flex-1">
                            <span class="amount text-[14px]">{ formatValue(detail.data()!.transaction.fee, symbol, decimals) }</span>
                            <span class="ms-2 text-[13px] text-muted">
                                { locale.t('tx.feeDetail', { gas: locale.n(Number(detail.data()!.transaction.gasUsed)), price: formatGwei(detail.data()!.transaction.gasPrice) }) }
                            </span>
                        </dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                        <dt class="w-28 shrink-0 text-[13px] text-muted">{ locale.t('tx.nonce') }</dt>
                        {/* The nonce is chain data and the calldata size beside it is a sentence in
                            the reader's language, so only the first goes inside the isolate - on
                            the dd it took the whole row to the wrong edge and dragged the words
                            with it. */}
                        <dd class="flex-1 text-[14px]">
                            <span class="data">{ detail.data()!.transaction.nonce }</span>
                            <Show when={ detail.data()!.transaction.inputSize > 0 }>
                                <span class="ms-3 text-[13px] text-muted">{ locale.t('tx.calldata', { size: locale.bytes(detail.data()!.transaction.inputSize) }) }</span>
                            </Show>
                        </dd>
                    </div>
                </dl>

                <Show when={ detail.data()!.total > 0 }>
                    <section class="panel overflow-hidden">
                        <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                            { locale.t('tx.transfers', { count: locale.n(detail.data()!.total) }) }
                        </h2>
                        <ul class="divide-y divide-line">
                            <For each={ detail.data()!.transfers } key={ (row) => `${ row.txHash }-${ row.logIndex }` } let={ row }>
                            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                                    <Icon name="token" size={ 16 } class="text-nur" />
                                    <div class="min-w-0 flex-1 text-[13px] text-muted">
                                        <HashLink value={ row.from } to={ `/address/${ row.from }` } tone="muted" lead={ 8 } tail={ 6 } />
                                        <span class="icon-flip mx-1.5 inline-block">&rarr;</span>
                                        <HashLink value={ row.to } to={ `/address/${ row.to }` } tone="muted" lead={ 8 } tail={ 6 } />
                                    </div>
                                    <p class="amount text-[14px] font-semibold">
                                        { formatAmount(row.value, row.tokenDecimals) }
                                        <span class="ms-1.5 text-muted">{ row.tokenSymbol === '' ? locale.t('tx.token') : row.tokenSymbol }</span>
                                    </p>
                                </li>
                            </For>
                        </ul>
                        <Show when={ detail.data()!.pages > 1 }>
                            <div class="border-t border-line">
                                <Pagination page={ detail.data()!.page } pages={ detail.data()!.pages } onChange={ (next) => page = next } />
                            </div>
                        </Show>
                    </section>
                </Show>
            </div>
        }
        </Show>
    </div>
}
