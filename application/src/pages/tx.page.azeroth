import { createResource, Link, useLoader, useParams } from 'azerothjs';

import { client, type DecodedCall } from '../api.ts';
import { formatAmount, formatGwei, formatValue, shortHash } from '../lib/format.ts';
import type { TransactionData } from '../lib/loaders.ts';
import { breadcrumbs, pageHead } from '../lib/head.ts';
import { useLocale } from '../stores/locale.store.ts';

import Icon from '../icons/icon.component.azeroth';

import HashLink from '../components/chain/hash-link.component.azeroth';
import Badge from '../components/ui/badge.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';

export default component TransactionPage()
{
    const params = useParams();
    const locale = useLocale();

    state page = 1;

    // The transaction and the chain description arrive WITH the document - `routes.ts` declares
    // the loader, and its result rides the handoff into this render. This is the page a shared
    // link lands on more often than any other, and it used to reach one as an empty shell.
    const loaded = useLoader<TransactionData>();

    derived summary = loaded.data()?.stats;

    /*
     * The same read, for the pages of the transfer list the loader did not fetch. The page is
     * part of the key: the transfers a transaction emitted are paged, and one call to a
     * distributor emits a log per recipient - a receipt can carry hundreds.
     *
     * Seeded from the loader, so the first page costs no request; the source is `false` while the
     * loader failed, because the answer would be the same 404 the page is already rendering.
     */
    /*
     * `createResource` rather than the `resource` keyword, for `initialValue` alone.
     *
     * The seed is what makes the handoff worth having: the resource starts SETTLED on what the
     * server already sent, so the first screen costs no request and hydration draws it without
     * asking again. The keyword's `with { }` clause accepts only `source` and `name` - the
     * runtime option exists and is documented, the keyword just cannot reach it - so this one
     * declaration is written out longhand. See framework-bugs.md #21.
     */
    const detail = createResource(
        () => (loaded.error() !== null || params()['hash'] === undefined ? false : `${ params()['hash'] }|${ page }`),
        (key: string) =>
        {
            const [hash = '', at = '1'] = key.split('|');
            return client.txs.one({ params: { hash }, query: { page: Number(at), limit: 25 } });
        },
        { initialValue: loaded.data()?.detail, name: 'detail' });

    derived symbol = summary?.chain.symbol ?? '';
    derived decimals = summary?.chain.decimals ?? 18;

    derived short = shortHash(params()['hash'] ?? '');

    // Every description names the chain, and the chain is configuration rather than copy -
    // this explorer runs against whatever node it was pointed at. A neutral word stands in
    // for the one render before the loader's answer is in hand.
    /**
     * One row per value: a named struct becomes a row per field, `params.title` beside
     * `params.feeBps`, so a market's whole `MarketParams` reads as the list it is rather than as
     * one comma-joined line.
     */
    const rows = (args: DecodedCall['args']): Array<{ name: string; type: string; value: string; at: number }> =>
        args
            .flatMap((arg) => (arg.fields.length === 0
                ? [arg]
                : arg.fields.map((field) => ({ ...field, name: arg.name === '' ? field.name : `${ arg.name }.${ field.name }` }))))
            .map((row, at) => ({ name: row.name, type: row.type, value: row.value, at }));

    const chainName = (): string =>
        (summary === undefined ? locale.t('title.chainFallback') : locale.chainName(summary.chain.name));

    pageHead({
        title: () => locale.t('meta.txTitle', { short }),
        description: () => locale.t('meta.tx', { short, chain: chainName() }),
        path: () => `/tx/${ params()['hash'] ?? '' }`,
        origin: () => summary?.chain.explorerUrl ?? '',
        jsonLd: () => breadcrumbs((summary?.chain.explorerUrl ?? '').replace(/\/+$/, ''), [
            { name: locale.t('brand.name'), path: '/' },
            { name: locale.t('txs.title'), path: '/txs' },
            { name: locale.t('meta.txTitle', { short }), path: `/tx/${ params()['hash'] ?? '' }` }
        ])
    });

    <div class="flex flex-col gap-5">
        <Show when={ loaded.error() !== null || detail.error() }>
            <div class="panel px-6 py-12 text-center">
                <h1 class="text-[18px] font-bold">{ locale.t('tx.missing.title') }</h1>
                <p class="mt-2 text-[15px] text-muted">{ locale.t('tx.missing.hint') }</p>
            </div>
        </Show>

        <Show when={ detail.data() } let={ shown }>
            <div class="flex flex-col gap-5">
                <header class="flex flex-wrap items-center gap-3">
                    <span class={ shown.transaction.status === 'reverted'
                        ? 'flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-outflow'
                        : 'flex h-10 w-10 items-center justify-center rounded-lg bg-raised text-inflow' }
                    >
                        <Icon name={ shown.transaction.status === 'reverted' ? 'alert' : 'success' } size={ 19 } />
                    </span>
                    <div class="min-w-0 flex-1">
                        <h1 class="text-[20px] font-bold tracking-tight">{ locale.t('tx.title') }</h1>
                        <p class="text-[13px] text-muted">
                            { locale.dateTime(shown.transaction.at) } &middot; { locale.ago(shown.transaction.at) }
                        </p>
                    </div>
                    <Badge
                        tone={ shown.transaction.status === 'reverted' ? 'danger' : shown.transaction.status === 'unknown' ? 'neutral' : 'success' }
                        icon={ shown.transaction.status === 'reverted' ? 'alert' : 'success' }
                    >
                        { locale.t(`chain.status.${ shown.transaction.status }`) }
                    </Badge>
                </header>

                {/* The reverted case is said in words, not only in colour: a failed transfer that
                    reads as a successful one is the worst mistake this page could make. */}
                <Show when={ shown.transaction.status === 'reverted' }>
                    <p class="flex items-start gap-2 rounded-lg border border-outflow bg-raised px-4 py-3 text-[14px] text-outflow">
                        <Icon name="alert" size={ 16 } class="mt-0.5 shrink-0" />
                        { locale.t('tx.reverted.notice') }
                    </p>
                </Show>

                {/* A row on a screen, a card on a phone - the pair the transaction list already
                    draws, here on a definition list. Below `sm:` the label sits above its value
                    and the value takes the whole width, because beside a 112px label a
                    33-character hash is left 226px on a 414px phone and HashLink splits it at
                    the ellipsis rather than clip it. The `min-w-52` floor these rows used to
                    carry wrapped the row on a phone narrow enough - and the wider ones, which
                    cleared the floor by a few pixels, got the split anyway. */}
                <dl class="panel divide-y divide-line">
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.hash') }</dt>
                        <dd class="sm:flex-1"><HashLink value={ shown.transaction.hash } tone="text" lead={ 20 } tail={ 12 } copy /></dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.block') }</dt>
                        <dd class="sm:flex-1">
                            <Link to={ `/block/${ shown.transaction.blockNumber }` } class="data text-[14px] text-beam no-underline hover:underline">
                                #{ shown.transaction.blockNumber }
                            </Link>
                            <span class="ms-2 text-[13px] text-muted">{ locale.t('tx.position', { index: locale.n(shown.transaction.index) }) }</span>
                        </dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.from') }</dt>
                        <dd class="sm:flex-1"><HashLink value={ shown.transaction.from } to={ `/address/${ shown.transaction.from }` } lead={ 16 } tail={ 10 } copy /></dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.to') }</dt>
                        <dd class="sm:flex-1">
                            <Show
                                when={ shown.transaction.to }
                                fallback={
                                    <Show when={ shown.transaction.contractAddress } fallback={ <span class="text-[14px] text-muted">{ locale.t('chain.contractCreation') }</span> } let={ created }>
                                        <span class="flex flex-wrap items-center gap-2">
                                            <span class="text-[13px] text-muted">{ locale.t('tx.created') }</span>
                                            <HashLink value={ created } to={ `/address/${ created }` } lead={ 16 } tail={ 10 } copy />
                                        </span>
                                    </Show>
                                }
                             let={ to }>
                            <HashLink value={ to } to={ `/address/${ to }` } lead={ 16 } tail={ 10 } copy />
                            </Show>
                        </dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.value') }</dt>
                        {/* `amount` on the value, not on the dd: the utility forces ltr, and on a
                            block element that also decides where the line starts, so the figure
                            stood against the far edge from its own label in a mirrored layout. */}
                        <dd class="text-[16px] font-bold sm:min-w-0 sm:flex-1"><span class="amount">{ formatValue(shown.transaction.value, symbol, decimals) }</span></dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.fee') }</dt>
                        <dd class="sm:flex-1">
                            <span class="amount text-[14px]">{ formatValue(shown.transaction.fee, symbol, decimals) }</span>
                            <span class="ms-2 text-[13px] text-muted">
                                { locale.t('tx.feeDetail', { gas: locale.n(Number(shown.transaction.gasUsed)), price: formatGwei(shown.transaction.gasPrice) }) }
                            </span>
                        </dd>
                    </div>
                    <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-3 sm:gap-y-0">
                        <dt class="text-[13px] text-muted sm:w-28 sm:shrink-0">{ locale.t('tx.nonce') }</dt>
                        {/* The nonce is chain data and the calldata size beside it is a sentence in
                            the reader's language, so only the first goes inside the isolate - on
                            the dd it took the whole row to the wrong edge and dragged the words
                            with it. */}
                        <dd class="text-[14px] sm:flex-1">
                            <span class="data">{ shown.transaction.nonce }</span>
                            <Show when={ shown.transaction.inputSize > 0 }>
                                <span class="ms-3 text-[13px] text-muted">{ locale.t('tx.calldata', { size: locale.bytes(shown.transaction.inputSize) }) }</span>
                            </Show>
                        </dd>
                    </div>
                </dl>

                {/* Named through the signature table only - there is no verified ABI behind this
                    page, so an argument has its type and never a parameter name, and an amount is
                    the raw integer because nothing here knows which token's decimals it counts. */}
                <Show when={ shown.call } let={ call }>
                    <section class="panel overflow-hidden">
                        <h2 class="flex items-center gap-2 border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                            <Icon name="contract" size={ 15 } /> { locale.t('tx.input') }
                        </h2>
                        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3">
                            <span class="data text-[13px] text-muted">{ call.selector }</span>
                            <Show when={ call.signature !== '' } fallback={ <span class="text-[14px] text-muted">{ locale.t('contract.unnamed') }</span> }>
                                <span class="hash min-w-0 flex-1 text-[14px]">
                                    <span class="font-semibold">{ call.name }</span>(<span class="text-muted">{ call.args.map((arg) => (arg.name === '' ? arg.type : `${ arg.type } ${ arg.name }`)).join(', ') }</span>)
                                </span>
                            </Show>
                        </p>
                        <Show when={ call.args.length > 0 }>
                            <dl class="divide-y divide-line border-t border-line">
                                <For each={ rows(call.args) } key={ (arg) => String(arg.at) } let={ arg }>
                                    <div class="flex flex-col gap-1 px-4 py-2.5 sm:flex-row sm:items-baseline sm:gap-x-3">
                                        <dt class="text-[13px] text-muted sm:w-48 sm:shrink-0">
                                            <span class="data"><Show when={ arg.name !== '' }><span class="text-text">{ arg.name }</span> </Show>{ arg.type }</span>
                                        </dt>
                                        <dd class="min-w-0 text-[14px] sm:flex-1">
                                            {/* Capped on a wrapper, not on the `amount` inside it:
                                                a `bytes` argument can be kilobytes, and `amount`
                                                on a block would pin it to the wrong edge in RTL. */}
                                            {/* A `string` is whatever its sender typed, in any
                                                script: it takes the reader's font and its own
                                                direction, where every other type is chain data in
                                                the monospace isolate. */}
                                            <Show
                                                when={ arg.type === 'address' }
                                                fallback={
                                                    <div class="max-h-48 overflow-y-auto">
                                                        <Show when={ arg.type.startsWith('string') } fallback={ <span class="amount">{ arg.value }</span> }>
                                                            <bdi class="break-words">{ arg.value }</bdi>
                                                        </Show>
                                                    </div>
                                                }
                                            >
                                                <HashLink value={ arg.value } to={ `/address/${ arg.value }` } lead={ 16 } tail={ 10 } copy />
                                            </Show>
                                        </dd>
                                    </div>
                                </For>
                            </dl>
                        </Show>
                        <details class="border-t border-line">
                            <summary class="cursor-pointer px-4 py-3 text-[13px] text-muted transition-colors duration-150 marker:text-nur hover:text-text">
                                { locale.t('tx.input.raw') }
                            </summary>
                            <pre class="hash max-h-80 overflow-y-auto whitespace-pre-wrap px-4 pb-3 text-[12px] leading-relaxed text-muted">{ call.data }</pre>
                        </details>
                    </section>
                </Show>

                <Show when={ shown.total > 0 }>
                    <section class="panel overflow-hidden">
                        <h2 class="border-b border-line px-4 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                            { locale.t('tx.transfers', { count: locale.n(shown.total) }) }
                        </h2>
                        <ul class="divide-y divide-line">
                            <For each={ shown.transfers } key={ (row) => `${ row.txHash }-${ row.logIndex }` } let={ row }>
                            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
                                    <Icon name="token" size={ 16 } class="text-nur" />
                                    <div class="min-w-0 flex-1 text-[13px] text-muted">
                                        <HashLink value={ row.from } to={ `/address/${ row.from }` } tone="muted" lead={ 8 } tail={ 6 } />
                                        <span class="icon-flip mx-1.5 inline-block">&rarr;</span>
                                        <HashLink value={ row.to } to={ `/address/${ row.to }` } tone="muted" lead={ 8 } tail={ 6 } />
                                    </div>
                                    <p class="amount text-[14px] font-semibold">
                                        { formatAmount(row.value, row.tokenDecimals) }
                                        <span class="ms-1.5 text-muted">{ row.tokenSymbol === '' ? locale.t('tx.token') : row.tokenSymbol }</span>
                                    </p>
                                </li>
                            </For>
                        </ul>
                        <Show when={ shown.pages > 1 }>
                            <div class="border-t border-line">
                                <Pagination page={ shown.page } pages={ shown.pages } onChange={ (next) => page = next } />
                            </div>
                        </Show>
                    </section>
                </Show>
            </div>
        </Show>
    </div>
}
