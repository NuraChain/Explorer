import { client, type TxStatusFilter } from '../api.ts';
import { formatValue } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Badge from '../components/ui/badge.component.azeroth';
import HashLink from '../components/chain/hash-link.component.azeroth';
import FilterGroup from '../components/ui/filter-group.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';

export default component TransactionsPage()
{
    const locale = useLocale();

    state page = 1;
    state status: TxStatusFilter = 'all';

    resource stats = () => client.stats.summary();
    // Both in the source key, because they are one question: page 4 of the reverted transactions
    // is a different list from page 4 of all of them, and a resource keyed on the page alone
    // would serve the second while the control said the first.
    resource txs = (key: string) =>
    {
        const [at = '1', narrowed = 'all'] = key.split('|');
        return client.txs.list({ query: { page: Number(at), limit: 25, status: narrowed as TxStatusFilter } });
    } with { source: `${ page }|${ status }` };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    // Back to the first page, always: page 7 of everything is usually past the end of one status,
    // and landing on a blank list reads as a filter that found nothing rather than one that moved.
    const narrow = (next: string): void =>
    {
        status = next as TxStatusFilter;
        page = 1;
    };

    useTitle(() => locale.t('txs.title'));

    <div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-[22px] font-bold tracking-tight">{ locale.t('txs.title') }</h1>
            <FilterGroup
                label={ locale.t('filter.status') }
                name="tx-status"
                value={ status }
                options={ [
                    { value: 'all', label: locale.t('filter.all') },
                    { value: 'success', label: locale.t('filter.status.success') },
                    { value: 'reverted', label: locale.t('filter.status.reverted') }
                ] }
                onChange={ narrow }
            />
        </div>

        <section class="panel overflow-hidden">
            <ul class="divide-y divide-line">
                <For each={ txs.data()?.rows ?? [] } key={ (row) => row.hash } let={ row }>
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-3 sm:gap-x-4 sm:px-4">
                        <Badge
                            tone={ row.status === 'reverted' ? 'danger' : row.status === 'unknown' ? 'neutral' : 'success' }
                            icon={ row.status === 'reverted' ? 'alert' : 'success' }
                        >
                            { locale.t(`chain.status.${ row.status }`) }
                        </Badge>
                        <div class="min-w-0 flex-1">
                            <HashLink value={ row.hash } to={ `/tx/${ row.hash }` } lead={ 12 } tail={ 6 } class="text-[13px]" />
                            {/* The pair the same way the address ledger draws it: a HashLink
                                each, so the whole value is one hover away and the counterparty is
                                one click away. Copy is off on both - the row already carries one
                                copy button, and three of them turn a list into a toolbar.

                                Six and four, not the eight and six the address ledger uses: this
                                row also carries a status badge, and in a language whose word for
                                "reverted" is a third of a phone's width there is not room for two
                                fifteen-character values. The whole address is still one hover and
                                one click away. */}
                            <p class="flex flex-wrap items-center gap-x-1.5 text-[11px] sm:text-[12px] text-muted">
                                <HashLink value={ row.from } to={ `/address/${ row.from }` } tone="muted" lead={ 5 } tail={ 3 } copy={ false } class="text-[11px] sm:text-[12px]" />
                                {/* The arrow travels WITH the address it points at. On a phone the
                                    pair is wider than the column holding it, and left loose the
                                    arrow wrapped onto a line of its own pointing at nothing. */}
                                <span class="inline-flex items-center gap-1.5">
                                    <span class="icon-flip inline-block">&rarr;</span>
                                    <Show when={ row.to } fallback={ <span>{ locale.t('chain.contractCreation') }</span> } let={ to }>
                                        <HashLink value={ to } to={ `/address/${ to }` } tone="muted" lead={ 5 } tail={ 3 } copy={ false } class="text-[11px] sm:text-[12px]" />
                                    </Show>
                                </span>
                            </p>
                        </div>
                        <div class="min-w-0 max-w-[50%] text-end">
                            <p class="amount text-[13px] sm:text-[14px]">{ formatValue(row.value, symbol, decimals) }</p>
                            <Tooltip label={ locale.dateTime(row.at) } class="flex justify-center"><p class="text-[11px] sm:text-[12px] text-muted">{ locale.ago(row.at) }</p></Tooltip>
                        </div>
                    </li>
                </For>
            </ul>
            <Show when={ txs.data() === undefined }>
                <div class="flex flex-col gap-2 px-4 py-4"><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /></div>
            </Show>
            {/* Two empty states, because they are two different facts. "Nothing indexed yet"
                under an active filter tells a reader the chain is empty when what is empty is
                their own narrowing of it. */}
            <Show when={ txs.data()?.rows.length === 0 }>
                <Show
                    when={ status === 'all' }
                    fallback={ <EmptyState icon="filter" title={ locale.t('txs.empty.filtered.title') } hint={ locale.t('txs.empty.filtered.hint') } /> }
                >
                    <EmptyState icon="activity" title={ locale.t('txs.empty.title') } hint={ locale.t('txs.empty.hint') } />
                </Show>
            </Show>
            <Show when={ txs.data() !== undefined }>
            { () => <Pagination page={ txs.data()!.page } pages={ txs.data()!.pages } onChange={ (next) => page = next } /> }
            </Show>
        </section>

        {/* The count follows the filter: with one on, `total` is what MATCHED, and calling that
            "indexed" would misreport the size of the index every time somebody narrowed it. */}
        <Show when={ txs.data() !== undefined }>
        { () => <p class="text-[13px] text-muted">{ locale.t(status === 'all' ? 'txs.total' : 'txs.total.filtered', { count: locale.n(txs.data()!.total) }) }</p> }
        </Show>
    </div>
}
