import { client } from '../api.ts';
import { formatValue, shortHash } from '../lib/format.ts';
import { useTitle } from '../lib/title.ts';
import { useLocale } from '../stores/locale.store.ts';

import Badge from '../components/ui/badge.component.azeroth';
import HashLink from '../components/chain/hash-link.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Tooltip from '../components/ui/tooltip.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';

export default component TransactionsPage()
{
    const locale = useLocale();

    state page = 1;

    resource stats = () => client.stats.summary();
    resource txs = (at: string) => client.txs.list({ query: { page: Number(at), limit: 25 } })
        with { source: String(page) };

    derived symbol = stats.data()?.chain.symbol ?? '';
    derived decimals = stats.data()?.chain.decimals ?? 18;

    useTitle(() => locale.t('txs.title'));

    <div class="flex flex-col gap-4">
        <h1 class="text-[22px] font-bold tracking-tight">{ locale.t('txs.title') }</h1>

        <section class="panel overflow-hidden">
            <ul class="divide-y divide-line">
                <For each={ txs.data()?.rows ?? [] } key={ (row) => row.hash } let={ row }>
                    <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-3 sm:gap-x-4 sm:px-4">
                        <Badge
                            tone={ row.status === 'reverted' ? 'danger' : row.status === 'unknown' ? 'neutral' : 'success' }
                            icon={ row.status === 'reverted' ? 'alert' : 'success' }
                        >
                            { locale.t(`chain.status.${ row.status }`) }
                        </Badge>
                        <div class="min-w-0 flex-1">
                            <HashLink value={ row.hash } to={ `/tx/${ row.hash }` } lead={ 14 } tail={ 8 } />
                            <p class="text-[12px] text-muted">
                                { shortHash(row.from, 8, 6) } <span class="icon-flip inline-block">&rarr;</span> { row.to === null ? locale.t('chain.contractCreation') : shortHash(row.to, 8, 6) }
                            </p>
                        </div>
                        <div class="min-w-0 max-w-[45%] text-end">
                            <p class="amount text-[14px]">{ formatValue(row.value, symbol, decimals) }</p>
                            <Tooltip label={ locale.dateTime(row.at) } class="flex justify-center"><p class="text-[12px] text-muted">{ locale.ago(row.at) }</p></Tooltip>
                        </div>
                    </li>
                </For>
            </ul>
            <Show when={ txs.data() === undefined }>
                <div class="flex flex-col gap-2 px-4 py-4"><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /><Skeleton class="h-10 w-full" /></div>
            </Show>
            <Show when={ txs.data()?.rows.length === 0 }>
                <EmptyState icon="activity" title={ locale.t('txs.empty.title') } hint={ locale.t('txs.empty.hint') } />
            </Show>
            <Show when={ txs.data() !== undefined }>
            { () => <Pagination page={ txs.data()!.page } pages={ txs.data()!.pages } onChange={ (next) => page = next } /> }
            </Show>
        </section>

        <Show when={ txs.data() !== undefined }>
        { () => <p class="text-[13px] text-muted">{ locale.t('txs.total', { count: locale.n(txs.data()!.total) }) }</p> }
        </Show>
    </div>
}
