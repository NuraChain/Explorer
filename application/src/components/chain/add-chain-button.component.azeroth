import type { ChainInfo } from '../../api.ts';

import { useToasts } from '../../stores/toasts.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';
import type { AddChainOutcome } from '../../stores/wallet.store.ts';

import Button from '../ui/button.component.azeroth';
import WalletPicker from './wallet-picker.component.azeroth';

// "Put this chain in my wallet." The values come from the SAME /stats payload the header reads,
// so the network a visitor adds is by construction the one this explorer is indexing - a
// hard-coded RPC URL here would quietly send wallets to a different node than the pages describe.
//
// It asks WHICH wallet first, even where only one is installed. The alternative is a button that
// silently picks for the reader, and with a roster of three there is no honest way to guess which
// of them a person meant. The dialog is also the only place a visitor with none of them installed
// is told what this explorer works with.
//
// EIP-3085 (`wallet_addEthereumChain`) is what every injected wallet implements, and the call
// itself lives in the wallet store with every other one - see stores/wallet.store.ts.

/** What each outcome says, and how loudly. A dismissal is not a failure and must not read as one. */
const OUTCOME: Record<AddChainOutcome, { tone: 'success' | 'info' | 'error'; key: 'wallet.added' | 'wallet.dismissed' | 'wallet.mismatch' | 'wallet.refused'; icon: 'check' | 'x' | 'alert' }> = {
    added: { tone: 'success', key: 'wallet.added', icon: 'check' },
    dismissed: { tone: 'info', key: 'wallet.dismissed', icon: 'x' },
    mismatch: { tone: 'error', key: 'wallet.mismatch', icon: 'alert' },
    refused: { tone: 'error', key: 'wallet.refused', icon: 'alert' }
};

export default component AddChainButton(props: { chain: ChainInfo | null })
{
    const toasts = useToasts();
    const locale = useLocale();
    const wallet = useWallet();

    state busy = false;
    state picking = false;

    // Null until the overview's first payload lands. The button waits rather than the page
    // waiting for the button - a control that is rebuilt whenever the chain description is
    // re-read loses whatever the reader was in the middle of. See the note in pages/home.
    derived label = props.chain === null
        ? ''
        : locale.t('wallet.add', { chain: locale.chainName(props.chain.name) });

    // A BOOLEAN and not the `props.chain !== null` test written inline below, because a derived
    // only notifies when its value actually changes. The overview re-reads the chain every five
    // seconds and hands back a fresh object each time; tested inline, that rebuilds the button on
    // every poll, and a rebuilt button is one the dialog can no longer return focus to.
    derived ready = props.chain !== null;

    const add = async (rdns: string): Promise<void> =>
    {
        const chain = props.chain;
        if (chain === null)
        {
            return;
        }
        busy = true;
        try
        {
            const said = OUTCOME[await wallet.addChain(rdns, chain)];
            toasts.push(said.tone, locale.t(said.key, { chain: locale.chainName(chain.name) }), said.icon);
        }
        finally
        {
            busy = false;
        }
    };

    <span class="inline-flex">
        <Show when={ ready }>
            <Button
                variant="outline"
                size="md"
                icon="wallet"
                busy={ busy }
                onClick={ () => picking = true }
            >
                { label }
            </Button>
        </Show>

        <WalletPicker
            open={ picking }
            title={ label }
            onPick={ (rdns) => void add(rdns) }
            onClose={ () => picking = false }
        />
    </span>
}
