import type { GovParams, Tally } from '../../api.ts';
import { formatAmount } from '../../lib/format.ts';
import { majority, ratio, share, totalCast, vetoShare } from '../../lib/governance.ts';

import { useLocale } from '../../stores/locale.store.ts';

import Tooltip from '../ui/tooltip.component.azeroth';

// The four ways this chain's governance counts a vote, drawn as shares of what was cast.
//
// Deliberately NOT in inflow/outflow. Those two colours answer where value went, and a vote is not
// a movement of value - spending them here would make the one functional pair in this palette mean
// two different things on two different pages. Yes takes the accent and the other three take the
// neutral steps below it, with every row carrying its own label and figure, so the colour is never
// what the reading depends on.

/** The options in the module's own order, each with the bar it draws. */
const SIDES = [
    { key: 'yes', bar: 'bg-nur' },
    { key: 'abstain', bar: 'bg-faint' },
    { key: 'no', bar: 'bg-muted' },
    { key: 'noWithVeto', bar: 'bg-line' }
] as const;

export default component VoteTally(props: {
    tally: Tally;

    /** The staking denom's decimals - the chain's own, since governance is counted in it. */
    decimals?: number;
    symbol?: string;

    /** What passing turns on. Given, the panel says how the vote stands against it. */
    params?: GovParams;

    /** One slim track, no labels: the shape a list row has room for. */
    compact?: boolean;
})
{
    const locale = useLocale();

    derived cast = totalCast(props.tally);

    derived rows = SIDES.map((side) => ({
        key: side.key,
        bar: side.bar,
        value: props.tally[side.key]
    })).map((side) => ({ ...side, percent: share(BigInt(side.value), cast) }));

    /** The sentence a screen reader is given, and the bubble a pointer gets. The same one. */
    derived summary = rows
        .map((row) => `${ locale.t(`governance.option.${ row.key }`) } ${ locale.t('governance.share', { percent: locale.n(row.percent, 1) }) }`)
        .join(' · ');

    const weight = (value: string): string =>
        `${ formatAmount(value, props.decimals ?? 18) }${ props.symbol === undefined || props.symbol === '' ? '' : ` ${ props.symbol }` }`;

    <Show
        when={ props.compact === true }
        fallback={
            <div class="flex flex-col gap-3">
                <For each={ rows } key={ (row) => row.key } let={ row }>
                    <div class="flex flex-col gap-1.5">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                            <span class="flex items-center gap-2 text-[13px]">
                                <span class={ `h-2 w-2 shrink-0 rounded-full ${ row.bar }` } aria-hidden="true"></span>
                                { locale.t(`governance.option.${ row.key }`) }
                            </span>
                            <span class="text-[13px] text-muted">
                                <span class="amount me-2 text-text">{ weight(row.value) }</span>
                                <span class="tabular-nums">{ locale.t('governance.share', { percent: locale.n(row.percent, 1) }) }</span>
                            </span>
                        </div>
                        <span class="flex h-1.5 w-full overflow-hidden rounded-full bg-raised">
                            <span class={ `h-full ${ row.bar }` } style={ `width: ${ Math.min(row.percent, 100) }%` }></span>
                        </span>
                    </div>
                </For>

                {/* What passing turns on, where the module has told us.

                    Turnout is missing on purpose: quorum is measured against the whole bonded
                    supply, which `x/gov` does not report through this precompile, and a bar drawn
                    against a number nobody gave us would be an invented reading. The two the tally
                    CAN answer are here - the majority among the votes that decided, and the veto
                    share of everything cast. */}
                <Show when={ props.params !== undefined }>
                { () =>
                    <div class="flex flex-col gap-1.5 border-t border-line pt-2.5 text-[12px] text-muted">
                        <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                            <span>{ locale.t('governance.majority') }</span>
                            <span class="tabular-nums">
                                { locale.t('governance.against.threshold', {
                                    share: locale.n(majority(props.tally), 1),
                                    needed: locale.n(ratio(props.params!.threshold), 1)
                                }) }
                            </span>
                        </p>
                        <p class="flex flex-wrap items-baseline justify-between gap-x-3">
                            <span>{ locale.t('governance.veto') }</span>
                            <span class="tabular-nums">
                                { locale.t('governance.against.threshold', {
                                    share: locale.n(vetoShare(props.tally), 1),
                                    needed: locale.n(ratio(props.params!.vetoThreshold), 1)
                                }) }
                            </span>
                        </p>
                        <p class="text-faint">
                            { locale.t('governance.quorum.note', { percent: locale.n(ratio(props.params!.quorum), 1) }) }
                        </p>
                    </div>
                }
                </Show>
            </div>
        }
    >
        {/* Compact: one track, four segments. `role="img"` with the same sentence the bubble
            carries, because the bubble says nothing to a reader who is not pointing at it. */}
        <Tooltip label={ summary } class="flex w-full">
            <span class="flex h-1.5 w-full overflow-hidden rounded-full bg-raised" role="img" aria-label={ summary }>
                <For each={ rows } key={ (row) => row.key } let={ row }>
                    <span class={ `h-full ${ row.bar }` } style={ `width: ${ row.percent }%` }></span>
                </For>
            </span>
        </Tooltip>
    </Show>
}
