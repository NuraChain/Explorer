import { client, type ChainInfo, type ProposalDetail, type VoteOption } from '../../api.ts';
import { formatAmount, parseAmount } from '../../lib/format.ts';
import { VOTE_CODE, VOTE_OPTIONS } from '../../lib/governance.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';

import Icon from '../../icons/icon.component.azeroth';

import WalletConnect from './wallet-connect.component.azeroth';
import Button from '../ui/button.component.azeroth';
import FilterGroup from '../ui/filter-group.component.azeroth';
import Input from '../ui/input.component.azeroth';

// Taking part in a vote, from a browser.
//
// The chain's governance is a Cosmos module, and none of it is reachable from an EVM wallet by
// itself - what makes this page more than a viewer is the gov PRECOMPILE: a fixed address that
// turns `MsgVote` and `MsgDeposit` into ordinary EVM transactions. So a reader votes with the same
// wallet they send NURA with, and this explorer's part ends where it always does: it encodes the
// calldata, hands it over, and the wallet asks its owner.
//
// The three controls map one to one onto the module's own messages. Nothing is offered that the
// proposal's state cannot take: a deposit while it is still collecting one, a vote while the vote
// is open, and a withdrawal only to the account that made the proposal.

export default component ProposalActions(props: {
    detail: ProposalDetail;
    chain: ChainInfo;

    /** Called once a transaction is in the wallet's hands, so the page can watch for its effect. */
    onSent?: () => void;
})
{
    const locale = useLocale();
    const toasts = useToasts();
    const wallet = useWallet();

    state choice: VoteOption = 'yes';
    state reason = '';
    state amount = '';
    state busy = '';
    state failure = '';

    derived proposal = props.detail.proposal;
    derived ready = wallet.account() !== '' && wallet.chainId() === props.chain.chainId;
    derived votable = proposal.status === 'voting';
    derived depositable = proposal.status === 'deposit';
    derived mine = wallet.account().toLowerCase() === proposal.proposer.toLowerCase();

    /** The denom governance is counted in - the chain's own, as the module's minimum deposit names it. */
    derived denom = props.detail.params.minDeposit[0]?.denom ?? '';

    /** A coin list, in the positional JSON the encoder reads a `(string,uint256)[]` from. */
    const coins = (base: string): string => JSON.stringify([[denom, base]]);

    /**
     * Encode, hand to the wallet, and say what happened.
     *
     * Every one of these carries no value: a deposit is an argument to the message, not currency
     * attached to the transaction, and a page that quietly sent NURA alongside would be the worst
     * kind of helpful.
     */
    const send = async (kind: string, selector: string, args: string[]): Promise<void> =>
    {
        failure = '';
        busy = kind;
        try
        {
            const { data } = await client.address.calldata({
                params: { address: props.detail.precompile },
                input: { selector, args }
            });
            await wallet.send({ to: props.detail.precompile, data, value: '0' });
            toasts.push('success', locale.t('governance.act.sent'), 'send');
            props.onSent?.();
        }
        catch (error)
        {
            const message = error instanceof Error ? error.message : String(error);
            // 4001 is "the person said no" in every injected wallet, and a refusal is not a fault.
            failure = message.includes('4001') || message.toLowerCase().includes('rejected')
                ? locale.t('wallet.dismissed')
                : message;
        }
        finally
        {
            busy = '';
        }
    };

    const castVote = (): void =>
    {
        void send('vote', props.detail.calls.vote, [
            wallet.account(),
            proposal.id,
            String(VOTE_CODE[choice]),
            reason
        ]);
    };

    const deposit = (): void =>
    {
        const base = parseAmount(amount, props.chain.decimals);
        if (base === null || base === '0')
        {
            failure = locale.t('governance.act.badAmount');
            return;
        }
        void send('deposit', props.detail.calls.deposit, [wallet.account(), proposal.id, coins(base)]);
    };

    <section class="panel flex flex-col gap-4 px-4 py-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-[14px] font-semibold uppercase tracking-[0.14em] text-muted">
                { locale.t('governance.act.title') }
            </h2>
            <WalletConnect chain={ props.chain } compact />
        </div>

        <Show
            when={ ready }
            fallback={ <p class="text-[13px] text-muted">{ locale.t('governance.act.connect') }</p> }
        >
            <Show when={ votable }>
                <div class="flex flex-col gap-3">
                    <FilterGroup
                        label={ locale.t('governance.act.vote') }
                        name="vote-option"
                        value={ choice }
                        options={ VOTE_OPTIONS.map((option) => ({
                            value: option,
                            label: locale.t(`governance.option.${ option }`)
                        })) }
                        onChange={ (next) => choice = next as VoteOption }
                    />

                    <Input
                        label={ locale.t('governance.act.reason') }
                        placeholder={ locale.t('governance.act.reason.placeholder') }
                        size="sm"
                        value={ reason }
                        onInput={ (value) => reason = value }
                    />

                    <div>
                        <Button variant="primary" icon="vote" busy={ busy === 'vote' } onClick={ castVote }>
                            { locale.t('governance.act.submit') }
                        </Button>
                    </div>
                </div>
            </Show>

            {/* A proposal in its deposit period is not being voted on yet - it is waiting for the
                stake that puts it to a vote, and anybody may add it. */}
            <Show when={ depositable }>
                <div class="flex flex-col gap-2">
                    <p class="text-[13px] text-muted">
                        { locale.t('governance.act.deposit.hint', {
                            amount: `${ formatAmount(props.detail.params.minDeposit[0]?.amount ?? '0', props.chain.decimals) } ${ props.chain.symbol }`
                        }) }
                    </p>
                    <div class="flex flex-wrap items-end gap-2">
                        <div class="min-w-[12rem] flex-1">
                            <Input
                                label={ locale.t('governance.act.deposit') }
                                placeholder={ props.chain.symbol }
                                size="sm"
                                value={ amount }
                                onInput={ (value) => amount = value }
                            />
                        </div>
                        <Button variant="primary" icon="wallet" busy={ busy === 'deposit' } onClick={ deposit }>
                            { locale.t('governance.act.deposit.submit') }
                        </Button>
                    </div>
                </div>
            </Show>

            {/* Only to the account that made it, and only while it can still be withdrawn. The
                module refuses anybody else, and offering a button that will be refused is worse
                than not offering it. */}
            <Show when={ mine && (votable || depositable) }>
                <div class="flex flex-col gap-2 border-t border-line pt-4">
                    <p class="text-[13px] text-muted">{ locale.t('governance.act.cancel.hint') }</p>
                    <div>
                        <Button
                            variant="outline"
                            icon="x"
                            busy={ busy === 'cancel' }
                            onClick={ () => void send('cancel', props.detail.calls.cancelProposal, [wallet.account(), proposal.id]) }
                        >
                            { locale.t('governance.act.cancel') }
                        </Button>
                    </div>
                </div>
            </Show>
        </Show>

        <Show when={ failure !== '' }>
            <p class="flex items-start gap-2 rounded-lg border border-outflow bg-raised px-3 py-2 text-[13px] text-outflow">
                <Icon name="alert" size={ 15 } class="mt-0.5 shrink-0" />
                { failure }
            </p>
        </Show>
    </section>
}
