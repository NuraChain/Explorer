import { Link } from 'azerothjs';

import type { ChainInfo, ContractDetail, ContractSource } from '../../api.ts';

import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

import Icon from '../../icons/icon.component.azeroth';

import ContractCall from './contract-call.component.azeroth';
import HashLink from './hash-link.component.azeroth';
import WalletConnect from './wallet-connect.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';

// What a deployed contract is, for a reader who has only its address.
//
// This panel has two moods, and the line at the top says which one it is in. Without published
// source, everything here is read from the bytecode the chain returns: `transfer(address,uint256)`
// is named because its selector is a published constant, while `0x7c88e3d9` is printed as four
// bytes because nobody has published what it means. Both are shown. Only one is named.
//
// With published source that this explorer RECOMPILED to the same bytes, that ceases to be the
// situation: the names are the author's own, every selector has one, and the panel says so with
// the same prominence it otherwise uses to admit the opposite. What it does not do is blur the
// two - a verified badge is a claim about bytes, and the page states which bytes it checked.
//
// A named function can also be CALLED, which is the other half of this panel: the ones that only
// read are answered through this explorer's node, and the ones that write are handed to the
// reader's own wallet. Those two live in separate sections for the same reason they are described
// differently - one is free and one spends money.
export default component ContractPanel(props: {
    detail: ContractDetail;
    chain: ChainInfo;

    /** The published source, once the page has fetched it. Absent while it is still in flight. */
    source?: ContractSource;
})
{
    const locale = useLocale();
    const toasts = useToasts();

    state showBytecode = false;

    derived named = props.detail.functions.filter((entry) => entry.signature !== '').length;
    derived readable = props.detail.functions.filter((entry) =>
        entry.signature !== '' && (entry.mutability === 'view' || entry.mutability === 'pure'));
    derived writable = props.detail.functions.filter((entry) =>
        entry.signature !== '' && (entry.mutability === 'nonpayable' || entry.mutability === 'payable'));
    derived unnamed = props.detail.functions.filter((entry) => entry.signature === '');

    derived verified = props.detail.verified;
    derived files = props.source?.verified === true ? props.source.files : [];

    /** One copier for every button on this panel - each of them puts text on a clipboard. */
    const copy = async (value: string): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(value);
            toasts.push('success', locale.t('copy.done'), 'check');
        }
        catch
        {
            toasts.push('error', locale.t('copy.blocked'), 'alert');
        }
    };

    <div class="flex flex-col gap-4">
        {/* Said first, not last, either way. A reader who thinks they are looking at verified
            source trusts the unnamed selectors less than they should; a reader who does not know
            the source WAS checked reads the author's own names as somebody's guess. */}
        <Show
            when={ verified }
            fallback={
                <p class="flex flex-wrap items-start gap-2 rounded-lg border border-line bg-raised px-4 py-3 text-[12px] text-muted">
                    <Icon name="help" size={ 14 } class="mt-0.5 shrink-0" />
                    <span class="min-w-0 flex-1">{ locale.t('contract.notice') }</span>
                    {/* The way out of that state, next to the statement of it. Anyone may take
                        it: a submission is accepted only if it reproduces these exact bytes. */}
                    <Link
                        to={ `/verify/${ props.detail.address }` }
                        class="shrink-0 font-semibold text-beam no-underline hover:underline"
                    >
                        { locale.t('verify.cta') }
                    </Link>
                </p>
            }
            let={ mark }
        >
            <div class="flex flex-col gap-1.5 rounded-lg border border-inflow bg-raised px-4 py-3">
                <p class="flex flex-wrap items-center gap-2 text-[13px] font-semibold text-inflow">
                    <Icon name="verified" size={ 15 } class="shrink-0" />
                    { locale.t(mark.match === 'full' ? 'contract.verified.full' : 'contract.verified.partial') }
                </p>
                <p class="text-[12px] text-muted">
                    { locale.t('contract.verified.detail', { name: mark.name, compiler: mark.compiler }) }
                    <Tooltip label={ locale.dateTime(mark.at) } class="ms-1.5 inline-flex">
                        <span>&middot; { locale.ago(mark.at) }</span>
                    </Tooltip>
                </p>
                {/* A partial match proves the CODE and nothing about the comments around it. That
                    is a smaller claim, and it is the one being made. */}
                <Show when={ mark.match === 'partial' }>
                    <p class="text-[12px] text-muted">{ locale.t('contract.verified.partial.hint') }</p>
                </Show>
                {/* The source belongs to the implementation, not to the address in the URL. The
                    functions below come from there too, so the two facts belong together. */}
                <Show when={ mark.viaImplementation }>
                    <p class="text-[12px] text-muted">{ locale.t('contract.verified.viaImplementation') }</p>
                </Show>
            </div>
        </Show>

        <dl class="panel divide-y divide-line">
            <Show when={ props.detail.compiler !== '' }>
                <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                    <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.compiler') }</dt>
                    <dd class="data flex-1 text-[13px]">solc { props.detail.compiler }</dd>
                </div>
            </Show>
            <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.size') }</dt>
                <dd class="flex-1 text-[13px]"><span class="amount">{ locale.bytes(props.detail.codeSize) }</span></dd>
            </div>
            <Show when={ props.detail.creation } let={ creation }>
                <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                    <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.deployer') }</dt>
                    <dd class="min-w-0 flex-1">
                        <HashLink value={ creation.deployer } to={ `/address/${ creation.deployer }` } lead={ 16 } tail={ 10 } />
                    </dd>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                    <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.deployedAt') }</dt>
                    <dd class="min-w-0 flex-1 text-[13px]">
                        <Link to={ `/block/${ creation.blockNumber }` } class="data text-beam no-underline hover:underline">
                            #{ creation.blockNumber }
                        </Link>
                        <Tooltip label={ locale.dateTime(creation.at) } class="ms-2 inline-flex">
                            <span class="text-[12px] text-muted">{ locale.ago(creation.at) }</span>
                        </Tooltip>
                        <span class="ms-2 inline-flex align-middle">
                            <HashLink value={ creation.txHash } to={ `/tx/${ creation.txHash }` } tone="muted" lead={ 8 } tail={ 6 } copy={ false } />
                        </span>
                    </dd>
                </div>
            </Show>
            <Show when={ props.detail.proxy } let={ proxy }>
                <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                    {/* The EIP number is an identifier, so it stays as it is written everywhere
                        else - translating it would make the page disagree with the standard. */}
                    <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.proxy') }</dt>
                    <dd class="min-w-0 flex-1 text-[13px]">
                        <span class="data text-[12px] uppercase text-muted">{ proxy.kind }</span>
                        <span class="ms-2 inline-flex align-middle">
                            <HashLink value={ proxy.implementation } to={ `/address/${ proxy.implementation }` } lead={ 16 } tail={ 10 } />
                        </span>
                    </dd>
                </div>
            </Show>
            <Show when={ props.detail.metadataUri !== '' }>
                <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-3">
                    <dt class="w-32 shrink-0 text-[12px] text-muted">{ locale.t('contract.metadata') }</dt>
                    <dd class="hash min-w-0 flex-1 text-[12px] text-muted">{ props.detail.metadataUri }</dd>
                </div>
            </Show>
        </dl>

        <Show when={ props.detail.standards.length > 0 }>
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-[12px] uppercase tracking-[0.14em] text-muted">{ locale.t('contract.standards') }</span>
                <For each={ props.detail.standards } key={ (entry) => String(entry) } let={ entry }>
                    <span class="inline-flex"><Badge tone="accent">{ entry }</Badge></span>
                </For>
            </div>
        </Show>

        {/* Live, from the node, on every load. These are the answers the contract gives RIGHT
            NOW - a cached total supply is a wrong total supply. */}
        <Show when={ props.detail.reads.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex items-center gap-2 border-b border-line px-4 py-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                    <Icon name="layers" size={ 14 } /> { locale.t('contract.reads') }
                </h2>
                <dl class="divide-y divide-line">
                    <For each={ props.detail.reads } key={ (row) => row.signature } let={ row }>
                        <div class="flex flex-wrap items-baseline gap-x-3 px-4 py-2.5">
                            <dt class="data w-40 shrink-0 text-[12px] text-muted">{ row.name }()</dt>
                            <dd class="min-w-0 flex-1 text-[13px]"><span class="amount">{ row.value }</span></dd>
                        </div>
                    </For>
                </dl>
            </section>
        </Show>

        {/* Read and write are separate sections, not one list with a badge. A `view` costs
            nothing and is answered by this explorer's node; everything in the second section
            needs a signature, a fee and a wallet - and nobody should discover that difference
            by pressing the wrong button in a uniform list. */}
        <Show when={ readable.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line px-4 py-3">
                    <span class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="run" size={ 14 } /> { locale.t('contract.read') }
                    </span>
                    <span class="text-[12px] text-muted">{ locale.t('contract.read.hint') }</span>
                </h2>
                <ul class="max-h-[30rem] overflow-y-auto">
                    <For each={ readable } key={ (row) => row.selector } let={ row }>
                        <li class="border-b border-line last:border-b-0">
                            <ContractCall address={ props.detail.address } entry={ row } chain={ props.chain } />
                        </li>
                    </For>
                </ul>
            </section>
        </Show>

        <Show when={ writable.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-3">
                    <span class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="send" size={ 14 } /> { locale.t('contract.write') }
                    </span>
                    {/* The wallet control sits at the TOP of the section it applies to, so the
                        state of the connection is visible before a row is ever opened. */}
                    <WalletConnect chain={ props.chain } compact />
                </h2>
                <p class="border-b border-line px-4 py-2.5 text-[12px] text-muted">{ locale.t('contract.write.hint') }</p>
                <ul class="max-h-[30rem] overflow-y-auto">
                    <For each={ writable } key={ (row) => row.selector } let={ row }>
                        <li class="border-b border-line last:border-b-0">
                            <ContractCall address={ props.detail.address } entry={ row } chain={ props.chain } />
                        </li>
                    </For>
                </ul>
            </section>
        </Show>

        {/* Listed but not callable, and the difference is the honest part: without a signature
            there is no way to know what arguments these take. Their COUNT is the measure of what
            this page does not know about the contract. */}
        <Show when={ unnamed.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line px-4 py-3">
                    <span class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="help" size={ 14 } /> { locale.t('contract.unnamedGroup') }
                    </span>
                    <span class="text-[12px] text-muted">
                        { locale.t('contract.functions.named', { named: locale.n(named), total: locale.n(props.detail.functions.length) }) }
                    </span>
                </h2>
                <ul class="divide-y divide-line">
                    <For each={ unnamed } key={ (row) => row.selector } let={ row }>
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
                            <span class="data w-24 shrink-0 text-[12px] text-muted">{ row.selector }</span>
                            <span class="min-w-0 flex-1 text-[13px] italic text-muted">{ locale.t('contract.unnamed') }</span>
                        </li>
                    </For>
                </ul>
            </section>
        </Show>

        <Show when={ props.detail.functions.length === 0 }>
            <section class="panel overflow-hidden">
                <EmptyState icon="contract" title={ locale.t('contract.functions.empty.title') } hint={ locale.t('contract.functions.empty.hint') } />
            </section>
        </Show>

        <Show when={ props.detail.fromImplementation }>
            <p class="px-1 text-[12px] text-muted">{ locale.t('contract.viaImplementation') }</p>
        </Show>

        <Show when={ props.detail.events.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex items-center gap-2 border-b border-line px-4 py-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                    <Icon name="activity" size={ 14 } /> { locale.t('contract.events') }
                </h2>
                <ul class="divide-y divide-line">
                    <For each={ props.detail.events } key={ (row) => row.topic } let={ row }>
                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5">
                            <span class="hash min-w-0 flex-1 text-[13px]">
                                <span class="font-semibold">{ row.name }</span>(<span class="text-muted">{ row.inputs.join(', ') }</span>)
                            </span>
                            <HashLink value={ row.topic } tone="muted" lead={ 10 } tail={ 6 } copy={ false } />
                        </li>
                    </For>
                </ul>
            </section>
        </Show>

        {/* The source itself, at the bottom with the bytecode rather than at the top with the
            summary: this is the raw material a reader drops into when something above surprised
            them, and it is measured in screens rather than in lines. */}
        <Show when={ files.length > 0 }>
            <section class="panel overflow-hidden">
                <h2 class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-3">
                    <span class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                        <Icon name="contract" size={ 14 } /> { locale.t('contract.source') }
                    </span>
                    <span class="flex flex-wrap items-center gap-2 text-[12px] text-muted">
                        <Show when={ props.source?.license !== undefined && props.source.license !== '' }>
                            <span>{ props.source?.license }</span>
                        </Show>
                        <span>
                            { props.source?.optimizer === true
                                ? locale.t('contract.source.optimized', { runs: locale.n(props.source.runs) })
                                : locale.t('contract.source.unoptimized') }
                        </span>
                        <button
                            class="cursor-pointer rounded-lg border border-line px-3 py-1 text-[12px] text-muted transition-colors duration-150 hover:text-text"
                            type="button"
                            onClick={ () => void copy(props.source?.abi ?? '') }
                        >
                            { locale.t('contract.source.copyAbi') }
                        </button>
                    </span>
                </h2>
                <For each={ files } key={ (file) => file.path } let={ file }>
                    <div class="border-b border-line last:border-b-0">
                        <div class="flex flex-wrap items-center justify-between gap-2 bg-raised px-4 py-2">
                            <span class="data min-w-0 flex-1 break-all text-[12px] text-muted">{ file.path }</span>
                            <button
                                class="flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted transition-colors duration-150 hover:text-nur"
                                type="button"
                                aria-label={ locale.t('copy.action', { value: file.path }) }
                                onClick={ () => void copy(file.content) }
                            >
                                <Icon name="copy" size={ 13 } />
                            </button>
                        </div>
                        {/* `whitespace-pre` and its own scroller: source is written to a column
                            width, and re-wrapping it destroys the indentation that carries the
                            structure. The overflow is contained here so the page never slides. */}
                        <pre class="data max-h-[32rem] overflow-auto whitespace-pre px-4 py-3 text-[12px] leading-relaxed">{ file.content }</pre>
                    </div>
                </For>
            </section>
        </Show>

        <section class="panel overflow-hidden">
            <h2 class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-4 py-3">
                <span class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
                    <Icon name="hash" size={ 14 } /> { locale.t('contract.bytecode') }
                </span>
                <span class="flex items-center gap-1">
                    <button
                        class="cursor-pointer rounded-lg border border-line px-3 py-1 text-[12px] text-muted transition-colors duration-150 hover:text-text"
                        type="button"
                        aria-expanded={ showBytecode }
                        onClick={ () => showBytecode = !showBytecode }
                    >
                        { showBytecode ? locale.t('contract.bytecode.hide') : locale.t('contract.bytecode.show') }
                    </button>
                    <button
                        class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-md text-muted transition-colors duration-150 hover:text-nur"
                        type="button"
                        aria-label={ locale.t('copy.action', { value: locale.t('contract.bytecode') }) }
                        onClick={ () => void copy(props.detail.bytecode) }
                    >
                        <Icon name="copy" size={ 13 } />
                    </button>
                </span>
            </h2>
            {/* Collapsed by default. This is up to 24KB of hex - printing it unasked pushes every
                readable thing on the page off the screen. */}
            <Show when={ showBytecode }>
                {/* `whitespace-pre-wrap` because a <pre> otherwise holds 13000 characters on one
                    line, and the horizontal scrollbar that follows drags the whole page sideways.
                    `hash` lets it break between characters - it is hex, so every point is one. */}
                <pre class="hash max-h-80 overflow-y-auto whitespace-pre-wrap px-4 py-3 text-[11px] leading-relaxed text-muted">{ props.detail.bytecode }</pre>
            </Show>
        </section>
    </div>
}
