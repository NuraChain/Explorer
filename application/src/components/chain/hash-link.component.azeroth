import { Link } from 'azerothjs';

import { shortHash } from '../../lib/format.ts';

import { useToasts } from '../../stores/toasts.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';

import Tooltip from '../ui/tooltip.component.azeroth';

// A hash or address, everywhere it appears: shortened, monospace, and copyable. The full value is
// one hover away, so following a link to read a string is never necessary.
//
// Copy is ON by default. A truncated hash a reader cannot retrieve is worse than no hash, and
// every place one appears is a place someone wants to paste it somewhere else.
export default component HashLink(props: {
    value: string;
    to?: string;
    lead?: number;
    tail?: number;
    tone?: 'beam' | 'muted' | 'text';
    copy?: boolean;

    /**
     * Print the value WHOLE. For the line that IDENTIFIES a page: there the address is the
     * heading, and a shortened second copy of it in the same panel says the same thing twice.
     */
    full?: boolean;

    /** Type for the value itself. The default is the 13px it takes inline, in a row or a list. */
    class?: string;
})
{
    const toasts = useToasts();
    const locale = useLocale();

    derived tone = props.tone ?? 'beam';
    derived short = props.full === true ? props.value : shortHash(props.value, props.lead ?? 10, props.tail ?? 8);
    derived colour = tone === 'beam' ? 'text-beam' : tone === 'muted' ? 'text-muted' : 'text-text';

    // `hash` rather than `data` when whole: forty-two characters have to be allowed to wrap between
    // characters or they leave the panel, and a value shortened to fit never needs to.
    derived face = `${ props.full === true ? 'hash' : 'data' } ${ props.class ?? 'text-[13px]' } ${ colour }`;

    // The confirmation is the toast, not a glyph swap on the button: a check that appears where
    // the cursor already is says nothing a reader will notice, and the toast is where every other
    // confirmation in the app already speaks.
    const write = async (): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(props.value);
            toasts.push('success', locale.t('copy.done'), 'check');
        }
        catch
        {
            toasts.push('error', locale.t('copy.blocked'), 'alert');
        }
    };

    <span class="inline-flex items-center gap-1.5">
        {/* No bubble around a value printed whole - the tooltip here exists for what this
            component truncates, and one repeating a string already on the screen is noise. */}
        <Show
            when={ props.full === true }
            fallback={
                <Tooltip label={ props.value }>
                    <Show
                        when={ props.to !== undefined }
                        fallback={ <span class={ face }>{ short }</span> }
                    >
                        <Link to={ props.to ?? '/' } class={ `${ face } no-underline hover:underline` }>
                            { short }
                        </Link>
                    </Show>
                </Tooltip>
            }
        >
            <Show
                when={ props.to !== undefined }
                fallback={ <span class={ face }>{ short }</span> }
            >
                <Link to={ props.to ?? '/' } class={ `${ face } no-underline hover:underline` }>
                    { short }
                </Link>
            </Show>
        </Show>
        <Show when={ props.copy !== false }>
            <button
                class="-m-2 flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-md text-muted transition-colors duration-150 hover:text-nur sm:-m-1 sm:h-7 sm:w-7"
                type="button"
                aria-label={ locale.t('copy.action', { value: props.value }) }
                onClick={ () => void write() }
            >
                <Icon name="copy" size={ 13 } />
            </button>
        </Show>
    </span>
}
