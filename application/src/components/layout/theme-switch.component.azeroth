import { useTheme, THEMES, THEME_LABEL, type Theme } from '../../stores/theme.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

// Both choices stay visible as a segmented control rather than one button that swaps meaning:
// a toggle whose icon changes has to be read before it can be used.
export default component ThemeSwitch(props: { labelled?: boolean })
{
    const theme = useTheme();
    const locale = useLocale();

    const iconFor = (name: Theme): IconName => `theme-${ name }` as IconName;

    <div class={ `flex items-center gap-0.5 rounded-lg border border-line bg-field p-0.5 ${ props.labelled === true ? 'w-full' : '' }` } role="group" aria-label={ locale.t('theme.label') }>
        <For each={ THEMES } key={ (name) => name } let={ name }>
            <button
                class={ [
                    'flex items-center justify-center gap-2 rounded-md transition-colors duration-150',
                    props.labelled === true ? 'h-9 flex-1 text-[15px]' : 'h-7 w-7',
                    theme.theme() === name ? 'cursor-default bg-raised text-nur' : 'cursor-pointer text-muted hover:text-text'
                ].join(' ') }
                type="button"
                title={ locale.t(THEME_LABEL[name]) }
                aria-label={ locale.t(THEME_LABEL[name]) }
                aria-pressed={ theme.theme() === name }
                onClick={ () => theme.setTheme(name) }
            >
                <Icon name={ iconFor(name) } size={ 16 } />
                <Show when={ props.labelled === true }>
                    <span>{ locale.t(THEME_LABEL[name]) }</span>
                </Show>
            </button>
        </For>
    </div>
}
