import { Link } from 'azerothjs';

import { useLocale } from '../../stores/locale.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import { APP_VERSION } from '../../version.ts';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import BrandMark from './brand-mark.component.azeroth';

// The sections, in the order the header names them, with Governance among them and Staking not:
// the header row holds five links and Staking took the fifth (see App.azeroth), so Governance is
// reachable from here instead. Docs is last and ONLY here - a page of prose is what a footer is
// for.
// Not ReadonlyArray: `<For each>` takes a mutable array, and a readonly one will not assign.
const SECTIONS: Array<{ key: MessageKey; to: string; icon: IconName }> = [
    { key: 'nav.home', to: '/', icon: 'home' },
    { key: 'nav.blocks', to: '/blocks', icon: 'block' },
    { key: 'nav.transactions', to: '/txs', icon: 'transaction' },
    { key: 'nav.governance', to: '/governance', icon: 'vote' },
    { key: 'nav.charts', to: '/charts', icon: 'chart' },
    { key: 'docs.title', to: '/docs', icon: 'docs' }
];

// Where the PROJECT lives, which is why these are hardcoded: they belong to the explorer itself,
// not to whichever network a deployment is pointed at, so they do not move when RPC_URL does.
const SOCIALS: Array<{ name: string; href: string; icon: IconName }> = [
    { name: 'X', href: 'https://x.com/nurachainnet', icon: 'social-x' },
    { name: 'GitHub', href: 'https://github.com/NuraChain/Explorer', icon: 'social-github' },
    { name: 'Discord', href: 'https://discord.gg/8BMAXTdXQg', icon: 'social-discord' },
    { name: 'Telegram', href: 'https://t.me/nurachain', icon: 'social-telegram' },
    { name: 'Instagram', href: 'https://www.instagram.com/nura.chain/', icon: 'social-instagram' }
];

// The footer says what this explorer IS and where its project can be reached - the questions a
// visitor who arrived from a shared link cannot answer from the page they landed on. It reads
// nothing from the chain: the header already carries the live state, and a second copy down here
// only added a request per page.
//
// The redesign drops the panel tiles the previous footer boxed its columns in: a footer reads
// best as one quiet floor, not as objects sitting on it. A gradient hairline in the accent
// (fading out to the reader's right, like light leaving the page) replaces the plain border-t at
// the top, and every column sits directly on the raised ground. The brand column carries the
// identity and the social glyphs; Explore lays its six links out as a compact grid; Community
// names the same five networks in text, at EVERY width - one social representation per surface,
// glyphs beside the brand and names in their own column, instead of the old arrangement that
// hid the named list on large screens and let the icon row stand alone.
export default component SiteFooter()
{
    const locale = useLocale();

    <footer class="mt-12 bg-raised">
        {/* The accent hairline. A footer that only draws a line across the page reads as the
            page trailing off; a lit edge closes the document the way the header opens it. */}
        <div class="h-px w-full bg-gradient-to-r from-nur/60 via-nur/20 to-transparent" role="presentation" />

        <div class="mx-auto grid max-w-page grid-cols-1 gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.4fr_1.7fr_1fr] lg:gap-12 lg:px-8">
            <div>
                <span class="flex items-center gap-2.5">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-nur text-void shadow-[0_0_18px_-4px] shadow-nur/60">
                        <Icon name="layers" size={ 17 } />
                    </span>
                    <BrandMark class="text-[16px]" />
                </span>
                <p class="mt-3 max-w-sm text-[13px] leading-relaxed text-muted">{ locale.t('footer.tagline') }</p>

                {/* Icons alone: five named rows repeated what a glyph already says, and the
                    named column further along the row already carries the names. Each control
                    keeps its name in `aria-label`, and the outlined muted box is the
                    overlay-close recipe the rest of the app uses - hover lifts the border to
                    the accent before the glyph does. */}
                <ul class="mt-5 flex flex-wrap items-center gap-2">
                    <For each={ SOCIALS } key={ (link) => link.name } let={ link }>
                        <li>
                            <a
                                class="flex h-9 w-9 items-center justify-center rounded-lg border border-line text-muted no-underline transition-colors duration-150 hover:border-nur hover:text-nur"
                                href={ link.href }
                                target="_blank"
                                rel="noreferrer"
                                aria-label={ link.name }
                            >
                                <Icon name={ link.icon } size={ 18 } />
                            </a>
                        </li>
                    </For>
                </ul>

                {/* Said twice, shown once: this column and the baseline bar are separate
                    containers either side of a full-width rule, so no layout can carry one node
                    from here to there. From `lg:` the bar's copy takes over. */}
                <p class="mt-5 text-[12px] text-faint lg:hidden">
                    { locale.t('footer.version') }{ ' ' }<span class="data">{ APP_VERSION }</span>
                </p>
            </div>

            {/* Six links on one grid, two per row on a phone and three across from `sm:` - the
                list is short enough that a reader scans it as a block rather than trailing down
                it, which is what the old stretched single-tile layout made them do. */}
            <nav aria-label={ locale.t('footer.explore') }>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.explore') }</h2>
                <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-[14px] sm:grid-cols-3 lg:gap-y-3.5">
                    <For each={ SECTIONS } key={ (section) => section.to } let={ section }>
                        <li>
                            <Link
                                class="group flex w-fit items-center gap-2.5 text-muted no-underline transition-colors duration-150 hover:text-text"
                                to={ section.to }
                            >
                                <Icon name={ section.icon } size={ 15 } class="text-faint transition-colors duration-150 group-hover:text-nur" />
                                { locale.t(section.key) }
                            </Link>
                        </li>
                    </For>
                </ul>
            </nav>

            {/* Named in text beside the glyph, not by logo alone: the icon set carries no brand
                marks, and a generic glyph plus a name reads correctly in either direction. This
                column shows at every width - the icon row beside the brand is for the reader
                who scans for shapes, this one for the reader who scans for words, and hiding
                either copy of the same five links was saving nothing. */}
            <nav aria-label={ locale.t('footer.community') }>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.community') }</h2>
                <ul class="mt-4 flex flex-col gap-3 text-[14px] lg:gap-3.5">
                    <For each={ SOCIALS } key={ (link) => link.name } let={ link }>
                        <li>
                            <a
                                class="group flex w-fit items-center gap-2.5 text-muted no-underline transition-colors duration-150 hover:text-text"
                                href={ link.href }
                                target="_blank"
                                rel="noreferrer"
                            >
                                <Icon name={ link.icon } size={ 16 } class="text-faint transition-colors duration-150 group-hover:text-nur" />
                                { link.name }
                            </a>
                        </li>
                    </For>
                </ul>
            </nav>
        </div>

        <div class="border-t border-line">
            <div class="mx-auto flex max-w-page flex-col gap-2 px-4 py-4 text-[13px] text-faint sm:flex-row sm:items-center sm:justify-between sm:gap-x-6 sm:px-6 lg:px-8">
                {/* `me-auto` outranks the row's `justify-between`: the note keeps its own edge and
                    the two facts about the build sit together at the far one. */}
                <p class="lg:me-auto">{ locale.t('footer.note') }</p>
                <p class="hidden lg:block">
                    { locale.t('footer.version') }{ ' ' }<span class="data">{ APP_VERSION }</span>
                </p>
                <p>
                    {/* Explicit: a literal text line before an element line collapses to a single
                        space, but an expression container does not, so the words would run together. */}
                    { locale.t('footer.builtWith') }{ ' ' }
                    <a
                        class="text-muted no-underline transition-colors duration-150 hover:text-nur"
                        href="https://github.com/AzerothJS/AzerothJS"
                        target="_blank"
                        rel="noreferrer"
                    >AzerothJS</a>
                </p>
            </div>
        </div>
    </footer>
}
