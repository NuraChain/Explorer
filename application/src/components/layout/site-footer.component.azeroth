import { Link } from 'azerothjs';

import { client } from '../../api.ts';

import { useLocale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';

// The footer says what this explorer IS and what chain it is pointed at - the two questions a
// visitor who arrived from a shared link cannot answer from the page they landed on. The chain
// row is live rather than hardcoded, so repointing the deployment at another network does not
// leave the footer lying about which chain these numbers came from.
export default component SiteFooter()
{
    const locale = useLocale();

    resource stats = () => client.stats.summary();

    <footer class="mt-12 border-t border-line">
        <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-3 sm:px-6">
            <div>
                <span class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-md bg-nur text-void">
                        <Icon name="layers" size={ 14 } />
                    </span>
                    <span class="text-[14px] font-bold tracking-tight">Nura <span class="text-nur">Explorer</span></span>
                </span>
                <p class="mt-2 max-w-xs text-[12px] leading-relaxed text-muted">{ locale.t('footer.tagline') }</p>
            </div>

            <nav aria-label={ locale.t('footer.explore') }>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.explore') }</h2>
                <ul class="mt-3 flex flex-col gap-2 text-[13px]">
                    <li><Link to="/" class="text-muted no-underline hover:text-text">{ locale.t('nav.home') }</Link></li>
                    <li><Link to="/blocks" class="text-muted no-underline hover:text-text">{ locale.t('nav.blocks') }</Link></li>
                    <li><Link to="/txs" class="text-muted no-underline hover:text-text">{ locale.t('nav.transactions') }</Link></li>
                </ul>
            </nav>

            <div>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.network') }</h2>
                <Show
                    when={ stats.data() }
                    fallback={ <p class="mt-3 text-[13px] text-muted">{ locale.t('footer.connecting') }</p> }
                >
                { (summary) =>
                    <dl class="mt-3 flex flex-col gap-1.5 text-[13px]">
                        <div class="flex justify-between gap-3">
                            <dt class="text-muted">{ locale.t('footer.chain') }</dt>
                            {/* Linked only when the deployment named a site. Without the guard a
                                repointed explorer would send readers to the wrong chain's page. */}
                            <dd class="font-semibold">
                                <Show
                                    when={ summary().chain.siteUrl !== '' }
                                    fallback={ <span>{ summary().chain.name }</span> }
                                >
                                    <a
                                        class="no-underline transition-colors duration-150 hover:text-nur"
                                        href={ summary().chain.siteUrl }
                                        target="_blank"
                                        rel="noreferrer"
                                    >{ summary().chain.name }</a>
                                </Show>
                            </dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-muted">{ locale.t('footer.chainId') }</dt>
                            <dd class="data">{ summary().chain.chainId }</dd>
                        </div>
                    </dl>
                }
                </Show>
            </div>
        </div>

        <div class="border-t border-line">
            <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 text-[12px] text-faint sm:px-6">
                <p>{ locale.t('footer.note') }</p>
                <p class="shrink-0">
                    {/* Explicit: a literal text line before an element line collapses to a single
                        space, but an expression container does not, so the words would run together. */}
                    { locale.t('footer.builtWith') }{ ' ' }
                    <a
                        class="text-muted no-underline transition-colors duration-150 hover:text-nur"
                        href="https://github.com/AzerothJS/AzerothJS"
                        target="_blank"
                        rel="noreferrer"
                    >AzerothJS</a>
                </p>
            </div>
        </div>
    </footer>
}
