import { Link } from 'azerothjs';

import { useLocale } from '../../stores/locale.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import { APP_VERSION } from '../../version.ts';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import BrandMark from './brand-mark.component.azeroth';

// The sections, in the order the header names them, with Governance among them and Staking not:
// the header row holds five links at 1024px and Staking took the fifth (see App.azeroth), so
// Governance is reachable from here instead. Docs is last and ONLY here - a page of prose is what
// a footer is for.
// Not ReadonlyArray: `<For each>` takes a mutable array, and a readonly one will not assign.
const SECTIONS: Array<{ key: MessageKey; to: string; icon: IconName }> = [
    { key: 'nav.home', to: '/', icon: 'home' },
    { key: 'nav.blocks', to: '/blocks', icon: 'block' },
    { key: 'nav.transactions', to: '/txs', icon: 'transaction' },
    { key: 'nav.governance', to: '/governance', icon: 'vote' },
    { key: 'nav.charts', to: '/charts', icon: 'chart' },
    { key: 'docs.title', to: '/docs', icon: 'docs' }
];

// Where the PROJECT lives, which is why these are hardcoded: they belong to the explorer itself,
// not to whichever network a deployment is pointed at, so they do not move when RPC_URL does.
const SOCIALS: Array<{ name: string; href: string; icon: IconName }> = [
    { name: 'X', href: 'https://x.com/nurachainnet', icon: 'social-x' },
    { name: 'GitHub', href: 'https://github.com/NuraChain/Explorer', icon: 'social-github' },
    { name: 'Discord', href: 'https://discord.gg/8BMAXTdXQg', icon: 'social-discord' },
    { name: 'Telegram', href: 'https://t.me/nurachain', icon: 'social-telegram' },
    { name: 'Instagram', href: 'https://www.instagram.com/nura.chain/', icon: 'social-instagram' }
];

// The footer says what this explorer IS and where its project can be reached - the questions a
// visitor who arrived from a shared link cannot answer from the page they landed on. It reads
// nothing from the chain: the header already carries the live state, and a second copy down here
// only added a request per page.
export default component SiteFooter()
{
    const locale = useLocale();

    <footer class="mt-12 border-t border-line">
        <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-3 sm:px-6">
            <div>
                <span class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-md bg-nur text-void">
                        <Icon name="layers" size={ 15 } />
                    </span>
                    <BrandMark class="text-[15px]" />
                </span>
                <p class="mt-2 max-w-xs text-[13px] leading-relaxed text-muted">{ locale.t('footer.tagline') }</p>
                <p class="mt-1 text-[12px] text-muted">
                    { locale.t('footer.version') }{ ' ' }<span class="data">{ APP_VERSION }</span>
                </p>
            </div>

            <nav class="text-center" aria-label={ locale.t('footer.explore') }>
                <h2 class="text-[13px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.explore') }</h2>
                {/* Two columns, like the Community list: six links down a single one left this
                    column taller than the two beside it, and paired they end level. */}
                <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-[14px]">
                    <For each={ SECTIONS } key={ (section) => section.to } let={ section }>
                        <li>
                            {/* `w-fit` keeps the hover target on the words, so centring takes an
                                explicit `mx-auto` - the column's `text-center` cannot move a
                                block-level flex row. */}
                            <Link
                                class="mx-auto flex w-fit items-center gap-2 text-muted no-underline transition-colors duration-150 hover:text-text"
                                to={ section.to }
                            >
                                <Icon name={ section.icon } size={ 16 } />
                                { locale.t(section.key) }
                            </Link>
                        </li>
                    </For>
                </ul>
            </nav>

            {/* Named in text, not by logo alone: the icon set carries no brand marks, and a
                generic glyph beside a name still reads correctly in either direction. */}
            <nav class="text-center" aria-label={ locale.t('footer.community') }>
                <h2 class="text-[13px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.community') }</h2>
                <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-[14px]">
                    <For each={ SOCIALS } key={ (link) => link.name } let={ link }>
                        <li>
                            {/* `w-fit` keeps the hover target on the words, so centring takes an
                                explicit `mx-auto` - the column's `text-center` cannot move a
                                block-level flex row. */}
                            <a
                                class="mx-auto flex w-fit items-center gap-2 text-muted no-underline transition-colors duration-150 hover:text-text"
                                href={ link.href }
                                target="_blank"
                                rel="noreferrer"
                            >
                                <Icon name={ link.icon } size={ 18 } />
                                { link.name }
                            </a>
                        </li>
                    </For>
                </ul>
            </nav>
        </div>

        <div class="border-t border-line">
            <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 text-[13px] text-faint sm:px-6">
                <p>{ locale.t('footer.note') }</p>
                <p>
                    {/* Explicit: a literal text line before an element line collapses to a single
                        space, but an expression container does not, so the words would run together. */}
                    { locale.t('footer.builtWith') }{ ' ' }
                    <a
                        class="text-muted no-underline transition-colors duration-150 hover:text-nur"
                        href="https://github.com/AzerothJS/AzerothJS"
                        target="_blank"
                        rel="noreferrer"
                    >AzerothJS</a>
                </p>
            </div>
        </div>
    </footer>
}
