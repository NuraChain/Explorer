import { Link } from 'azerothjs';

import { useLocale } from '../../stores/locale.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import { APP_VERSION } from '../../version.ts';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

import BrandMark from './brand-mark.component.azeroth';

// The sections, in the order the header names them, with Governance among them and Staking not:
// the header row holds five links at 1024px and Staking took the fifth (see App.azeroth), so
// Governance is reachable from here instead. Docs is last and ONLY here - a page of prose is what
// a footer is for.
// Not ReadonlyArray: `<For each>` takes a mutable array, and a readonly one will not assign.
const SECTIONS: Array<{ key: MessageKey; to: string; icon: IconName }> = [
    { key: 'nav.home', to: '/', icon: 'home' },
    { key: 'nav.blocks', to: '/blocks', icon: 'block' },
    { key: 'nav.transactions', to: '/txs', icon: 'transaction' },
    { key: 'nav.governance', to: '/governance', icon: 'vote' },
    { key: 'nav.charts', to: '/charts', icon: 'chart' },
    { key: 'docs.title', to: '/docs', icon: 'docs' }
];

// Where the PROJECT lives, which is why these are hardcoded: they belong to the explorer itself,
// not to whichever network a deployment is pointed at, so they do not move when RPC_URL does.
const SOCIALS: Array<{ name: string; href: string; icon: IconName }> = [
    { name: 'X', href: 'https://x.com/nurachainnet', icon: 'social-x' },
    { name: 'GitHub', href: 'https://github.com/NuraChain/Explorer', icon: 'social-github' },
    { name: 'Discord', href: 'https://discord.gg/8BMAXTdXQg', icon: 'social-discord' },
    { name: 'Telegram', href: 'https://t.me/nurachain', icon: 'social-telegram' },
    { name: 'Instagram', href: 'https://www.instagram.com/nura.chain/', icon: 'social-instagram' }
];

// The footer says what this explorer IS and where its project can be reached - the questions a
// visitor who arrived from a shared link cannot answer from the page they landed on. It reads
// nothing from the chain: the header already carries the live state, and a second copy down here
// only added a request per page.
//
// A RAISED band (`bg-raised`) rather than bare void: a footer that only draws a line across the
// page reads as the page trailing off, while a surface the eye can see as a floor closes the
// document the way the header opens it. The Explore and Community columns sit on `panel` tiles so
// the three columns read as three objects on one floor instead of text floating in the dark; on a
// phone the grid is one column and the tiles stack in reading order - brand, sections, community.
export default component SiteFooter()
{
    const locale = useLocale();

    <footer class="mt-12 border-t border-line bg-raised">
        <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 sm:py-12 lg:grid-cols-[1.2fr_1fr_1fr]">
            <div>
                <span class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-md bg-nur text-void">
                        <Icon name="layers" size={ 15 } />
                    </span>
                    <BrandMark class="text-[15px]" />
                </span>
                <p class="mt-2.5 max-w-xs text-[13px] leading-relaxed text-muted">{ locale.t('footer.tagline') }</p>

                {/* Icons alone: five named rows repeated what a glyph already says and doubled
                    the column the two navs own. Each control carries its name in `aria-label`,
                    and the outlined muted box is the overlay-close recipe the rest of the app
                    uses - hover lifts the border to the accent before the glyph does. */}
                <ul class="mt-4 flex flex-wrap items-center gap-2">
                    <For each={ SOCIALS } key={ (link) => link.name } let={ link }>
                        <li>
                            <a
                                class="flex h-9 w-9 items-center justify-center rounded-lg border border-line text-muted no-underline transition-colors duration-150 hover:border-nur hover:text-nur"
                                href={ link.href }
                                target="_blank"
                                rel="noreferrer"
                                aria-label={ link.name }
                            >
                                <Icon name={ link.icon } size={ 18 } />
                            </a>
                        </li>
                    </For>
                </ul>

                <p class="mt-4 text-[12px] text-faint">
                    { locale.t('footer.version') }{ ' ' }<span class="data">{ APP_VERSION }</span>
                </p>
            </div>

            {/* `panel` on the nav itself: the heading and its list are one object, and a tile
                keeps them from reading as a loose list floating beside the brand column. */}
            <nav class="panel self-start p-4 sm:p-5" aria-label={ locale.t('footer.explore') }>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.explore') }</h2>
                <ul class="mt-3 flex flex-col gap-2.5 text-[14px]">
                    <For each={ SECTIONS } key={ (section) => section.to } let={ section }>
                        <li>
                            <Link
                                class="flex w-fit items-center gap-2.5 text-muted no-underline transition-colors duration-150 hover:text-text"
                                to={ section.to }
                            >
                                <Icon name={ section.icon } size={ 15 } class="text-faint" />
                                { locale.t(section.key) }
                            </Link>
                        </li>
                    </For>
                </ul>
            </nav>

            {/* Named in text beside the glyph, not by logo alone: the icon set carries no brand
                marks, and a generic glyph plus a name reads correctly in either direction - the
                socials themselves went to icon buttons, where the name is the label and one row
                of five stays one row on a phone. */}
            <nav class="panel self-start p-4 sm:p-5" aria-label={ locale.t('footer.community') }>
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.14em] text-faint">{ locale.t('footer.community') }</h2>
                <ul class="mt-3 flex flex-col gap-2.5 text-[14px]">
                    <For each={ SOCIALS } key={ (link) => link.name } let={ link }>
                        <li>
                            <a
                                class="flex w-fit items-center gap-2.5 text-muted no-underline transition-colors duration-150 hover:text-text"
                                href={ link.href }
                                target="_blank"
                                rel="noreferrer"
                            >
                                <Icon name={ link.icon } size={ 16 } class="text-faint" />
                                { link.name }
                            </a>
                        </li>
                    </For>
                </ul>
            </nav>
        </div>

        <div class="border-t border-line">
            <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-4 text-[13px] text-faint sm:flex-row sm:items-center sm:justify-between sm:gap-x-6 sm:px-6">
                <p>{ locale.t('footer.note') }</p>
                <p>
                    {/* Explicit: a literal text line before an element line collapses to a single
                        space, but an expression container does not, so the words would run together. */}
                    { locale.t('footer.builtWith') }{ ' ' }
                    <a
                        class="text-muted no-underline transition-colors duration-150 hover:text-nur"
                        href="https://github.com/AzerothJS/AzerothJS"
                        target="_blank"
                        rel="noreferrer"
                    >AzerothJS</a>
                </p>
            </div>
        </div>
    </footer>
}
