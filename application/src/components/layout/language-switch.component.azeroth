import { useLocale, LOCALES, LOCALE_LABEL, LOCALE_TAG } from '../../stores/locale.store.ts';

// The language control, built like ThemeSwitch: both choices visible as a segmented control
// rather than one button that swaps meaning. Two languages fit; a third would want a menu.
//
// Each option is labelled in its OWN language and carries `lang`, so the browser picks the right
// font for it and a screen reader does not read "فارسی" with an English voice.
export default component LanguageSwitch(props: { labelled?: boolean })
{
    const locale = useLocale();

    <div
        class={ `flex items-center gap-0.5 rounded-lg border border-line bg-field p-0.5 ${ props.labelled === true ? 'w-full' : '' }` }
        role="group"
        aria-label={ locale.t('language.label') }
    >
        <For each={ LOCALES } key={ (name) => name } let={ name }>
            <button
                class={ [
                    'flex cursor-pointer items-center justify-center rounded-md px-2 transition-colors duration-150',
                    props.labelled === true ? 'h-9 flex-1 text-[14px]' : 'h-7 text-[12px] font-semibold',
                    locale.locale() === name ? 'bg-raised text-nur' : 'text-muted hover:text-text'
                ].join(' ') }
                type="button"
                lang={ LOCALE_TAG[name] }
                title={ LOCALE_LABEL[name] }
                aria-label={ LOCALE_LABEL[name] }
                aria-pressed={ locale.locale() === name }
                onClick={ () => locale.setLocale(name) }
            >
                { LOCALE_LABEL[name] }
            </button>
        </For>
    </div>
}
