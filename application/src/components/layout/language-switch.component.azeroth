import { onMount, Portal } from 'azerothjs';

import { useLocale, LOCALES, LOCALE_LABEL, LOCALE_TAG, type Locale } from '../../stores/locale.store.ts';
import { lockBodyScroll, unlockBodyScroll } from '../../lib/body-lock.ts';

import Icon from '../../icons/icon.component.azeroth';
import Flag from '../../icons/flag.component.azeroth';

// The language control: a button wearing the current flag, opening a dialog where every
// language shows its flag beside its own name. A native <select> cannot draw SVG inside an
// <option>, so the picker is built here - portaled and `fixed` like NavDrawer's sheet, so the
// header's backdrop-filter cannot trap it, with a scrim underneath so tapping anywhere beside
// it closes it, and centered on the viewport so it reads as a dialog rather than a menu.
//
// Each option carries `lang`, so the browser picks the right font for it and a screen reader
// does not read "فارسی" with an English voice. The flag for each language is the region already
// chosen in LOCALE_TAG - see ../../icons/flags.ts.
export default component LanguageSwitch(props: { labelled?: boolean })
{
    const locale = useLocale();

    state open = false;

    let trigger: HTMLButtonElement | null = null;
    let panel: HTMLElement | null = null;

    const close = (): void =>
    {
        open = false;
    };

    const choose = (name: Locale): void =>
    {
        locale.setLocale(name);
        close();
        trigger?.focus();
    };

    // Escape closes and focus goes back to the control that opened it.
    onMount(() =>
    {
        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape' && open)
            {
                close();
                trigger?.focus();
            }
        };
        document.addEventListener('keydown', onKey);
        return () => document.removeEventListener('keydown', onKey);
    });

    // Focus moves into the dialog on the current language, so ArrowDown from there reads the
    // list in order. rAF because the portal has not painted when the effect runs. The body is
    // locked behind the dialog, as behind the drawer - the counter in body-lock keeps the two
    // from fighting when the dialog opens on top of the sheet.
    effect (open)
    {
        if (open)
        {
            lockBodyScroll();
            if (typeof requestAnimationFrame !== 'undefined')
            {
                requestAnimationFrame(() =>
                {
                    const selected = panel?.querySelector<HTMLButtonElement>('[aria-selected="true"]');
                    selected?.focus();
                });
            }
        }
        else
        {
            unlockBodyScroll();
        }
    }

    /** Arrow keys walk the grid: vertical moves a column (±2 rows of the two-column grid),
        horizontal moves within a row (±1) and flips with the writing direction - in RTL the
        physical Right key heads toward the previous option. Both wrap at the ends. */
    const moveFocus = (delta: number): void =>
    {
        if (panel === null)
        {
            return;
        }
        const options = Array.from(panel.querySelectorAll<HTMLButtonElement>('[role="option"]'));
        const index = options.indexOf(document.activeElement as HTMLButtonElement);
        const next = index === -1 ? (delta > 0 ? 0 : options.length - 1) : (index + delta + options.length) % options.length;
        options[next]?.focus();
    };

    <span class={ props.labelled === true ? 'block w-full' : 'inline-flex' }>
        <button
            class={ [
                'flex cursor-pointer items-center rounded-lg border border-line bg-field text-text transition-colors duration-150 hover:border-nur',
                props.labelled === true ? 'h-10 w-full gap-2.5 px-3 text-[15px]' : 'h-8 gap-2 px-2.5 text-[13px] font-semibold'
            ].join(' ') }
            type="button"
            aria-label={ locale.t('language.label') }
            aria-haspopup="dialog"
            aria-expanded={ open }
            lang={ LOCALE_TAG[locale.locale()] }
            ref={ (element) => trigger = element }
            onClick={ () => open = true }
        >
            <Flag locale={ locale.locale() } />
            { LOCALE_LABEL[locale.locale()] }
            <Icon name="chevron-down" size={ 15 } class={ `text-muted ${ props.labelled === true ? 'ms-auto' : '' }` } />
        </button>

        <Show when={ open }>
            {/* One root under the Portal, as in NavDrawer - Portal mounts a single node. The
                container owns the viewport: the scrim covers it and the dialog sits centered
                above it, `relative` so the scrim behind it stays a clickable backdrop. */}
            <Portal>
                <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
                    {/* The scrim is the dismiss target, exactly as in NavDrawer. */}
                    <button
                        class="absolute inset-0 h-full w-full cursor-default border-0 bg-void/70 p-0 backdrop-blur-sm motion-safe:animate-fade"
                        type="button"
                        aria-label={ locale.t('nav.close') }
                        onClick={ close }
                    ></button>

                    <div
                        class="relative flex max-h-[min(28rem,calc(100dvh-2rem))] w-full max-w-sm flex-col rounded-xl border border-line bg-field p-4 shadow-2xl motion-safe:animate-fade"
                        role="dialog"
                        aria-modal="true"
                        aria-label={ locale.t('language.label') }
                        ref={ (element) => panel = element }
                        onKeyDown={ (event) =>
                        {
                            const key = (event as KeyboardEvent).key;
                            const horizontal = locale.dir() === 'rtl' ? -1 : 1;
                            if (key === 'ArrowDown') { event.preventDefault(); moveFocus(2); }
                            else if (key === 'ArrowUp') { event.preventDefault(); moveFocus(-2); }
                            else if (key === 'ArrowRight') { event.preventDefault(); moveFocus(horizontal); }
                            else if (key === 'ArrowLeft') { event.preventDefault(); moveFocus(-horizontal); }
                        } }
                    >
                        <div class="mb-1 flex shrink-0 items-center justify-between gap-2">
                            <h2 class="text-[15px] font-semibold text-text">{ locale.t('language.label') }</h2>
                            <button
                                class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-muted transition-colors duration-150 hover:text-text"
                                type="button"
                                aria-label={ locale.t('nav.close') }
                                onClick={ close }
                            >
                                <Icon name="x" size={ 18 } />
                            </button>
                        </div>

                        <div class="grid grid-cols-2 gap-1 overflow-y-auto" role="listbox" aria-label={ locale.t('language.label') }>
                            <For each={ LOCALES } key={ (name) => name } let={ name }>
                                <button
                                    class={ [
                                        'flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-[14px] transition-colors duration-150',
                                        locale.locale() === name ? 'bg-raised text-nur' : 'text-muted hover:bg-raised hover:text-text'
                                    ].join(' ') }
                                    type="button"
                                    role="option"
                                    aria-selected={ locale.locale() === name }
                                    lang={ LOCALE_TAG[name] }
                                    onClick={ () => choose(name) }
                                >
                                    <Flag locale={ name } />
                                    { LOCALE_LABEL[name] }
                                </button>
                            </For>
                        </div>
                    </div>
                </div>
            </Portal>
        </Show>
    </span>
}
