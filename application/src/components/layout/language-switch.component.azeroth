import { onMount, Portal } from 'azerothjs';

import { useLocale, LOCALES, LOCALE_LABEL, LOCALE_TAG, type Locale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';
import Flag from '../../icons/flag.component.azeroth';

// The language control: a button wearing the current flag, opening a listbox where every
// language shows its flag beside its own name. A native <select> cannot draw SVG inside an
// <option>, so the menu is built here - portaled and `fixed` like Tooltip's bubble, because
// rendered in place it would be clipped by the sticky header, and with a scrim underneath like
// NavDrawer's sheet, so tapping anywhere beside it closes it.
//
// Each option carries `lang`, so the browser picks the right font for it and a screen reader
// does not read "فارسی" with an English voice. The flag for each language is the region already
// chosen in LOCALE_TAG - see ../../icons/flags.ts.
export default component LanguageSwitch(props: { labelled?: boolean })
{
    const locale = useLocale();

    state open = false;
    state top = 0;
    state left = 0;
    state width = 0;
    state up = false;

    let trigger: HTMLButtonElement | null = null;
    let panel: HTMLElement | null = null;

    /**
     * Anchors the menu in viewport coordinates: under the trigger with start edges aligned, or
     * above it when there is no room below - the drawer keeps this control at the bottom of the
     * screen, so the flipped case is real, not defensive. The height is estimated from the row
     * count because the menu has not rendered yet when this runs.
     */
    const place = (): void =>
    {
        if (trigger === null)
        {
            return;
        }
        const rect = trigger.getBoundingClientRect();
        const estimate = LOCALES.length * 38 + 10;
        const below = window.innerHeight - rect.bottom;
        up = below < estimate + 8 && rect.top > below;
        top = up ? rect.top - 6 : rect.bottom + 6;
        width = Math.max(rect.width, 176);
        const start = locale.dir() === 'rtl' ? rect.right - width : rect.left;
        left = Math.min(Math.max(start, 8), window.innerWidth - width - 8);
    };

    const close = (): void =>
    {
        open = false;
    };

    const choose = (name: Locale): void =>
    {
        locale.setLocale(name);
        close();
        trigger?.focus();
    };

    // Escape closes from anywhere, and any scroll or resize closes rather than leaving a `fixed`
    // menu detached from the control that opened it.
    onMount(() =>
    {
        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape' && open)
            {
                close();
                trigger?.focus();
            }
        };
        const onMove = (): void =>
        {
            if (open)
            {
                close();
            }
        };
        document.addEventListener('keydown', onKey);
        document.addEventListener('scroll', onMove, true);
        window.addEventListener('resize', onMove);
        return () =>
        {
            document.removeEventListener('keydown', onKey);
            document.removeEventListener('scroll', onMove, true);
            window.removeEventListener('resize', onMove);
        };
    });

    // Focus follows the menu: it opens on the current language, so ArrowDown from there reads
    // the list in order. rAF because the portal has not painted when the effect runs.
    effect (open)
    {
        if (open && typeof requestAnimationFrame !== 'undefined')
        {
            requestAnimationFrame(() =>
            {
                const selected = panel?.querySelector<HTMLButtonElement>('[aria-selected="true"]');
                selected?.focus();
            });
        }
    }

    /** Arrow keys walk the options, wrapping at both ends. */
    const moveFocus = (delta: number): void =>
    {
        if (panel === null)
        {
            return;
        }
        const options = Array.from(panel.querySelectorAll<HTMLButtonElement>('[role="option"]'));
        const index = options.indexOf(document.activeElement as HTMLButtonElement);
        const next = index === -1 ? (delta > 0 ? 0 : options.length - 1) : (index + delta + options.length) % options.length;
        options[next]?.focus();
    };

    <span class={ props.labelled === true ? 'block w-full' : 'inline-flex' }>
        <button
            class={ [
                'flex cursor-pointer items-center rounded-lg border border-line bg-field text-text transition-colors duration-150 hover:border-nur',
                props.labelled === true ? 'h-10 w-full gap-2.5 px-3 text-[14px]' : 'h-8 gap-2 px-2.5 text-[12px] font-semibold'
            ].join(' ') }
            type="button"
            aria-label={ locale.t('language.label') }
            aria-haspopup="listbox"
            aria-expanded={ open }
            lang={ LOCALE_TAG[locale.locale()] }
            ref={ (element) => trigger = element }
            onClick={ () => { place(); open = true; } }
            onKeyDown={ (event) => { if ((event as KeyboardEvent).key === 'ArrowDown' && !open) { event.preventDefault(); place(); open = true; } } }
        >
            <Flag locale={ locale.locale() } />
            { LOCALE_LABEL[locale.locale()] }
            <Icon name="chevron-down" size={ 14 } class={ `text-muted ${ props.labelled === true ? 'ms-auto' : '' }` } />
        </button>

        <Show when={ open }>
            {/* One root under the Portal, as in NavDrawer - Portal mounts a single node. The
                container owns the viewport, so the panel positions `absolute` within it. */}
            <Portal>
                <div class="fixed inset-0 z-40">
                    {/* The scrim is the dismiss target, exactly as in NavDrawer - transparent
                        here, because a menu is not a mode the way a sheet is. */}
                    <button
                        class="absolute inset-0 h-full w-full cursor-default border-0 bg-transparent p-0"
                        type="button"
                        aria-label={ locale.t('nav.close') }
                        onClick={ close }
                    ></button>

                    <div
                        class="absolute flex flex-col gap-0.5 rounded-lg border border-line bg-field p-1 shadow-2xl motion-safe:animate-fade"
                        style={ `left: ${ left }px; top: ${ top }px; width: ${ width }px;${ up ? ' transform: translateY(-100%);' : '' }` }
                        role="listbox"
                        aria-label={ locale.t('language.label') }
                        ref={ (element) => panel = element }
                        onKeyDown={ (event) =>
                        {
                            const key = (event as KeyboardEvent).key;
                            if (key === 'ArrowDown') { event.preventDefault(); moveFocus(1); }
                            else if (key === 'ArrowUp') { event.preventDefault(); moveFocus(-1); }
                        } }
                        onFocusOut={ (event) =>
                        {
                            const next = (event as FocusEvent).relatedTarget;
                            if (!(next instanceof Node && panel !== null && panel.contains(next)))
                            {
                                close();
                            }
                        } }
                    >
                        <For each={ LOCALES } key={ (name) => name } let={ name }>
                            <button
                                class={ [
                                    'flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-[13px] transition-colors duration-150',
                                    locale.locale() === name ? 'bg-raised text-nur' : 'text-muted hover:bg-raised hover:text-text'
                                ].join(' ') }
                                type="button"
                                role="option"
                                aria-selected={ locale.locale() === name }
                                lang={ LOCALE_TAG[name] }
                                onClick={ () => choose(name) }
                            >
                                <Flag locale={ name } />
                                { LOCALE_LABEL[name] }
                            </button>
                        </For>
                    </div>
                </div>
            </Portal>
        </Show>
    </span>
}
