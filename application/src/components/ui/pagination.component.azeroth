import Icon from '../../icons/icon.component.azeroth';

import { useLocale } from '../../stores/locale.store.ts';

// Paging for the long lists. Numbered rather than prev/next alone: on a chain the page number is
// a position in history, and jumping to the far end - the genesis blocks, the oldest transfers -
// is a normal thing to want. Prev/next only makes that a hundred clicks.
//
// The window is fixed at seven slots so the control never reflows as the page number grows: first,
// last, the current page with a neighbour either side, and gaps for what is skipped. A gap is
// rendered as text, not a button, because there is no single page it could sensibly go to.
export default component Pagination(props: {
    page: number;
    pages: number;
    onChange: (page: number) => void;
})
{
    const locale = useLocale();

    derived window = ((): Array<{ position: number; value: number | 'gap' }> =>
    {
        let items: Array<number | 'gap'>;
        if (props.pages <= 7)
        {
            items = Array.from({ length: props.pages }, (_item, index) => index + 1);
        }
        else
        {
            const current = props.page;
            const middle = [current - 1, current, current + 1].filter((page) => page > 1 && page < props.pages);
            items = [1];
            if ((middle[0] ?? props.pages) > 2)
            {
                items.push('gap');
            }
            items.push(...middle);
            if ((middle[middle.length - 1] ?? 0) < props.pages - 1)
            {
                items.push('gap');
            }
            items.push(props.pages);
        }
        return items.map((value, position) => ({ position, value }));
    })();

    const stepClass = 'flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-md border border-line text-muted transition-colors duration-150 hover:border-nur hover:text-text disabled:pointer-events-none disabled:opacity-40';

    <Show when={ props.pages > 1 }>
        <nav class="flex items-center justify-center gap-1.5 border-t border-line px-3 py-3 sm:gap-2 sm:px-4" aria-label={ locale.t('pagination.label') }>
            <button
                class={ stepClass }
                type="button"
                aria-label={ locale.t('pagination.first') }
                disabled={ props.page <= 1 }
                onClick={ () => props.onChange(1) }
            >
                <Icon name="chevrons-left" size={ 15 } class="icon-flip" />
            </button>
            <button
                class={ stepClass }
                type="button"
                aria-label={ locale.t('pagination.newer') }
                disabled={ props.page <= 1 }
                onClick={ () => props.onChange(props.page - 1) }
            >
                <Icon name="chevron-left" size={ 15 } class="icon-flip" />
            </button>

            <For each={ window } key={ (item) => String(item.position) } let={ item }>
                <div class="contents">
                    <Show
                        when={ item.value === 'gap' }
                        fallback={
                            // Tabular figures, but NOT `data`: a page number is printed in the
                            // reader's own digits, and the mono stack has no Persian ones to print
                            // them with - they fell out to whatever face the system offered while
                            // the rest of the control stayed in the UI font.
                            <button
                                class={ item.value === props.page
                                    ? 'flex h-9 min-w-9 shrink-0 cursor-pointer items-center justify-center rounded-md border border-nur bg-raised px-2 text-[13px] font-semibold tabular-nums text-nur'
                                    : 'flex h-9 min-w-9 shrink-0 cursor-pointer items-center justify-center rounded-md border border-transparent px-2 text-[13px] tabular-nums text-muted transition-colors duration-150 hover:border-line hover:text-text' }
                                type="button"
                                aria-label={ locale.t('pagination.page', { number: locale.n(item.value as number) }) }
                                aria-current={ item.value === props.page ? 'page' : undefined }
                                onClick={ () => props.onChange(item.value as number) }
                            >
                                { locale.n(item.value as number) }
                            </button>
                        }
                    >
                        <span class="flex h-9 w-5 shrink-0 items-center justify-center text-[13px] text-faint" aria-hidden="true">...</span>
                    </Show>
                </div>
            </For>

            <button
                class={ stepClass }
                type="button"
                aria-label={ locale.t('pagination.older') }
                disabled={ props.page >= props.pages }
                onClick={ () => props.onChange(props.page + 1) }
            >
                <Icon name="chevron-right" size={ 15 } class="icon-flip" />
            </button>
            <button
                class={ stepClass }
                type="button"
                aria-label={ locale.t('pagination.last') }
                disabled={ props.page >= props.pages }
                onClick={ () => props.onChange(props.pages) }
            >
                <Icon name="chevrons-right" size={ 15 } class="icon-flip" />
            </button>
        </nav>
    </Show>
}
