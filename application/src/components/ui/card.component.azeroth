import type { Child } from 'azerothjs';

// A surface. Every panel in the explorer is one, so the border, radius and background are
// decided here rather than by whichever page happened to be written first.
export default component Card(props: {
    class?: string;
    children?: Child;
})
{
    <div class={ `panel ${ props.class ?? '' }` }>
        { props.children }
    </div>
}
