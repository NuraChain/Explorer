import { useToasts, type ToastEntry } from '../../stores/toasts.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

import Icon from '../../icons/icon.component.azeroth';

// The notification host, mounted once in the shell. Each entry dismisses itself after a few
// seconds and can be dismissed by hand; the region is aria-live so a screen reader hears it
// without the focus moving.
export default component Toasts()
{
    const toasts = useToasts();
    const locale = useLocale();

    const TONE: Record<ToastEntry['tone'], string> = {
        success: 'text-inflow',
        error: 'text-outflow',
        info: 'text-beam'
    };

    <div
        class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4"
        role="status"
        aria-live="polite"
    >
        <For each={ toasts.items() } key={ (entry) => String(entry.id) }>
        { (entry) =>
            <div class="pointer-events-auto flex max-w-md items-center gap-2.5 rounded-lg border border-line bg-raised px-3.5 py-2.5 text-[13px] shadow-lg motion-safe:animate-rise">
                <Show when={ entry.icon !== undefined }>
                    <Icon name={ entry.icon ?? 'help' } size={ 15 } class={ TONE[entry.tone] } />
                </Show>
                <span class="flex-1 text-text">{ entry.message }</span>
                <button
                    class="cursor-pointer text-faint transition-colors duration-150 hover:text-text"
                    type="button"
                    aria-label={ locale.t('toast.dismiss') }
                    onClick={ () => toasts.dismiss(entry.id) }
                >
                    <Icon name="x" size={ 14 } />
                </button>
            </div>
        }
        </For>
    </div>
}

