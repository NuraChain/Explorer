import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

// What a list says when it has nothing. An empty screen is an invitation, so the hint says what
// WILL appear here rather than apologising for the blank.
export default component EmptyState(props: {
    icon?: IconName;
    title: string;
    hint?: string;
})
{
    <div class="flex flex-col items-center gap-2 px-4 py-12 text-center">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-raised text-faint">
            <Icon name={ props.icon ?? 'help' } size={ 18 } />
        </span>
        <p class="text-[14px] font-semibold text-text">{ props.title }</p>
        <Show when={ props.hint !== undefined }>
            <p class="max-w-sm text-[13px] leading-relaxed text-muted">{ props.hint }</p>
        </Show>
    </div>
}
