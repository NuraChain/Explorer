{
    "name": "nura-explorer-server",
    "private": true,
    "version": "1.6.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "check": "azeroth check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:shuffle": "vitest run --sequence.shuffle",
        "test:unit": "vitest run tests/values.spec.ts tests/contract.spec.ts tests/cache.spec.ts tests/config.spec.ts",
        "test:integration": "vitest run tests/store.spec.ts tests/indexer.spec.ts tests/client.spec.ts",
        "test:api": "vitest run tests/http.spec.ts tests/etherscan.spec.ts tests/app.spec.ts",
        "test:security": "vitest run -t security",
        "test:property": "vitest run -t property",
        "start": "node src/main.ts"
    },
    "dependencies": {
        "@azerothjs/http": "2.1.0",
        "@azerothjs/kit": "2.1.0",
        "@azerothjs/logger": "2.1.0",
        "@azerothjs/schema": "2.1.0",
        "azerothjs": "2.1.0",
        "viem": "^2.56.5"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.1.0",
        "@azerothjs/devtools": "2.1.0",
        "@azerothjs/ws": "2.1.0",
        "@types/node": "^26.6.1",
        "@vitest/coverage-v8": "^5.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
