{
    "name": "nura-explorer-server",
    "private": true,
    "version": "1.3.2",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:shuffle": "vitest run --sequence.shuffle",
        "test:unit": "vitest run tests/values.spec.ts tests/contract.spec.ts tests/cache.spec.ts tests/config.spec.ts",
        "test:integration": "vitest run tests/store.spec.ts tests/indexer.spec.ts tests/client.spec.ts",
        "test:api": "vitest run tests/http.spec.ts tests/etherscan.spec.ts tests/app.spec.ts",
        "test:security": "vitest run -t security",
        "test:property": "vitest run -t property",
        "start": "node src/main.ts"
    },
    "dependencies": {
        "@azerothjs/http": "2.0.0-beta.2",
        "@azerothjs/kit": "2.0.0-beta.2",
        "@azerothjs/logger": "2.0.0-beta.2",
        "@azerothjs/schema": "2.0.0-beta.2",
        "azerothjs": "2.0.0-beta.2",
        "viem": "^2.56.0"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.0.0-beta.2",
        "@azerothjs/devtools": "2.0.0-beta.2",
        "@azerothjs/ws": "2.0.0-beta.2",
        "@types/node": "^26.4.0",
        "@vitest/coverage-v8": "^4.1.11",
        "typescript": "^7.0.2",
        "vitest": "^4.1.9"
    }
}
