# Copy to .env for local overrides (never commit .env). Every key the server reads is listed here;
# each has a working default in code, so an empty .env still boots against a local node.

# --- Server -----------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js

# --- Chain ------------------------------------------------------------------------------------
# The JSON-RPC endpoint to index. NuraChain is https://rpc.nurachain.net with CHAIN_ID=1010.
RPC_URL=https://rpc.nurachain.net
CHAIN_ID=1010
# Shown in the header and footer; the symbol suffixes every amount the explorer prints.
CHAIN_NAME=Nura Chain
CURRENCY_SYMBOL=NC
CURRENCY_DECIMALS=18

# --- Indexer ----------------------------------------------------------------------------------
# The height to start from. Raise it to skip history you do not need: the index is a cache, and a
# chain with millions of empty early blocks is not worth the first sync.
START_BLOCK=0
# How often to ask for a new head, in milliseconds. Keep it under the chain's block time.
POLL_MS=1000
# Blocks per catch-up batch: one prefetch and one database transaction. Higher is faster and uses
# more memory; the batch is held in memory until it is written.
BATCH_SIZE=1000
# How many block reads may be in flight at once. On a remote RPC this is the single biggest knob -
# the cost is the round trip, so a narrow window just leaves the link idle. It cannot help above
# BATCH_SIZE (that is all the blocks in hand). Lower it if the endpoint starts rate-limiting.
RPC_CONCURRENCY=1000
# How many JSON-RPC calls ride in one HTTP request. Most providers cap this near 100, and going
# over means the call is refused and retried - measurably slower than staying under.
RPC_BATCH_SIZE=100
# The sqlite index. Deleting it is safe - the indexer replays from START_BLOCK.
DB_PATH=.data/index.db
