{
    "name": "nura-explorer",
    "private": true,
    "version": "1.7.0",
    "type": "module",
    "engines": {
        "node": ">=24.11.0"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "azeroth": {
        "dev": "server"
    },
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check && oxlint",
        "build": "azeroth build",
        "test": "azeroth test",
        "test:coverage": "npm run test:coverage --workspace server",
        "test:shuffle": "npm run test:shuffle --workspace server && npm run test:shuffle --workspace application",
        "test:server": "npm test --workspace server",
        "test:application": "npm test --workspace application",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "typeorm": "^1.1.2"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.1.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0"
    }
}
