{
    "name": "nura-explorer",
    "private": true,
    "version": "1.0.2",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check",
        "build": "azeroth build",
        "test": "azeroth test",
        "start": "npm start --workspace server",
        "service:stop": "bash scripts/service-stop.sh",
        "service:start": "bash scripts/service-start.sh",
        "service:status": "bash scripts/service-status.sh",
        "service:restart": "bash scripts/service-restart.sh",
        "service:install": "bash scripts/service-install.sh",
        "service:uninstall": "bash scripts/service-uninstall.sh",
        "service:deploy": "npm run build && npm run service:restart"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.0.0-beta.2"
    }
}
