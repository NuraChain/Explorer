{
    "name": "nura-explorer",
    "private": true,
    "version": "1.3.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check && oxlint",
        "build": "azeroth build",
        "test": "azeroth test",
        "test:coverage": "npm run test:coverage --workspace server",
        "test:shuffle": "npm run test:shuffle --workspace server && npm run test:shuffle --workspace application",
        "test:server": "npm test --workspace server",
        "test:application": "npm test --workspace application",
        "start": "npm start --workspace server",
        "service:stop": "bash scripts/service-stop.sh",
        "service:start": "bash scripts/service-start.sh",
        "service:status": "bash scripts/service-status.sh",
        "service:restart": "bash scripts/service-restart.sh",
        "service:install": "bash scripts/service-install.sh",
        "service:uninstall": "bash scripts/service-uninstall.sh",
        "service:deploy": "npm run build && npm run service:restart",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.0.0-beta.2",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0"
    }
}
