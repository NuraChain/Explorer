{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 110,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "insertFinalNewline": true,
    "objectWrap": "preserve",
    "ignorePatterns": [
        "dist/",
        "dist-server/",
        "coverage/",
        ".playwright-mcp/",
        ".data/",
        "logs/",
        "*.azeroth"
    ]
}
