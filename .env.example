# Copy to .env HERE, at the repository root (never commit .env). It is the ONE configuration file:
# the server reads it in a checkout, and a container is handed it with `--env-file`. Every key the
# server reads is listed, and EVERY one is required: the code holds no defaults, and a boot with any
# key missing or empty fails with one error naming them all.

# --- Server -----------------------------------------------------------------------------------
PORT=4300
NODE_ENV=production
# Which address the DEV session binds (production keeps the adapter's own bind, but the key is
# still required). 127.0.0.1 rather than `localhost`, which resolves to ::1 first on some
# platforms. Set 0.0.0.0 to open the dev session to another device on the network.
HOST=127.0.0.1
# Where the built client lives in production (the server serves it - one origin). This path and
# SSR_ENTRY are relative to server/, which is where the server runs.
CLIENT_DIR=../application/dist
# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js

# --- Chain ------------------------------------------------------------------------------------
# The JSON-RPC endpoint to index. NuraChain is https://rpc.nurachain.net with CHAIN_ID=1020.
RPC_URL=https://rpc.nurachain.net
CHAIN_ID=1020
# Shown in the header and footer; the symbol suffixes every amount the explorer prints.
CHAIN_NAME=Nura Chain
CURRENCY_SYMBOL=NURA
CURRENCY_DECIMALS=18
# The chain's own website. The footer links its name here.
CHAIN_SITE_URL=https://nurachain.net
# This explorer's PUBLIC url: the canonical and Open Graph urls, and what wallets are handed as the
# chain's block explorer.
EXPLORER_URL=https://explorer.nurachain.net

# --- Governance -------------------------------------------------------------------------------
# Governance is x/gov, not the EVM: proposals, tallies and votes live in the Cosmos half of the
# node and never appear over JSON-RPC. These are the same node's other two apis, and the server is
# the only thing that calls them - the browser never sees these addresses.
# The Cosmos REST api ("LCD"), enabled by [api] in the node's app.toml. An endpoint that does not
# answer leaves the EVM half working; governance and staking then report the module unreachable.
COSMOS_REST_URL=https://bft.nurachain.net
# CometBFT's own rpc - used for the chain id, the height these figures were read at, and whether
# the node is still catching up.
COMETBFT_RPC_URL=https://comet.nurachain.net
# How long any one of those calls may take. A node that is not answering must not hang a page.
COSMOS_TIMEOUT_MS=4000

# --- Price ------------------------------------------------------------------------------------
# The exchange behind the header ticker. It quotes by SYMBOL, so an explorer pointed at another
# chain gets null rather than NURA's price printed beside somebody else's coin.
SWAP_API_URL=https://swap.nurachain.net
# How long a reading is served before it is fetched again.
PRICE_TTL_MS=30000
# How long the last good reading may still be served once the exchange stops answering. Past this
# the ticker shows nothing - a price from yesterday is a lie with a timestamp on it.
PRICE_STALE_MS=600000
# How long one upstream request may take before it is abandoned.
PRICE_TIMEOUT_MS=4000

# --- Indexer ----------------------------------------------------------------------------------
# The height to start from. Raise it to skip history you do not need: the index is a cache, and a
# chain with millions of empty early blocks is not worth the first sync.
START_BLOCK=0
# How often to ask for a new head, in milliseconds. Keep it under the chain's block time.
POLL_MS=3000
# Blocks per catch-up batch: one prefetch and one database transaction. Higher is faster and uses
# more memory; the batch is held in memory until it is written.
BATCH_SIZE=512
# How many block reads may be in flight at once. On a remote RPC this is the single biggest knob -
# the cost is the round trip, so a narrow window just leaves the link idle. It cannot help above
# BATCH_SIZE (that is all the blocks in hand). Lower it if the endpoint starts rate-limiting.
RPC_CONCURRENCY=512
# How many JSON-RPC calls ride in one HTTP request. Most providers cap this near 100, and going
# over means the call is refused and retried - measurably slower than staying under.
RPC_BATCH_SIZE=128

# --- Database ---------------------------------------------------------------------------------
# The PostgreSQL index. Its tables are derived from the chain, so dropping them is safe: the indexer
# replays from START_BLOCK. The password goes in your .env - as `user:password@` before the host -
# never in this file. The database must be UTF8.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/nura_explorer
# Connections the pool may hold. The follower holds one per batch; a request, one per read.
DATABASE_POOL_SIZE=10
# Where `npm test` makes its throwaway schemas: a database of its own, never the one above.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/nura_explorer_test

# --- RPC cache --------------------------------------------------------------------------------
# The API reads live facts from the node - a head, a balance, a contract's code, what its getters
# answer - and every visitor asks for the same ones. These hold each KIND of answer for as long as
# that answer is actually still true, and collapse concurrent asks for one key into a single call.
# The indexer is not affected: it always reads the node directly. Set RPC_CACHE=false to disable.
RPC_CACHE=true
# Entries held per cache before the least recently used one is dropped.
RPC_CACHE_MAX=4096
# The node's head height. Keep it under POLL_MS so the head still visibly moves.
RPC_CACHE_HEAD_MS=1000
# A native balance. The shortest span here on purpose: a stale balance is a WRONG answer, not an
# old one, so this only ever absorbs the burst of asks that arrive together.
RPC_CACHE_BALANCE_MS=2000
# An eth_call return - what a getter answers right now. Live state, so short.
RPC_CACHE_CALL_MS=2000
# One storage word: the slots a proxy keeps its implementation pointer in.
RPC_CACHE_STORAGE_MS=2000
# Deployed bytecode. Long, because it cannot change - since EIP-6780 selfdestruct only clears code
# in the transaction that created it.
RPC_CACHE_CODE_MS=600000
# The ABSENCE of code, held far shorter: an account with no code today can be a contract tomorrow.
RPC_CACHE_CODE_ABSENT_MS=5000
# A token's name/symbol/decimals - written in its constructor and never again.
RPC_CACHE_TOKEN_MS=600000
